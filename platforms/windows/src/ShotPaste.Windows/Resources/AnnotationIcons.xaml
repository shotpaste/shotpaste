<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Shared, font-independent annotation glyphs. The geometry follows the same
    visual vocabulary as the SF Symbols used by the macOS annotation toolbar.
  -->
  <DataTemplate x:Key="AnnotationCropIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Path Data="M6,2 L6,16 C6,17.1 6.9,18 8,18 L22,18 M2,6 L16,6 C17.1,6 18,6.9 18,8 L18,22"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationSelectionIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Path Data="M4,2 L4,19 L9,14.2 L13,22 L16.2,20.4 L12.3,13 L19,13 Z"
            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationRectangleIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Rectangle Margin="3.5" RadiusX="1.8" RadiusY="1.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationFilledRectangleIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Rectangle Margin="3.5" RadiusX="1.8" RadiusY="1.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationOvalIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Ellipse Margin="3.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationArrowIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Path Data="M5,19 L19,5 M11,5 L19,5 L19,13"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationLineIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Path Data="M5,19 L19,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
            StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationTextIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Rectangle Margin="2.5,3" RadiusX="2" RadiusY="2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.7" />
      <Path Data="M7,7.5 L17,7.5 M12,7.5 L12,19 M8.5,19 L15.5,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.9" StrokeStartLineCap="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationHighlighterIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Path Data="M8,4 L20,16 L15,21 L3,9 Z M5,17 L8,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
            StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      <Path Data="M4,22 L20,22" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationBlurIcon">
    <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24">
      <Rectangle Canvas.Left="3" Canvas.Top="3" Width="5" Height="5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Rectangle Canvas.Left="9.5" Canvas.Top="3" Width="5" Height="5" Opacity="0.48" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Rectangle Canvas.Left="16" Canvas.Top="3" Width="5" Height="5" Opacity="0.78" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Rectangle Canvas.Left="3" Canvas.Top="9.5" Width="5" Height="5" Opacity="0.62" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Rectangle Canvas.Left="9.5" Canvas.Top="9.5" Width="5" Height="5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Rectangle Canvas.Left="16" Canvas.Top="9.5" Width="5" Height="5" Opacity="0.42" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Rectangle Canvas.Left="3" Canvas.Top="16" Width="5" Height="5" Opacity="0.82" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Rectangle Canvas.Left="9.5" Canvas.Top="16" Width="5" Height="5" Opacity="0.58" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Rectangle Canvas.Left="16" Canvas.Top="16" Width="5" Height="5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
    </Canvas></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationOcrIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Path Data="M8,3 L4,3 C3.4,3 3,3.4 3,4 L3,8 M16,3 L20,3 C20.6,3 21,3.4 21,4 L21,8 M21,16 L21,20 C21,20.6 20.6,21 20,21 L16,21 M8,21 L4,21 C3.4,21 3,20.6 3,20 L3,16"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" />
      <TextBlock Text="T" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Bold" FontSize="9"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationSpotlightIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Path Data="M8,3 L4,3 C3.4,3 3,3.4 3,4 L3,8 M16,3 L20,3 C20.6,3 21,3.4 21,4 L21,8 M21,16 L21,20 C21,20.6 20.6,21 20,21 L16,21 M8,21 L4,21 C3.4,21 3,20.6 3,20 L3,16"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" />
      <Ellipse Width="7" Height="7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationCounterIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <TextBlock Text="1" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Bold" FontSize="10" Margin="3,2,0,0"
                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
      <Path Data="M10,6 L21,6 M10,12 L21,12 M10,18 L21,18 M4,12 L6,12 M4,18 L6,18"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.9" StrokeStartLineCap="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationPencilIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Path Data="M4,20 L5.2,14.8 L16.8,3.2 C17.6,2.4 18.9,2.4 19.7,3.2 L20.8,4.3 C21.6,5.1 21.6,6.4 20.8,7.2 L9.2,18.8 Z M14.8,5.2 L18.8,9.2 M4,20 L9.2,18.8"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationUndoIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Path Data="M9,6 L4,10 L9,14 M5,10 L14,10 C18,10 20,12.2 20,16 C20,18.3 18.7,20 16.5,21"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationRedoIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Path Data="M15,6 L20,10 L15,14 M19,10 L10,10 C6,10 4,12.2 4,16 C4,18.3 5.3,20 7.5,21"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationMoveIcon">
    <Viewbox Width="15" Height="15"><Grid Width="24" Height="24">
      <Path Data="M12,2 L9,5 M12,2 L15,5 M12,22 L9,19 M12,22 L15,19 M2,12 L5,9 M2,12 L5,15 M22,12 L19,9 M22,12 L19,15 M12,3 L12,21 M3,12 L21,12"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationToolbarDragIcon">
    <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24">
      <Ellipse Canvas.Left="3" Canvas.Top="3" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Ellipse Canvas.Left="10" Canvas.Top="3" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Ellipse Canvas.Left="17" Canvas.Top="3" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Ellipse Canvas.Left="3" Canvas.Top="10" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Ellipse Canvas.Left="17" Canvas.Top="10" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Ellipse Canvas.Left="3" Canvas.Top="17" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Ellipse Canvas.Left="10" Canvas.Top="17" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Ellipse Canvas.Left="17" Canvas.Top="17" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
    </Canvas></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationPanIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Path Data="M7,14.8 L7,7.3 C7,6.2 7.8,5.5 8.7,5.5 C9.6,5.5 10.2,6.2 10.2,7.3 L10.2,10.2 L10.2,5.6 C10.2,4.5 11,3.8 11.9,3.8 C12.8,3.8 13.4,4.5 13.4,5.6 L13.4,10.2 L13.4,6.2 C13.4,5.1 14.2,4.4 15.1,4.4 C16,4.4 16.6,5.1 16.6,6.2 L16.6,12.3 C17.8,10.9 19.1,10.5 20,11.5 C20.7,12.3 20.2,13.6 19.5,14.8 L17.2,18.4 C16.2,20 14.5,21 12.4,21 L10.4,21 C8.2,21 6.6,19.8 5.6,18.1 L4.1,15.6 C3.5,14.5 4.2,13.4 5.2,13.4 C5.8,13.4 6.3,13.8 7,14.8 Z"
            Fill="Transparent"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
            StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationZoomOutIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Ellipse Width="13" Height="13" Margin="2.5,2.5,8.5,8.5"
               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.9" />
      <Path Data="M14.5,14.5 L21,21 M6.5,9 L12.5,9"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
            StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationZoomInIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Ellipse Width="13" Height="13" Margin="2.5,2.5,8.5,8.5"
               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.9" />
      <Path Data="M14.5,14.5 L21,21 M6.5,9 L12.5,9 M9.5,6 L9.5,12"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
            StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationPinIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Path Data="M8,3 L16,3 M10,3 L10,9 L6,13 L18,13 L14,9 L14,3 M12,13 L12,22"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationCloseIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2.2" StrokeStartLineCap="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationDoneIcon">
    <Viewbox Width="18" Height="18"><Grid Width="24" Height="24">
      <Path Data="M4,12.5 L9.5,18 L20,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="AnnotationCopyIcon">
    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
      <Rectangle Width="13" Height="13" Margin="3,8,8,3" RadiusX="1.5" RadiusY="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8" />
      <Path Data="M8,8 L8,5 C8,3.9 8.9,3 10,3 L19,3 C20.1,3 21,3.9 21,5 L21,14 C21,15.1 20.1,16 19,16 L16,16"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="OneShotScreenshotIcon">
    <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
      <Path Data="M4,7 C4,5.9 4.9,5 6,5 L8,5 L9.2,3.5 L14.8,3.5 L16,5 L18,5 C19.1,5 20,5.9 20,7 L20,18 C20,19.1 19.1,20 18,20 L6,20 C4.9,20 4,19.1 4,18 Z"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
      <Ellipse Width="7" Height="7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="OneShotScrollingIcon">
    <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
      <Path Data="M8,6 L12,2 L16,6 M12,2 L12,22 M8,18 L12,22 L16,18"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="OneShotRecordingIcon">
    <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
      <Ellipse Margin="3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
      <Ellipse Width="8" Height="8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
    </Grid></Viewbox>
  </DataTemplate>

  <DataTemplate x:Key="OneShotClipboardIcon">
    <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
      <Path Data="M8,5 L6,5 C4.9,5 4,5.9 4,7 L4,20 C4,21.1 4.9,22 6,22 L18,22 C19.1,22 20,21.1 20,20 L20,7 C20,5.9 19.1,5 18,5 L16,5 M9,3 L15,3 C15.6,3 16,3.4 16,4 L16,7 L8,7 L8,4 C8,3.4 8.4,3 9,3 Z"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
    </Grid></Viewbox>
  </DataTemplate>
</ResourceDictionary>
