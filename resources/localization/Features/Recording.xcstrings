    "audio-recording.preparation-title": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Neue Audioaufnahme"}},"en":{"stringUnit":{"state":"translated","value":"New Audio Recording"}},"es":{"stringUnit":{"state":"translated","value":"Nueva grabación de audio"}},"fr":{"stringUnit":{"state":"translated","value":"Nouvel enregistrement audio"}},"ja":{"stringUnit":{"state":"translated","value":"新しい音声録音"}},"ko":{"stringUnit":{"state":"translated","value":"새 오디오 녹음"}},"ru":{"stringUnit":{"state":"translated","value":"Новая аудиозапись"}},"vi":{"stringUnit":{"state":"translated","value":"Bản ghi âm mới"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新建录音"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新的錄音"}}}},
    "audio-recording.preparing": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audioaufnahme wird vorbereitet …"}},"en":{"stringUnit":{"state":"translated","value":"Preparing audio recording…"}},"es":{"stringUnit":{"state":"translated","value":"Preparando la grabación de audio…"}},"fr":{"stringUnit":{"state":"translated","value":"Préparation de l’enregistrement audio…"}},"ja":{"stringUnit":{"state":"translated","value":"音声録音を準備中…"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음 준비 중…"}},"ru":{"stringUnit":{"state":"translated","value":"Подготовка аудиозаписи…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chuẩn bị bản ghi âm…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在准备录音…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在準備錄音…"}}}},
    "audio-recording.primary-language": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Primäre Sprache"}},"en":{"stringUnit":{"state":"translated","value":"Primary language"}},"es":{"stringUnit":{"state":"translated","value":"Idioma principal"}},"fr":{"stringUnit":{"state":"translated","value":"Langue principale"}},"ja":{"stringUnit":{"state":"translated","value":"主言語"}},"ko":{"stringUnit":{"state":"translated","value":"기본 언어"}},"ru":{"stringUnit":{"state":"translated","value":"Основной язык"}},"vi":{"stringUnit":{"state":"translated","value":"Ngôn ngữ chính"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"主要语言"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"主要語言"}}}},
    "audio-recording.privacy-disclosure": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahmen werden lokal gespeichert. Transkription sendet ausgewähltes Audio an Volcengine. KI-Verarbeitung sendet Transkripttext an die Agent-API. Temporäre Bildschirmmedien werden erst nach sicherer Audiospeicherung gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordings are saved locally. Enabling transcription sends selected audio to Volcengine. Enabling AI processing sends transcript text to the configured Agent API. Temporary screen media is deleted only after audio is safely saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones se guardan localmente. La transcripción envía el audio seleccionado a Volcengine. La IA envía el texto a la API del Agent. Los archivos temporales de pantalla se eliminan tras guardar el audio de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements sont conservés localement. La transcription envoie l’audio choisi à Volcengine. L’IA envoie le texte à l’API Agent. Les médias temporaires d’écran sont supprimés après sauvegarde sûre de l’audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は端末に保存されます。文字起こしでは選択した音声をVolcengineに、AI処理では文字起こしをAgent APIに送信します。一時的な画面メディアは音声の安全な保存後に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 로컬에 저장됩니다. 받아쓰기는 선택한 오디오를 Volcengine으로, AI 처리는 텍스트를 Agent API로 전송합니다. 임시 화면 미디어는 오디오가 안전하게 저장된 후 삭제됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи сохраняются локально. Расшифровка отправляет выбранное аудио в Volcengine, а ИИ — текст в API Agent. Временные файлы экрана удаляются после надёжного сохранения аудио."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi được lưu cục bộ. Chép lời gửi âm thanh đã chọn tới Volcengine; AI gửi văn bản tới API Agent. Dữ liệu màn hình tạm chỉ bị xóa sau khi lưu âm thanh an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音保存在本机。开启转写会将所选音频发送至火山引擎；开启智能处理会将文字稿发送至配置的 Agent API。临时屏幕媒体仅在音频安全保存后删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音儲存在本機。開啟轉寫會將所選音訊傳送至火山引擎；開啟智慧處理會將文字稿傳送至配置的 Agent API。暫存螢幕媒體僅在音訊安全儲存後刪除。"
          }
        }
      }
    },
    "audio-recording.recording": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audioaufnahme"}},"en":{"stringUnit":{"state":"translated","value":"Audio recording"}},"es":{"stringUnit":{"state":"translated","value":"Grabación de audio"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrement audio"}},"ja":{"stringUnit":{"state":"translated","value":"音声録音"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음"}},"ru":{"stringUnit":{"state":"translated","value":"Аудиозапись"}},"vi":{"stringUnit":{"state":"translated","value":"Bản ghi âm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"录音"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"錄音"}}}},
    "audio-recording.restart": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Neu starten"}},"en":{"stringUnit":{"state":"translated","value":"Restart"}},"es":{"stringUnit":{"state":"translated","value":"Reiniciar"}},"fr":{"stringUnit":{"state":"translated","value":"Recommencer"}},"ja":{"stringUnit":{"state":"translated","value":"再起動"}},"ko":{"stringUnit":{"state":"translated","value":"다시 시작"}},"ru":{"stringUnit":{"state":"translated","value":"Начать заново"}},"vi":{"stringUnit":{"state":"translated","value":"Khởi động lại"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新开始"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重新開始"}}}},
    "audio-recording.restart-confirmation-message": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die aktuelle Audioaufnahme wird in den Papierkorb verschoben und eine neue Aufnahme mit denselben Einstellungen gestartet."}},"en":{"stringUnit":{"state":"translated","value":"The current audio recording will be moved to Trash and a new recording will start with the same settings."}},"es":{"stringUnit":{"state":"translated","value":"La grabación de audio actual se moverá a la Papelera y comenzará una nueva con los mismos ajustes."}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement audio actuel sera placé dans la corbeille et un nouvel enregistrement démarrera avec les mêmes réglages."}},"ja":{"stringUnit":{"state":"translated","value":"現在の音声録音をゴミ箱に移動し、同じ設定で新しい録音を開始します。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 오디오 녹음을 휴지통으로 이동하고 같은 설정으로 새 녹음을 시작합니다."}},"ru":{"stringUnit":{"state":"translated","value":"Текущая аудиозапись будет перемещена в Корзину, после чего начнётся новая запись с теми же настройками."}},"vi":{"stringUnit":{"state":"translated","value":"Bản ghi âm hiện tại sẽ được chuyển vào Thùng rác và bản ghi mới sẽ bắt đầu với cùng cài đặt."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前录音将移到废纸篓，并使用相同设置开始新的录音。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前錄音將移到垃圾桶，並使用相同設定開始新的錄音。"}}}},
    "audio-recording.restart-confirmation-title": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audioaufnahme neu starten?"}},"en":{"stringUnit":{"state":"translated","value":"Restart Audio Recording?"}},"es":{"stringUnit":{"state":"translated","value":"¿Reiniciar grabación de audio?"}},"fr":{"stringUnit":{"state":"translated","value":"Recommencer l’enregistrement audio ?"}},"ja":{"stringUnit":{"state":"translated","value":"音声録音を再起動しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음을 다시 시작할까요?"}},"ru":{"stringUnit":{"state":"translated","value":"Начать аудиозапись заново?"}},"vi":{"stringUnit":{"state":"translated","value":"Khởi động lại bản ghi âm?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新开始录音？"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"要重新開始錄音嗎？"}}}},
