<Window x:Class="ShotPaste.Windows.Views.QuickAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotPaste · Quick Access" Width="204" Height="128" WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackdropBrush}" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        AutomationProperties.AutomationId="QuickAccessWindow"
        PreviewKeyDown="OnPreviewKeyDown" Deactivated="OnDeactivated"
        IsManipulationEnabled="True" ManipulationDelta="OnManipulationDelta" ManipulationCompleted="OnManipulationCompleted"
        MouseEnter="OnCardMouseEnter" MouseLeave="OnCardMouseLeave" MouseLeftButtonDown="OnWindowMouseDown">
  <Border x:Name="Card" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource HudBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" ClipToBounds="True"
          ToolTip="{Binding FilePath}" ToolTipService.InitialShowDelay="10000">
    <Border.Effect><DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="18" ShadowDepth="7" Opacity="0.48"/></Border.Effect>
    <Grid>
      <Image x:Name="Preview" Source="{Binding PreviewSource}" Stretch="UniformToFill"
             AutomationProperties.AutomationId="QuickAccessPreview" AutomationProperties.Name="截图预览"/>
      <Grid x:Name="TextPreview" Background="{DynamicResource HudBrush}"
            AutomationProperties.AutomationId="QuickAccessTextPreview">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding PreviewSource}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <TextBlock x:Name="TextPreviewContent" Text="{Binding PreviewText}" Foreground="{DynamicResource HudTextBrush}"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="14" FontSize="12" MaxHeight="88"/>
      </Grid>
      <Border x:Name="HoverOverlay" Background="{DynamicResource HudOverlayBrush}" Opacity="0" IsHitTestVisible="False">
        <WrapPanel x:Name="Actions" HorizontalAlignment="Center" VerticalAlignment="Center" Width="176" ItemWidth="84">
          <Button x:Name="CopyAction" AutomationProperties.AutomationId="QuickAccessCopy" Content="复制" Style="{StaticResource HudTextButton}" Width="78" Height="28" Margin="1,1" Click="OnCopy"/>
          <Button x:Name="SaveAction" AutomationProperties.AutomationId="QuickAccessSave" Content="保存" Style="{StaticResource HudTextButton}" Width="78" Height="28" Margin="1,1" Click="OnSave"/>
          <Button x:Name="PinAction" AutomationProperties.AutomationId="QuickAccessPin" Content="贴图" Style="{StaticResource HudTextButton}" Width="78" Height="28" Margin="1,1" Click="OnPin"/>
          <Button x:Name="OpenAction" AutomationProperties.AutomationId="QuickAccessOpen" Content="打开" Style="{StaticResource HudTextButton}" Width="78" Height="28" Margin="1,1" Click="OnOpen"/>
          <Button x:Name="DragAction" AutomationProperties.AutomationId="QuickAccessDrag" Content="拖出" Style="{StaticResource HudTextButton}" Width="78" Height="28" Margin="1,1" PreviewMouseLeftButtonDown="OnDragOut"/>
          <Button x:Name="DeleteAction" AutomationProperties.AutomationId="QuickAccessDelete" Content="删除" Style="{StaticResource HudTextButton}" Width="78" Height="28" Margin="1,1" Click="OnDelete"/>
          <Button x:Name="CloseAction" AutomationProperties.AutomationId="QuickAccessClose" Content="关闭" Style="{StaticResource HudTextButton}" Width="78" Height="28" Margin="1,1" Click="OnClose"/>
        </WrapPanel>
      </Border>
      <Button x:Name="PinButton" Content="{StaticResource Icon.Pin}" ContentTemplate="{StaticResource Icon.Template}" Style="{StaticResource HudIconButton}" Width="28" Height="28" Visibility="Collapsed"
              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Opacity="0" Click="OnPin" ToolTip="贴到屏幕"/>
      <Button x:Name="CloseButton" Content="{StaticResource Icon.Close}" ContentTemplate="{StaticResource Icon.Template}" Style="{StaticResource HudIconButton}" Width="28" Height="28" Visibility="Collapsed"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Opacity="0" Click="OnClose" ToolTip="关闭"/>
      <Border x:Name="DurationBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7"
              Background="{DynamicResource HudBadgeBrush}" CornerRadius="{DynamicResource Radius.Sm}" Padding="6,2">
        <TextBlock x:Name="DurationText" Foreground="{DynamicResource HudTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold"/>
      </Border>
      <Border x:Name="TitleBadge" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7" Background="{DynamicResource HudBadgeBrush}" CornerRadius="{DynamicResource Radius.Sm}" Padding="6,2">
        <TextBlock x:Name="TitleText" Foreground="{DynamicResource HudTextBrush}" FontSize="10" FontWeight="SemiBold"/>
      </Border>
    </Grid>
  </Border>
</Window>
