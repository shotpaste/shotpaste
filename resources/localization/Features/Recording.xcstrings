    "recording.cloud.speech-key": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Speech API Key"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"语音 API Key"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"語音 API Key"}},"de":{"stringUnit":{"state":"translated","value":"Sprach-API-Schlüssel"}},"es":{"stringUnit":{"state":"translated","value":"Clave API de voz"}},"fr":{"stringUnit":{"state":"translated","value":"Clé API vocale"}},"ja":{"stringUnit":{"state":"translated","value":"音声APIキー"}},"ko":{"stringUnit":{"state":"translated","value":"음성 API 키"}},"ru":{"stringUnit":{"state":"translated","value":"API-ключ речи"}},"vi":{"stringUnit":{"state":"translated","value":"Khóa API giọng nói"}}}},
