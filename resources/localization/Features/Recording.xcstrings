                }
            },
            "fr": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Impossible de se connecter à l’interprétation simultanée Volcengine. Vérifiez le réseau, les identifiants, l’accès au modèle et l’éligibilité au service sur invitation."
                }
            },
            "ja": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Volcengine の同時通訳に接続できません。ネットワーク、認証情報、モデル権限、招待制サービスの利用資格を確認してください。"
                }
            },
            "ko": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Volcengine 동시통역에 연결할 수 없습니다. 네트워크, 자격 증명, 모델 권한 및 초대형 서비스 사용 자격을 확인하세요."
                }
            },
            "ru": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Не удалось подключиться к синхронному переводу Volcengine. Проверьте сеть, учетные данные, доступ к модели и право на участие в закрытом тестировании."
                }
            },
            "vi": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Không thể kết nối phiên dịch đồng thời Volcengine. Hãy kiểm tra mạng, thông tin xác thực, quyền mô hình và quyền dùng dịch vụ thử nghiệm theo lời mời."
                }
            },
            "zh-Hans": {
                "stringUnit": {
                    "state": "translated",
                    "value": "无法连接火山引擎同声传译。请检查网络、凭证、模型权限和邀测资格。"
                }
            },
            "zh-Hant": {
                "stringUnit": {
                    "state": "translated",
                    "value": "無法連線火山引擎同聲傳譯。請檢查網路、憑證、模型權限和邀測資格。"
                }
            }
        }
    },
