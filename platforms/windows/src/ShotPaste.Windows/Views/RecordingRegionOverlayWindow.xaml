<Window x:Class="ShotPaste.Windows.Views.RecordingRegionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotPaste · 录制区域" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False" Topmost="True"
        AutomationProperties.AutomationId="RecordingRegionOverlayWindow">
  <Canvas x:Name="OverlayCanvas">
    <Rectangle x:Name="DimTop" Fill="{DynamicResource Recording.DimBrush}"/>
    <Rectangle x:Name="DimLeft" Fill="{DynamicResource Recording.DimBrush}"/>
    <Rectangle x:Name="DimRight" Fill="{DynamicResource Recording.DimBrush}"/>
    <Rectangle x:Name="DimBottom" Fill="{DynamicResource Recording.DimBrush}"/>
    <Rectangle x:Name="TopLine" Fill="{DynamicResource AccentBrush}"/>
    <Rectangle x:Name="RightLine" Fill="{DynamicResource AccentBrush}"/>
    <Rectangle x:Name="BottomLine" Fill="{DynamicResource AccentBrush}"/>
    <Rectangle x:Name="LeftLine" Fill="{DynamicResource AccentBrush}"/>
    <Rectangle x:Name="SelectionHitTarget" Fill="{DynamicResource Capture.HitTargetBrush}" Cursor="SizeAll"
               MouseLeftButtonDown="OnSelectionMouseDown"
               MouseMove="OnSelectionMouseMove"
               MouseEnter="OnSelectionMouseEnter"
               MouseLeftButtonUp="OnSelectionMouseUp"/>
    <StackPanel x:Name="ScrollingGuidance" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Center">
      <StackPanel.Effect>
        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.82"/>
      </StackPanel.Effect>
      <TextBlock x:Name="ScrollingGuidanceTitle" Foreground="{DynamicResource HudTextBrush}" FontSize="15" FontWeight="SemiBold"
                 TextAlignment="Center" TextWrapping="Wrap"/>
      <TextBlock x:Name="ScrollingGuidanceDetail" Foreground="{DynamicResource HudTextBrush}" Opacity="0.9" FontSize="12" FontWeight="Medium"
                 TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
  </Canvas>
</Window>
