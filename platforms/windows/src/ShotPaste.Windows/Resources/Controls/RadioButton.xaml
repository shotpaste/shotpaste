<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="ShotPasteRadioButton" TargetType="{x:Type RadioButton}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Margin" Value="0,5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid Width="20" Height="20">
              <Ellipse x:Name="FocusRing" Stroke="{DynamicResource FocusRingBrush}" StrokeThickness="2" Opacity="0" />
              <Ellipse x:Name="Ring" Width="16" Height="16" Fill="{DynamicResource ControlBackgroundBrush}"
                       Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="1" />
              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource AccentForegroundBrush}" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="{DynamicResource CheckBox.ContentMargin}"
                              VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ControlBorderHoverBrush}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Ring" Property="Fill" Value="{DynamicResource ControlBackgroundPressedBrush}" /></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource ShotPasteRadioButton}" />

  <Style x:Key="ToggleSwitch" TargetType="{x:Type CheckBox}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Margin" Value="0,5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid Width="38" Height="24">
              <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusRingBrush}" BorderThickness="2"
                      CornerRadius="12" Opacity="0" />
              <Border x:Name="Track" Width="34" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="{DynamicResource ControlBorderBrush}" CornerRadius="10" />
              <Border x:Name="Thumb" Width="14" Height="14" Margin="5,0,0,0" HorizontalAlignment="Left"
                      VerticalAlignment="Center" Background="{DynamicResource AccentForegroundBrush}" CornerRadius="7">
                <Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.24" /></Border.Effect>
              </Border>
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="{DynamicResource ToggleSwitch.ContentMargin}"
                              VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.82" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Thumb" Property="Opacity" Value="0.72" /></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Thumb" Property="Margin" Value="0,0,5,0" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
