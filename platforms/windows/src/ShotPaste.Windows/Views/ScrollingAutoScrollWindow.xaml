<Window x:Class="ShotPaste.Windows.Views.ScrollingAutoScrollWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:ShotPaste.Windows.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Localized Key='ShotPaste · 自动滚动', IsWindowTitle=True}" SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False"
        ShowActivated="False" Focusable="True" Topmost="True"
        AutomationProperties.AutomationId="ScrollingAutoScrollWindow"
        AutomationProperties.Name="{loc:Localized Key='切换自动滚动'}">
  <Border CornerRadius="{DynamicResource Radius.Pill}" Background="{DynamicResource HudBrush}"
          BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1">
    <Button x:Name="ToggleButton" Padding="10,7" Style="{StaticResource HudTextButton}" Click="OnToggle"
            AutomationProperties.AutomationId="ScrollingAutoScroll" AutomationProperties.Name="{loc:Localized Key='切换自动滚动'}">
      <StackPanel Orientation="Horizontal">
        <ContentControl x:Name="ToggleIcon" Content="{StaticResource Icon.Resume}"
                        ContentTemplate="{StaticResource Icon.CompactTemplate}" Margin="0,0,6,0"/>
        <TextBlock x:Name="ToggleLabel" Text="{loc:Localized Key='自动滚动'}" VerticalAlignment="Center"/>
      </StackPanel>
    </Button>
  </Border>
</Window>
