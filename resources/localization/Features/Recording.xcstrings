    "audio-recording.resume-menu": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audioaufnahme fortsetzen"}},"en":{"stringUnit":{"state":"translated","value":"Resume Audio Recording"}},"es":{"stringUnit":{"state":"translated","value":"Reanudar grabación de audio"}},"fr":{"stringUnit":{"state":"translated","value":"Reprendre l’enregistrement audio"}},"ja":{"stringUnit":{"state":"translated","value":"音声録音を再開"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음 재개"}},"ru":{"stringUnit":{"state":"translated","value":"Продолжить аудиозапись"}},"vi":{"stringUnit":{"state":"translated","value":"Tiếp tục bản ghi âm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续录音"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"繼續錄音"}}}},
    "audio-recording.retry-save": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Speichern der Audioaufnahme erneut versuchen"}},"en":{"stringUnit":{"state":"translated","value":"Retry Saving Audio Recording"}},"es":{"stringUnit":{"state":"translated","value":"Reintentar guardar la grabación de audio"}},"fr":{"stringUnit":{"state":"translated","value":"Réessayer d’enregistrer l’enregistrement audio"}},"ja":{"stringUnit":{"state":"translated","value":"音声録音の保存を再試行"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음 저장 재시도"}},"ru":{"stringUnit":{"state":"translated","value":"Повторить сохранение аудиозаписи"}},"vi":{"stringUnit":{"state":"translated","value":"Thử lưu lại bản ghi âm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试保存录音"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重試儲存錄音"}}}},
