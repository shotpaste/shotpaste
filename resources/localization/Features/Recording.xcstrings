    "recording.cloud.console" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Speech console"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "语音控制台"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "語音控制台"}}, "de": {"stringUnit": {"state": "translated", "value": "Sprachkonsole"}}, "es": {"stringUnit": {"state": "translated", "value": "Consola de voz"}}, "fr": {"stringUnit": {"state": "translated", "value": "Console vocale"}}, "ja": {"stringUnit": {"state": "translated", "value": "音声コンソール"}}, "ko": {"stringUnit": {"state": "translated", "value": "음성 콘솔"}}, "ru": {"stringUnit": {"state": "translated", "value": "Консоль речи"}}, "vi": {"stringUnit": {"state": "translated", "value": "Bảng điều khiển giọng nói"}}}},
    "recording.cloud.resume" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Resume queries and cleanup"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "恢复查询与清理"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復查詢與清理"}}, "de": {"stringUnit": {"state": "translated", "value": "Abfragen und Bereinigung fortsetzen"}}, "es": {"stringUnit": {"state": "translated", "value": "Reanudar consultas y limpieza"}}, "fr": {"stringUnit": {"state": "translated", "value": "Reprendre les requêtes et le nettoyage"}}, "ja": {"stringUnit": {"state": "translated", "value": "照会と削除を再開"}}, "ko": {"stringUnit": {"state": "translated", "value": "조회 및 정리 재개"}}, "ru": {"stringUnit": {"state": "translated", "value": "Продолжить запросы и очистку"}}, "vi": {"stringUnit": {"state": "translated", "value": "Tiếp tục truy vấn và dọn dẹp"}}}},
    "recording.cloud.jobs" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cloud tasks and original transcripts"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "云任务与原始文字稿"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "雲端任務與原始文字稿"}}, "de": {"stringUnit": {"state": "translated", "value": "Cloud-Aufgaben und Originaltranskripte"}}, "es": {"stringUnit": {"state": "translated", "value": "Tareas en la nube y transcripciones originales"}}, "fr": {"stringUnit": {"state": "translated", "value": "Tâches cloud et transcriptions originales"}}, "ja": {"stringUnit": {"state": "translated", "value": "クラウドタスクと元の文字起こし"}}, "ko": {"stringUnit": {"state": "translated", "value": "클라우드 작업 및 원본 전사"}}, "ru": {"stringUnit": {"state": "translated", "value": "Облачные задачи и исходные транскрипции"}}, "vi": {"stringUnit": {"state": "translated", "value": "Tác vụ đám mây và bản chép gốc"}}}},
    "recording.cloud.cancel-note" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Closing a window keeps the task running. Cancel stops new requests; accepted work may still be billed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "关闭窗口后任务继续。取消会停止新请求，已受理的识别仍可能收费。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "關閉視窗後任務繼續。取消會停止新請求，已受理的識別仍可能收費。"}}, "de": {"stringUnit": {"state": "translated", "value": "Aufgaben laufen nach dem Schließen weiter. Abbrechen stoppt neue Anfragen; angenommene Aufträge können Kosten verursachen."}}, "es": {"stringUnit": {"state": "translated", "value": "La tarea sigue al cerrar. Cancelar detiene solicitudes nuevas; las aceptadas pueden generar cargos."}}, "fr": {"stringUnit": {"state": "translated", "value": "La tâche continue après fermeture. Annuler arrête les nouvelles requêtes ; celles acceptées peuvent être facturées."}}, "ja": {"stringUnit": {"state": "translated", "value": "ウィンドウを閉じても処理は続きます。取消は新規リクエストを停止しますが、受付済みの処理は課金される場合があります。"}}, "ko": {"stringUnit": {"state": "translated", "value": "창을 닫아도 작업은 계속됩니다. 취소는 새 요청을 중지하며 수락된 작업은 과금될 수 있습니다."}}, "ru": {"stringUnit": {"state": "translated", "value": "Закрытие окна не останавливает задачу. Отмена прекращает новые запросы; принятые могут оплачиваться."}}, "vi": {"stringUnit": {"state": "translated", "value": "Đóng cửa sổ không dừng tác vụ. Hủy dừng yêu cầu mới; yêu cầu đã nhận vẫn có thể tính phí."}}}},
    "recording.cloud.pending-cleanup" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cloud cleanup pending; retain credentials"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "云端待清理，请保留凭证"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "雲端待清理，請保留憑證"}}, "de": {"stringUnit": {"state": "translated", "value": "Cloud-Bereinigung ausstehend; Zugangsdaten behalten"}}, "es": {"stringUnit": {"state": "translated", "value": "Limpieza pendiente; conservar credenciales"}}, "fr": {"stringUnit": {"state": "translated", "value": "Nettoyage en attente ; conserver les identifiants"}}, "ja": {"stringUnit": {"state": "translated", "value": "クラウド削除待ち・認証情報を保持してください"}}, "ko": {"stringUnit": {"state": "translated", "value": "클라우드 정리 대기 중; 자격 증명 유지"}}, "ru": {"stringUnit": {"state": "translated", "value": "Ожидается очистка; сохраните учётные данные"}}, "vi": {"stringUnit": {"state": "translated", "value": "Đang chờ dọn dẹp; giữ thông tin xác thực"}}}},
    "recording.cloud.cleaned" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "No pending cloud deletion"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无待删除云端副本"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無待刪除雲端副本"}}, "de": {"stringUnit": {"state": "translated", "value": "Keine ausstehende Cloud-Löschung"}}, "es": {"stringUnit": {"state": "translated", "value": "Sin borrados pendientes en la nube"}}, "fr": {"stringUnit": {"state": "translated", "value": "Aucune suppression cloud en attente"}}, "ja": {"stringUnit": {"state": "translated", "value": "クラウド削除待ちなし"}}, "ko": {"stringUnit": {"state": "translated", "value": "대기 중인 클라우드 삭제 없음"}}, "ru": {"stringUnit": {"state": "translated", "value": "Нет ожидающего удаления из облака"}}, "vi": {"stringUnit": {"state": "translated", "value": "Không có bản đám mây chờ xóa"}}}},
    "recording.cloud.resubmit" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Submit again (may charge again)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新提交（可能重复收费）"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新提交（可能重複收費）"}}, "de": {"stringUnit": {"state": "translated", "value": "Erneut senden (erneute Kosten möglich)"}}, "es": {"stringUnit": {"state": "translated", "value": "Enviar de nuevo (posibles cargos nuevos)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Renvoyer (nouvelle facturation possible)"}}, "ja": {"stringUnit": {"state": "translated", "value": "再送信（再課金の可能性）"}}, "ko": {"stringUnit": {"state": "translated", "value": "다시 제출 (중복 과금 가능)"}}, "ru": {"stringUnit": {"state": "translated", "value": "Отправить снова (возможна повторная оплата)"}}, "vi": {"stringUnit": {"state": "translated", "value": "Gửi lại (có thể tính phí lần nữa)"}}}},
    "recording.cloud.uncertain" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Review the task before submitting again. The original request may have been accepted; a new submission can cause duplicate charges."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请检查原任务后再决定是否重新提交。原请求可能已受理，新提交可能重复收费。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請檢查原任務後再決定是否重新提交。原請求可能已受理，新提交可能重複收費。"}}, "de": {"stringUnit": {"state": "translated", "value": "Auftrag vor erneutem Senden prüfen. Der ursprüngliche Antrag kann angenommen worden sein; doppelte Kosten sind möglich."}}, "es": {"stringUnit": {"state": "translated", "value": "Revise la tarea antes de reenviar. La solicitud original puede haberse aceptado; podrían duplicarse los cargos."}}, "fr": {"stringUnit": {"state": "translated", "value": "Vérifiez la tâche avant de renvoyer. La requête initiale peut avoir été acceptée ; risque de double facturation."}}, "ja": {"stringUnit": {"state": "translated", "value": "再送信前に元のタスクを確認してください。既に受付済みで重複課金される可能性があります。"}}, "ko": {"stringUnit": {"state": "translated", "value": "다시 제출하기 전에 원래 작업을 확인하세요. 이미 수락되어 중복 과금될 수 있습니다."}}, "ru": {"stringUnit": {"state": "translated", "value": "Проверьте задачу перед повтором. Исходный запрос мог быть принят; возможна двойная оплата."}}, "vi": {"stringUnit": {"state": "translated", "value": "Kiểm tra tác vụ trước khi gửi lại. Yêu cầu gốc có thể đã được nhận; có nguy cơ tính phí trùng."}}}},
    "recording.cloud.permission" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Check credentials and service/IAM permissions in the console"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请检查凭证、服务开通和 IAM 权限"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請檢查憑證、服務開通和 IAM 權限"}}, "de": {"stringUnit": {"state": "translated", "value": "Zugangsdaten und Dienst-/IAM-Rechte in der Konsole prüfen"}}, "es": {"stringUnit": {"state": "translated", "value": "Revise credenciales y permisos de servicio/IAM"}}, "fr": {"stringUnit": {"state": "translated", "value": "Vérifiez les identifiants et droits de service/IAM"}}, "ja": {"stringUnit": {"state": "translated", "value": "認証情報・サービス有効化・IAM権限を確認"}}, "ko": {"stringUnit": {"state": "translated", "value": "자격 증명, 서비스 활성화 및 IAM 권한 확인"}}, "ru": {"stringUnit": {"state": "translated", "value": "Проверьте ключи и права сервиса/IAM"}}, "vi": {"stringUnit": {"state": "translated", "value": "Kiểm tra thông tin, kích hoạt dịch vụ và quyền IAM"}}}},
    "recording.cloud.quota" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Check account balance and service quota"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请检查余额和服务额度"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請檢查餘額和服務額度"}}, "de": {"stringUnit": {"state": "translated", "value": "Guthaben und Dienstkontingent prüfen"}}, "es": {"stringUnit": {"state": "translated", "value": "Revise saldo y cuota"}}, "fr": {"stringUnit": {"state": "translated", "value": "Vérifiez le solde et les quotas"}}, "ja": {"stringUnit": {"state": "translated", "value": "残高とサービス割当を確認"}}, "ko": {"stringUnit": {"state": "translated", "value": "잔액 및 서비스 할당량 확인"}}, "ru": {"stringUnit": {"state": "translated", "value": "Проверьте баланс и квоту"}}, "vi": {"stringUnit": {"state": "translated", "value": "Kiểm tra số dư và hạn mức"}}}},
    "recording.cloud.cloud-error" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cloud request failed; check the status code in the console"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "云请求失败，请在控制台检查状态码"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "雲請求失敗，請在控制台檢查狀態碼"}}, "de": {"stringUnit": {"state": "translated", "value": "Cloud-Anfrage fehlgeschlagen; Statuscode prüfen"}}, "es": {"stringUnit": {"state": "translated", "value": "Solicitud fallida; revise el código en la consola"}}, "fr": {"stringUnit": {"state": "translated", "value": "Échec cloud ; vérifiez le code dans la console"}}, "ja": {"stringUnit": {"state": "translated", "value": "クラウドリクエスト失敗・コンソールでコードを確認"}}, "ko": {"stringUnit": {"state": "translated", "value": "클라우드 요청 실패; 콘솔에서 상태 코드 확인"}}, "ru": {"stringUnit": {"state": "translated", "value": "Ошибка запроса; проверьте код в консоли"}}, "vi": {"stringUnit": {"state": "translated", "value": "Yêu cầu thất bại; kiểm tra mã trong bảng điều khiển"}}}},
    "recording.cloud.automatic" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Automatic language detection"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "自动识别语言"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "自動識別語言"}}, "de": {"stringUnit": {"state": "translated", "value": "Automatische Spracherkennung"}}, "es": {"stringUnit": {"state": "translated", "value": "Detección automática del idioma"}}, "fr": {"stringUnit": {"state": "translated", "value": "Détection automatique de la langue"}}, "ja": {"stringUnit": {"state": "translated", "value": "言語を自動検出"}}, "ko": {"stringUnit": {"state": "translated", "value": "자동 언어 감지"}}, "ru": {"stringUnit": {"state": "translated", "value": "Автоопределение языка"}}, "vi": {"stringUnit": {"state": "translated", "value": "Tự động nhận dạng ngôn ngữ"}}}},
    "recording.cloud.setup-note" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Testing sets up temporary storage and transcribes a short public audio sample. Volcengine bills transcription and storage usage."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"测试会配置临时存储，并转写一段公开短音频。火山引擎会按转写及存储用量计费。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"測試會設定暫存空間，並轉寫一段公開短音訊。火山引擎會依轉寫及儲存用量計費。"}},"de":{"stringUnit":{"state":"translated","value":"Der Test richtet temporären Speicher ein und transkribiert ein kurzes öffentliches Audiobeispiel. Volcengine berechnet Transkription und Speichernutzung."}},"es":{"stringUnit":{"state":"translated","value":"La prueba configura almacenamiento temporal y transcribe una muestra pública corta. Volcengine cobra por transcripción y almacenamiento."}},"fr":{"stringUnit":{"state":"translated","value":"Le test configure le stockage temporaire et transcrit un court extrait audio public. Volcengine facture la transcription et le stockage utilisés."}},"ja":{"stringUnit":{"state":"translated","value":"テストは一時ストレージを設定し、短い公開音声を文字起こしします。Volcengineが文字起こしとストレージの使用量に応じて課金します。"}},"ko":{"stringUnit":{"state":"translated","value":"테스트는 임시 저장소를 설정하고 짧은 공개 오디오를 전사합니다. Volcengine에서 전사 및 저장소 사용량에 따라 요금을 청구합니다."}},"ru":{"stringUnit":{"state":"translated","value":"Тест настраивает временное хранилище и распознаёт короткий открытый аудиофрагмент. Volcengine взимает плату за транскрипцию и хранение."}},"vi":{"stringUnit":{"state":"translated","value":"Kiểm tra sẽ thiết lập bộ nhớ tạm và chép lời một mẫu âm thanh công khai ngắn. Volcengine tính phí theo mức dùng chép lời và lưu trữ."}}}},
    "audio-recording.transcription-failed": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Audio gespeichert; Transkription fehlgeschlagen – zum Wiederholen klicken" } },
        "en": { "stringUnit": { "state": "translated", "value": "Audio saved; transcription failed — click to retry" } },
        "es": { "stringUnit": { "state": "translated", "value": "Audio guardado; transcripción fallida: haz clic para reintentar" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Audio enregistré ; transcription échouée — cliquer pour réessayer" } },
        "ja": { "stringUnit": { "state": "translated", "value": "音声は保存済みです。文字起こしに失敗しました。クリックして再試行" } },
        "ko": { "stringUnit": { "state": "translated", "value": "오디오 저장됨. 전사 실패 — 클릭하여 재시도" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Аудио сохранено; транскрипция не удалась — нажмите для повтора" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Đã lưu âm thanh; chép lời thất bại — bấm để thử lại" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "录音已保存，转写失败，点击重试" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "錄音已儲存，轉寫失敗，點擊重試" } }
      }
    },
    "audio-recording.processing-failed": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Audio gespeichert; Verarbeitung fehlgeschlagen – zum Wiederholen klicken" } },
        "en": { "stringUnit": { "state": "translated", "value": "Audio saved; processing failed — click to retry" } },
        "es": { "stringUnit": { "state": "translated", "value": "Audio guardado; procesamiento fallido: haz clic para reintentar" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Audio enregistré ; traitement échoué — cliquer pour réessayer" } },
        "ja": { "stringUnit": { "state": "translated", "value": "音声は保存済みです。処理に失敗しました。クリックして再試行" } },
        "ko": { "stringUnit": { "state": "translated", "value": "오디오 저장됨. 처리 실패 — 클릭하여 재시도" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Аудио сохранено; обработка не удалась — нажмите для повтора" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Đã lưu âm thanh; xử lý thất bại — bấm để thử lại" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "录音已保存，后续处理失败，点击重试" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "錄音已儲存，後續處理失敗，點擊重試" } }
      }
    },
    "audio-recording.dictation-disabled": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Audio gespeichert; Diktierfunktion in den Systemeinstellungen aktivieren, dann zum Wiederholen klicken" } },
        "en": { "stringUnit": { "state": "translated", "value": "Audio saved; enable Dictation in System Settings, then click to retry" } },
        "es": { "stringUnit": { "state": "translated", "value": "Audio guardado; activa Dictado en Ajustes del Sistema y haz clic para reintentar" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Audio enregistré ; activer Dictée dans Réglages Système, puis cliquer pour réessayer" } },
        "ja": { "stringUnit": { "state": "translated", "value": "音声は保存済みです。システム設定で音声入力を有効にし、クリックして再試行" } },
        "ko": { "stringUnit": { "state": "translated", "value": "오디오 저장됨. 시스템 설정에서 받아쓰기를 켠 후 클릭하여 재시도" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Аудио сохранено; включите диктовку в Системных настройках и нажмите для повтора" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Đã lưu âm thanh; bật Đọc chính tả trong Cài đặt hệ thống rồi bấm để thử lại" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "录音已保存，请在系统设置启用听写后点击重试" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "錄音已儲存，請在系統設定啟用聽寫後點擊重試" } }
      }
    },
    "recording-toolbar.preparing-recording": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Aufnahme wird vorbereitet …" } },
        "en": { "stringUnit": { "state": "translated", "value": "Preparing recording…" } },
        "es": { "stringUnit": { "state": "translated", "value": "Preparando grabación…" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Préparation de l’enregistrement…" } },
        "ja": { "stringUnit": { "state": "translated", "value": "収録を準備中…" } },
        "ko": { "stringUnit": { "state": "translated", "value": "녹화 준비 중…" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Подготовка записи…" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Đang chuẩn bị ghi…" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在准备录制…" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "正在準備錄製…" } }
      }
    },
    "recording.delete-confirmation-message": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die aktuelle Aufnahme wird in den Papierkorb verschoben. Dies kann in ShotPaste nicht rückgängig gemacht werden." } },
        "en": { "stringUnit": { "state": "translated", "value": "The current recording will be moved to Trash. This cannot be undone in ShotPaste." } },
        "es": { "stringUnit": { "state": "translated", "value": "La grabación actual se moverá a la Papelera. Esto no se puede deshacer en ShotPaste." } },
        "fr": { "stringUnit": { "state": "translated", "value": "L’enregistrement en cours sera placé dans la corbeille. Cette action est irréversible dans ShotPaste." } },
        "ja": { "stringUnit": { "state": "translated", "value": "現在の収録をゴミ箱に移動します。この操作は ShotPaste では取り消せません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "현재 녹화를 휴지통으로 이동합니다. ShotPaste에서는 이 작업을 취소할 수 없습니다." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Текущая запись будет перемещена в Корзину. Это действие нельзя отменить в ShotPaste." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Bản ghi hiện tại sẽ được chuyển vào Thùng rác. Không thể hoàn tác trong ShotPaste." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前录制将移到废纸篓。此操作无法在 ShotPaste 中撤销。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "目前錄製將移到垃圾桶。此操作無法在 ShotPaste 中還原。" } }
      }
    },
