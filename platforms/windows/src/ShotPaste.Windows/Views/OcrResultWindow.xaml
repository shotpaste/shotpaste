<Window x:Class="ShotPaste.Windows.Views.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotPaste · OCR 与二维码" Width="440" SizeToContent="Height" MaxHeight="360"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowActivated="False" ShowInTaskbar="False" Focusable="True"
        AutomationProperties.AutomationId="OcrResultCard">
  <Border x:Name="ResultLiveRegion" Background="{DynamicResource HudBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1"
          CornerRadius="{DynamicResource Radius.Card}" Padding="14" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave"
          AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="OCR 结果已复制">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{StaticResource Icon.Close}" ContentTemplate="{StaticResource Icon.Template}"
                Style="{StaticResource HudIconButton}" Width="26" Height="26" Padding="0" Click="OnClose" Margin="8,0,0,0"
                AutomationProperties.AutomationId="OcrResultClose" AutomationProperties.Name="关闭 OCR 卡片"/>
        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="{DynamicResource Radius.Pill}" Background="{DynamicResource SuccessSoftBrush}" Margin="0,0,10,0">
          <ContentControl Content="{StaticResource Icon.Ocr}" ContentTemplate="{StaticResource Icon.Template}" Foreground="{DynamicResource SuccessBrush}" Width="16" Height="16"/>
        </Border>
        <StackPanel>
          <TextBlock Text="识别结果已复制" Foreground="{DynamicResource HudTextBrush}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
          <TextBlock Text="10 秒后自动关闭 · 悬停暂停" Foreground="{DynamicResource HudSecondaryTextBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
      <Border Grid.Row="1" Background="{DynamicResource HudInputBrush}" BorderBrush="{DynamicResource HudBorderBrush}"
              BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}" MaxHeight="78" Margin="0,10,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="9,7">
          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource HudTextBrush}"
                     AutomationProperties.AutomationId="OcrResultText"/>
        </ScrollViewer>
      </Border>
      <ItemsControl Grid.Row="2" ItemsSource="{Binding Links}" Margin="0,8,0,0" MaxHeight="130">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource HudTextBrush}" ToolTip="{Binding}"/>
              <Button Grid.Column="1" Content="复制" Tag="{Binding}" Click="OnCopyLink" Style="{StaticResource HudTextButton}" Margin="6,0,0,0" Padding="8,4"
                      AutomationProperties.AutomationId="OcrResultCopyLink"/>
              <Button Grid.Column="2" Content="打开" Tag="{Binding}" Click="OnOpenLink" Style="{StaticResource HudTextButton}" Margin="4,0,0,0" Padding="8,4"
                      AutomationProperties.AutomationId="OcrResultOpenLink" AutomationProperties.Name="{Binding}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button x:Name="OpenAllButton" Content="全部打开" Click="OnOpenAll" Style="{StaticResource HudTextButton}" Padding="10,5" Margin="0,0,6,0"
                AutomationProperties.AutomationId="OcrResultOpenAll"/>
        <Button Content="再次复制全部" Click="OnCopy" Style="{StaticResource HudTextButton}" Padding="10,5"
                AutomationProperties.AutomationId="OcrResultCopy" AutomationProperties.Name="再次复制全部识别结果"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
