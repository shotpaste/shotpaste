            "es": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Volcengine devolvió una respuesta de transcripción no válida."
                }
            },
            "fr": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Volcengine a renvoyé une réponse de transcription invalide."
                }
