    "one-shot.shortcut-description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen gemeinsamen Bereich auswählen und dann Screenshot, Scrollaufnahme oder Aufnahme starten oder den Zwischenablageverlauf öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one shared area, then take a screenshot, scrolling capture, recording, or open Clipboard History"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un área compartida y después haz una captura, una captura con desplazamiento, una grabación o abre el historial del portapapeles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une zone commune, puis prenez une capture, une capture avec défilement, lancez un enregistrement ou ouvrez l’historique du presse-papiers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有する範囲を 1 つ選び、スクリーンショット、スクロールキャプチャ、録画を行うか、クリップボード履歴を開きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 영역을 하나 선택한 다음 스크린샷, 스크롤 캡처, 녹화를 실행하거나 클립보드 기록을 엽니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите одну общую область, затем сделайте снимок, захват с прокруткой, запись или откройте историю буфера обмена"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một vùng dùng chung, sau đó chụp màn hình, chụp cuộn, quay màn hình hoặc mở Lịch sử bảng nhớ tạm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个共享区域，然后截图、滚动截屏、录屏或打开剪贴板历史"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個共用區域，然後截圖、捲動截圖、錄影或開啟剪貼簿記錄"
          }
        }
      }
    },
