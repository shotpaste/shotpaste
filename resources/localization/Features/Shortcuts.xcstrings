        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý phím tắt cho lịch sử bảng nhớ tạm và bật/tắt chế độ nổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
