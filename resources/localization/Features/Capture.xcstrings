            "state": "translated",
            "value": "One Shot konnte den eingefrorenen Bildschirm nicht vorbereiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One Shot could not prepare the frozen screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "One Shot no pudo preparar la pantalla congelada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "One Shot n’a pas pu préparer l’écran figé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "One Shot で画面を固定できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "One Shot에서 고정 화면을 준비하지 못했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подготовить зафиксированный экран One Shot."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "One Shot không thể chuẩn bị màn hình đã đóng băng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键 Shot 无法准备冻结屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一鍵 Shot 無法準備凍結畫面。"
          }
        }
      }
    },
    "one-shot.scrolling-help-message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie den Inhalt im ausgewählten Bereich, starten Sie die Aufnahme und scrollen Sie dann vertikal, bis die gesamte Seite erfasst ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the content inside the selected area, start capture, then scroll vertically until the full page is collected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el contenido dentro del área seleccionada, inicia la captura y desplázate verticalmente hasta recopilar toda la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le contenu dans la zone sélectionnée, démarrez la capture, puis faites défiler verticalement jusqu’à ce que toute la page soit collectée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツを選択範囲内に収めたままキャプチャを開始し、ページ全体を取得するまで縦にスクロールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠를 선택 영역 안에 둔 상태에서 캡처를 시작한 다음 전체 페이지가 수집될 때까지 세로로 스크롤하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте содержимое в выбранной области, начните захват и прокручивайте по вертикали, пока не будет собрана вся страница."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nội dung trong vùng đã chọn, bắt đầu chụp rồi cuộn dọc cho đến khi thu thập đủ toàn bộ trang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将内容保持在选区内，开始截取后垂直滚动，直到完整页面收集完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將內容保持在選區內，開始擷取後垂直捲動，直到完整頁面收集完成。"
          }
        }
      }
    },
