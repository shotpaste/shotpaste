                      <Border Tag="3" AllowDrop="True" Drop="OnQuickActionDrop" Margin="0,0,6,6" Padding="4" CornerRadius="{DynamicResource Radius.Sm}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><DockPanel><TextBlock Tag="3" Text="⋮⋮ 4" Cursor="SizeAll" Focusable="True" Margin="2,0,5,0" VerticalAlignment="Center" PreviewMouseLeftButtonDown="OnQuickActionDragStart" PreviewMouseMove="OnQuickActionDragMove" PreviewKeyDown="OnQuickActionHandleKeyDown" AutomationProperties.HelpText="Alt 加方向键调整槽位顺序"/><ComboBox SelectionChanged="OnQuickActionChanged" SelectedValue="{Binding QuickAccessAction4}" SelectedValuePath="Tag"><ComboBoxItem Content="复制" Tag="Copy"/><ComboBoxItem Content="保存 / 打开" Tag="SaveOrOpen"/><ComboBoxItem Content="拖出" Tag="Drag"/><ComboBoxItem Content="关闭" Tag="Close"/><ComboBoxItem Content="删除" Tag="Delete"/><ComboBoxItem Content="贴图" Tag="Pin"/><ComboBoxItem Content="停用" Tag="None"/></ComboBox></DockPanel></Border>
                      <Border Tag="4" AllowDrop="True" Drop="OnQuickActionDrop" Margin="0,0,6,6" Padding="4" CornerRadius="{DynamicResource Radius.Sm}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><DockPanel><TextBlock Tag="4" Text="⋮⋮ 5" Cursor="SizeAll" Focusable="True" Margin="2,0,5,0" VerticalAlignment="Center" PreviewMouseLeftButtonDown="OnQuickActionDragStart" PreviewMouseMove="OnQuickActionDragMove" PreviewKeyDown="OnQuickActionHandleKeyDown" AutomationProperties.HelpText="Alt 加方向键调整槽位顺序"/><ComboBox SelectionChanged="OnQuickActionChanged" SelectedValue="{Binding QuickAccessAction5}" SelectedValuePath="Tag"><ComboBoxItem Content="复制" Tag="Copy"/><ComboBoxItem Content="保存 / 打开" Tag="SaveOrOpen"/><ComboBoxItem Content="拖出" Tag="Drag"/><ComboBoxItem Content="关闭" Tag="Close"/><ComboBoxItem Content="删除" Tag="Delete"/><ComboBoxItem Content="贴图" Tag="Pin"/><ComboBoxItem Content="停用" Tag="None"/></ComboBox></DockPanel></Border>
                      <Border Tag="5" AllowDrop="True" Drop="OnQuickActionDrop" Margin="0,0,6,6" Padding="4" CornerRadius="{DynamicResource Radius.Sm}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><DockPanel><TextBlock Tag="5" Text="⋮⋮ 6" Cursor="SizeAll" Focusable="True" Margin="2,0,5,0" VerticalAlignment="Center" PreviewMouseLeftButtonDown="OnQuickActionDragStart" PreviewMouseMove="OnQuickActionDragMove" PreviewKeyDown="OnQuickActionHandleKeyDown" AutomationProperties.HelpText="Alt 加方向键调整槽位顺序"/><ComboBox SelectionChanged="OnQuickActionChanged" SelectedValue="{Binding QuickAccessAction6}" SelectedValuePath="Tag"><ComboBoxItem Content="复制" Tag="Copy"/><ComboBoxItem Content="保存 / 打开" Tag="SaveOrOpen"/><ComboBoxItem Content="拖出" Tag="Drag"/><ComboBoxItem Content="关闭" Tag="Close"/><ComboBoxItem Content="删除" Tag="Delete"/><ComboBoxItem Content="贴图" Tag="Pin"/><ComboBoxItem Content="停用" Tag="None"/></ComboBox></DockPanel></Border>
                    </UniformGrid>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="重置槽位" Click="OnResetQuickActions" Padding="9,4"/>
                      <TextBlock Text="拖动编号手柄可排序；键盘可用 Alt 加方向键；选择“停用”会保留该槽位。" Style="{StaticResource SettingHint}" VerticalAlignment="Center"/>
                    </DockPanel>
                  </StackPanel>
                  <TextBlock Grid.Row="5" Text="浮层尺寸" VerticalAlignment="Center" Margin="0,12,0,0"/>
                  <Slider Grid.Row="5" Grid.Column="1" Minimum="0.75" Maximum="1.5" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding QuickAccessScale}" Width="150" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                  <CheckBox Grid.Row="7" Grid.Column="1" Content="显示浮动卡片" IsChecked="{Binding ShowQuickAccess}" Margin="0,12,0,0"/>
                  <CheckBox Grid.Row="12" Grid.Column="1" Content="允许从卡片拖出文件" IsChecked="{Binding QuickAccessEnableDrag}" Margin="0,12,0,0"/>
                  <TextBlock Grid.Row="10" Text="动画样式" VerticalAlignment="Center" Margin="0,12,0,0"/>
                  <ComboBox Grid.Row="10" Grid.Column="1" SelectedValue="{Binding QuickAccessAnimationStyle}" SelectedValuePath="Tag" Width="130" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <ComboBoxItem Content="滑入" Tag="Slide"/><ComboBoxItem Content="缩放" Tag="Scale"/>
                  </ComboBox>
                  <CheckBox Grid.Row="13" Grid.Column="1" Content="双指轻扫" IsChecked="{Binding QuickAccessTwoFingerSwipeEnabled}" Margin="0,12,0,0"/>
                  <TextBlock Grid.Row="14" Text="轻扫灵敏度" VerticalAlignment="Center" Margin="0,12,0,0"/>
                  <Slider Grid.Row="14" Grid.Column="1" Minimum="0.5" Maximum="3" Value="{Binding QuickAccessSwipeSensitivity}" Width="150" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                  <CheckBox Grid.Row="9" Grid.Column="1" Content="窗口打开时隐藏" IsChecked="{Binding QuickAccessHideCardWhenWindowOpen}" Margin="0,12,0,0"/>
                  <TextBlock Grid.Row="15" Text="触控板滑动方向" VerticalAlignment="Center" Margin="0,12,0,0"/>
                  <ComboBox Grid.Row="15" Grid.Column="1" SelectedValue="{Binding QuickAccessTrackpadSwipeMode}" SelectedValuePath="Tag" Width="160" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <ComboBoxItem Content="自然" Tag="Natural"/><ComboBoxItem Content="反向" Tag="Inverted"/>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="卡片操作" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="最多同时保留 5 张卡片。每个动作使用固定语义位置；停用动作会保留空位，不会让其余按钮跳位。" Style="{StaticResource SettingHint}"/>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                  <TextBlock Text="向左滑动" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" SelectedValue="{Binding QuickAccessSwipeLeftAction}" SelectedValuePath="Tag"><ComboBoxItem Content="关闭" Tag="Close"/><ComboBoxItem Content="复制" Tag="Copy"/><ComboBoxItem Content="保存 / 打开" Tag="SaveOrOpen"/><ComboBoxItem Content="贴图" Tag="Pin"/><ComboBoxItem Content="删除" Tag="Delete"/><ComboBoxItem Content="无动作" Tag="None"/></ComboBox>
                  <TextBlock Grid.Column="2" Text="向右滑动" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  <ComboBox Grid.Column="3" SelectedValue="{Binding QuickAccessSwipeRightAction}" SelectedValuePath="Tag"><ComboBoxItem Content="关闭" Tag="Close"/><ComboBoxItem Content="复制" Tag="Copy"/><ComboBoxItem Content="保存 / 打开" Tag="SaveOrOpen"/><ComboBoxItem Content="贴图" Tag="Pin"/><ComboBoxItem Content="删除" Tag="Delete"/><ComboBoxItem Content="无动作" Tag="None"/></ComboBox>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="HistoryTab" Header="剪贴板历史" Tag="{StaticResource Icon.History}" Style="{StaticResource SettingsTabItem}" AutomationProperties.AutomationId="SettingsHistoryTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
          <StackPanel Margin="2,0,8,12">
            <TextBlock Text="剪贴板历史" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentControl Content="{StaticResource Icon.Clipboard}" Style="{StaticResource SettingRowIcon}"/>
                <StackPanel Grid.Column="1"><TextBlock Text="归档复制的文本、图像和视频" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="即使原始文件被移动或删除，也保留剪贴板内容" Style="{StaticResource SettingHint}"/></StackPanel>
                <CheckBox Grid.Column="2" IsChecked="{Binding ClipboardHistoryEnabled}" AutomationProperties.AutomationId="SettingsClipboardHistoryEnabled"/>
              </Grid>
            </Border>

            <TextBlock Text="显示" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.Expand}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="面板位置" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="选择悬浮面板在屏幕上的出现位置" Style="{StaticResource SettingHint}"/></StackPanel><ComboBox Grid.Column="2" SelectedValue="{Binding HistoryPosition}" SelectedValuePath="Tag" Width="150"><ComboBoxItem Content="顶部居中" Tag="TopCenter"/><ComboBoxItem Content="底部居中" Tag="BottomCenter"/></ComboBox></Grid>
                <Border Style="{StaticResource SettingDivider}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.History}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="默认筛选" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="打开悬浮面板时显示的筛选方式" Style="{StaticResource SettingHint}"/></StackPanel><ComboBox Grid.Column="2" SelectedValue="{Binding HistoryDefaultFilter}" SelectedValuePath="Tag" Width="150"><ComboBoxItem Content="屏幕截图" Tag="Screenshot"/><ComboBoxItem Content="滚动截屏" Tag="Scrolling"/><ComboBoxItem Content="屏幕录制" Tag="Recording"/><ComboBoxItem Content="剪贴板历史" Tag="Clipboard"/></ComboBox></Grid>
                <Border Style="{StaticResource SettingDivider}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.CompactTemplate}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="背景样式" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="适用于剪贴板历史窗口和悬浮面板" Style="{StaticResource SettingHint}"/></StackPanel><ComboBox Grid.Column="2" SelectedValue="{Binding HistoryBackgroundStyle}" SelectedValuePath="Tag" Width="150" AutomationProperties.AutomationId="SettingsHistoryBackground"><ComboBoxItem Content="HUD" Tag="Hud"/><ComboBoxItem Content="纯色" Tag="Solid"/></ComboBox></Grid>
                <Border Style="{StaticResource SettingDivider}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.Expand}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="面板大小" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="调整悬浮面板及其预览卡片的大小" Style="{StaticResource SettingHint}"/></StackPanel><Slider Grid.Column="2" Minimum="0.75" Maximum="1.5" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding HistoryScale}" AutomationProperties.Name="历史面板界面缩放"/></Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="保留时间" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.Refresh}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="自动删除" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="0 表示永久保留截屏和录屏" Style="{StaticResource SettingHint}"/></StackPanel><Slider Grid.Column="2" Minimum="0" Maximum="90" TickFrequency="1" Value="{Binding HistoryRetentionDays}"/><TextBox Grid.Column="3" Text="{Binding HistoryRetentionDays}" Margin="8,0,0,0"/></Grid>
                <Border Style="{StaticResource SettingDivider}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.History}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="剪贴板历史最多保存条数" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="0 表示剪贴板历史中保存的截屏和录屏数量无上限" Style="{StaticResource SettingHint}"/></StackPanel><Slider Grid.Column="2" Minimum="0" Maximum="1000" TickFrequency="10" Value="{Binding HistoryMaxCount}"/><TextBox Grid.Column="3" Text="{Binding HistoryMaxCount}" Margin="8,0,0,0"/></Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="存储" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock x:Name="CaptureStorageUsageText" Text="正在计算截图与录屏目录占用…" Style="{StaticResource SettingHint}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="捕获" AutomationProperties.Name="打开截图与录屏目录" Click="OnOpenCaptureDirectory" Margin="8,0,0,0"/>
                  <TextBlock x:Name="ClipboardStorageUsageText" Grid.Row="1" Text="正在计算媒体剪贴板目录占用…" Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,8,0,0">
                    <Button Content="刷新占用" Click="OnRefreshHistoryStorage" Margin="0,0,8,0"/>
                    <Button Content="剪贴板" AutomationProperties.Name="打开媒体剪贴板目录" Click="OnOpenClipboardDirectory"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="ShortcutsTab" Header="快捷键" Tag="{StaticResource Icon.Keyboard}" Style="{StaticResource SettingsTabItem}" AutomationProperties.AutomationId="SettingsShortcutsTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
          <StackPanel Margin="2,0,8,12">
            <TextBlock Text="系统快捷键" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentControl Content="{StaticResource Icon.Check}" Style="{StaticResource SettingRowIcon}" Foreground="{DynamicResource SuccessBrush}"/>
                <StackPanel Grid.Column="1"><TextBlock Text="快捷键状态" Style="{StaticResource SettingRowTitle}"/><TextBlock x:Name="HotkeySummaryText" Text="正在检查快捷键注册状态…" Style="{StaticResource SettingHint}"/></StackPanel>
                <Button Grid.Column="2" Content="刷新" AutomationProperties.Name="刷新状态" Click="OnRefreshHotkeyStatus"/>
              </Grid>
            </Border>

            <TextBlock Text="全局快捷键" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.Keyboard}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="启用快捷键" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="可在任意前台应用中使用快捷键截屏" Style="{StaticResource SettingHint}"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding ShortcutsEnabled}"/></Grid></Border>

            <TextBlock Text="截屏快捷键" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="一键 Shot" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="选择一个共享区域，然后截图、滚动截屏、录屏或打开剪贴板历史" Style="{StaticResource SettingHint}"/></StackPanel><TextBox Grid.Column="1" Text="{Binding OneShotHotkey}" Tag="OneShotHotkey" Style="{StaticResource HotkeyRecorder}" Margin="8,0" AutomationProperties.AutomationId="SettingsOneShotHotkey"/><TextBlock x:Name="OneShotHotkeyStatus" Grid.Column="2" VerticalAlignment="Center"/></Grid></Border>

            <TextBlock Text="录屏快捷键" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="暂停 / 恢复录制" Style="{StaticResource SettingRowTitle}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding RecordingPauseHotkey}" Tag="RecordingPauseHotkey" Style="{StaticResource HotkeyRecorder}" Margin="8,3"/><TextBlock x:Name="RecordingPauseHotkeyStatus" Grid.Column="2" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="1" Text="切换画笔 / 注释" Style="{StaticResource SettingRowTitle}" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RecordingAnnotationHotkey}" Tag="RecordingAnnotationHotkey" Style="{StaticResource HotkeyRecorder}" Margin="8,3"/><TextBlock x:Name="RecordingAnnotationHotkeyStatus" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="2" Text="重新录制 / 重新开始" Style="{StaticResource SettingRowTitle}" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RecordingRestartHotkey}" Tag="RecordingRestartHotkey" Style="{StaticResource HotkeyRecorder}" Margin="8,3"/><TextBlock x:Name="RecordingRestartHotkeyStatus" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="3" Text="删除 / 取消" Style="{StaticResource SettingRowTitle}" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RecordingDeleteHotkey}" Tag="RecordingDeleteHotkey" Style="{StaticResource HotkeyRecorder}" Margin="8,3"/><TextBlock x:Name="RecordingDeleteHotkeyStatus" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"/>
            </Grid></Border>

            <TextBlock Text="剪贴板历史快捷键" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="打开剪贴板历史" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="打开剪贴板历史浏览器" Style="{StaticResource SettingHint}"/></StackPanel><TextBox Grid.Column="1" Text="{Binding HistoryHotkey}" Tag="HistoryHotkey" Style="{StaticResource HotkeyRecorder}" Margin="8,0"/><TextBlock x:Name="HistoryHotkeyStatus" Grid.Column="2" VerticalAlignment="Center"/></Grid></Border>

            <TextBlock Text="注释参考" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}"><StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="保存（完成）" Style="{StaticResource SettingRowTitle}"/><TextBlock Grid.Column="1" Text="Ctrl + S"/></Grid><Border Style="{StaticResource SettingDivider}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="撤销" Style="{StaticResource SettingRowTitle}"/><TextBlock Grid.Column="1" Text="Ctrl + Z"/></Grid><Border Style="{StaticResource SettingDivider}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="重做" Style="{StaticResource SettingRowTitle}"/><TextBlock Grid.Column="1" Text="Ctrl + Shift + Z"/></Grid><Border Style="{StaticResource SettingDivider}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="删除注释" Style="{StaticResource SettingRowTitle}"/><TextBlock Grid.Column="1" Text="Delete"/></Grid><Border Style="{StaticResource SettingDivider}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="取消 / 取消选择" Style="{StaticResource SettingRowTitle}"/><TextBlock Grid.Column="1" Text="Esc"/></Grid><Border Style="{StaticResource SettingDivider}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="微移注释" Style="{StaticResource SettingRowTitle}"/><TextBlock Grid.Column="1" Text="← ↑ → ↓"/></Grid><Border Style="{StaticResource SettingDivider}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="微移 10px" Style="{StaticResource SettingRowTitle}"/><TextBlock Grid.Column="1" Text="Shift + ← ↑ → ↓"/></Grid>
            </StackPanel></Border>
            <WrapPanel HorizontalAlignment="Right"><Button Content="恢复默认" Click="OnResetHotkeys" Margin="0,0,8,8"/><Button Content="清除全部" Click="OnClearHotkeys" Margin="0,0,8,8"/></WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="AdvancedTab" Header="高级" Tag="{StaticResource Icon.Advanced}" Style="{StaticResource SettingsTabItem}" AutomationProperties.AutomationId="SettingsAdvancedTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
          <StackPanel Margin="2,0,8,12">
            <Border Style="{StaticResource SettingsCard}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.Restore}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="恢复默认设置" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="重置所有设置" Style="{StaticResource SettingHint}"/></StackPanel><Button Grid.Column="2" Content="恢复" Click="OnRestoreDefaults"/></Grid>
            </Border>

            <TextBlock Text="诊断" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.Info}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="诊断日志" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="保存用于应用、截图、录屏和崩溃诊断的本地日志" Style="{StaticResource SettingHint}"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding DiagnosticsEnabled}"/></Grid>
                <Border Style="{StaticResource SettingDivider}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.History}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="日志保留时间" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="每天一个诊断日志文件" Style="{StaticResource SettingHint}"/></StackPanel><TextBox Grid.Column="2" Text="{Binding DiagnosticsRetentionDays}" AutomationProperties.AutomationId="SettingsDiagnosticsRetention"/></Grid>
                <Border Style="{StaticResource SettingDivider}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.Open}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="日志文件" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="打开 ShotPaste 本地日志目录" Style="{StaticResource SettingHint}"/></StackPanel><Button Grid.Column="2" Content="打开文件夹" Click="OnOpenLogDirectory"/></Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="法律信息" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.Open}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="开源许可证" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="版权、许可、免责声明和专利声明" Style="{StaticResource SettingHint}"/></StackPanel><Button Grid.Column="2" Content="打开" Click="OnOpenLegalNotices"/></Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12" Background="{DynamicResource SurfaceBrush}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="更改会立即生效" Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button Content="完成" Style="{StaticResource AccentButton}" MinWidth="82" Click="OnSave"
                AutomationProperties.AutomationId="SettingsSave"/>
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</Window>
