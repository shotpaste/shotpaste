{
  "sourceLanguage" : "en",
  "strings" : {
    "preferences-permissions.drag-app-title": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "ShotPaste in die Systemeinstellungen ziehen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Drag ShotPaste into System Settings" } },
        "es": { "stringUnit": { "state": "translated", "value": "Arrastra ShotPaste a Ajustes del Sistema" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Faites glisser ShotPaste dans Réglages Système" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ShotPasteをシステム設定にドラッグ" } },
        "ko": { "stringUnit": { "state": "translated", "value": "ShotPaste를 시스템 설정으로 드래그" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Перетащите ShotPaste в «Системные настройки»" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Kéo ShotPaste vào Cài đặt hệ thống" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "拖动 ShotPaste 到系统设置" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "拖移 ShotPaste 到系統設定" } }
      }
    },
    "preferences-permissions.drag-app-description": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Öffne eine Berechtigungsseite und ziehe dieses Symbol in die App-Liste. Falls macOS das Ablegen nicht akzeptiert, verwende die Taste „+“. Anschließend musst du den Schalter noch aktivieren." } },
        "en": { "stringUnit": { "state": "translated", "value": "Open a permission page, then drag this icon into its app list. If macOS does not accept the drop, use the + button. You still need to turn the switch on." } },
        "es": { "stringUnit": { "state": "translated", "value": "Abre una página de permisos y arrastra este icono a su lista de apps. Si macOS no acepta el icono, usa el botón +. Aún tendrás que activar el interruptor." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvrez une page d’autorisation, puis faites glisser cette icône dans la liste des apps. Si macOS refuse le dépôt, utilisez le bouton +. Vous devrez encore activer l’interrupteur." } },
        "ja": { "stringUnit": { "state": "translated", "value": "権限ページを開き、このアイコンをアプリ一覧にドラッグします。macOSがドロップを受け付けない場合は＋ボタンを使い、最後にスイッチをオンにしてください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "권한 페이지를 열고 이 아이콘을 앱 목록으로 드래그하세요. macOS가 드롭을 허용하지 않으면 + 버튼을 사용한 뒤 스위치를 켜야 합니다." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Откройте страницу разрешения и перетащите этот значок в список приложений. Если macOS не принимает его, используйте кнопку «+». Затем включите переключатель." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Mở trang quyền rồi kéo biểu tượng này vào danh sách ứng dụng. Nếu macOS không nhận thao tác thả, hãy dùng nút +. Bạn vẫn cần bật công tắc." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开一个权限页面，再把此图标拖入应用列表。如果 macOS 不接受拖放，请使用“+”按钮，最后仍需打开权限开关。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "開啟一個權限頁面，再將此圖示拖入 App 列表。如果 macOS 不接受拖放，請使用「+」按鈕，最後仍需開啟權限開關。" } }
      }
    },
    "preferences-permissions.request-all-system-permissions": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Alle Berechtigungen anfordern" } },
        "en": { "stringUnit": { "state": "translated", "value": "Request All Permissions" } },
        "es": { "stringUnit": { "state": "translated", "value": "Solicitar todos los permisos" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Demander toutes les autorisations" } },
        "ja": { "stringUnit": { "state": "translated", "value": "すべての権限をリクエスト" } },
        "ko": { "stringUnit": { "state": "translated", "value": "모든 권한 요청" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Запросить все разрешения" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Yêu cầu tất cả quyền" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "一键申请全部权限" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "一鍵申請全部權限" } }
      }
    },
    "preferences-permissions.authorization-guide-title": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Berechtigungen Schritt für Schritt einrichten" } },
        "en": { "stringUnit": { "state": "translated", "value": "Complete permissions step by step" } },
        "es": { "stringUnit": { "state": "translated", "value": "Completa los permisos paso a paso" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Configurer les autorisations étape par étape" } },
        "ja": { "stringUnit": { "state": "translated", "value": "権限を順番に設定" } },
        "ko": { "stringUnit": { "state": "translated", "value": "권한을 단계별로 설정" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Настройка разрешений по шагам" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Hoàn tất quyền theo từng bước" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "逐项完成权限授权" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "逐項完成權限授權" } }
      }
    },
    "preferences-permissions.authorization-guide-description": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "ShotPaste öffnet jede fehlende Berechtigungsseite und überspringt bereits erteilte Zugriffe." } },
        "en": { "stringUnit": { "state": "translated", "value": "ShotPaste opens each missing permission page and skips access you already granted." } },
        "es": { "stringUnit": { "state": "translated", "value": "ShotPaste abre cada permiso pendiente y omite los que ya concediste." } },
        "fr": { "stringUnit": { "state": "translated", "value": "ShotPaste ouvre chaque autorisation manquante et ignore celles déjà accordées." } },
        "ja": { "stringUnit": { "state": "translated", "value": "不足している権限ページを順に開き、設定済みの権限は自動でスキップします。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "ShotPaste가 필요한 권한 페이지를 열고 이미 허용된 권한은 건너뜁니다." } },
        "ru": { "stringUnit": { "state": "translated", "value": "ShotPaste открывает страницы недостающих разрешений и пропускает уже выданные." } },
        "vi": { "stringUnit": { "state": "translated", "value": "ShotPaste mở từng trang quyền còn thiếu và bỏ qua quyền đã cấp." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "ShotPaste 会逐个打开缺失权限的设置页，并自动跳过已授权项目。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "ShotPaste 會逐個開啟缺少權限的設定頁，並自動略過已授權項目。" } }
      }
    },
    "preferences-permissions.authorization-all-granted": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Alle Berechtigungen sind bereits erteilt. Es ist nichts zu tun." } },
        "en": { "stringUnit": { "state": "translated", "value": "All permissions are already granted. No action is needed." } },
        "es": { "stringUnit": { "state": "translated", "value": "Todos los permisos ya están concedidos. No hace falta hacer nada." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Toutes les autorisations sont déjà accordées. Aucune action n’est requise." } },
        "ja": { "stringUnit": { "state": "translated", "value": "すべての権限は設定済みです。操作は不要です。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "모든 권한이 이미 허용되어 있습니다. 추가 작업이 필요하지 않습니다." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Все разрешения уже выданы. Дополнительные действия не нужны." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Tất cả quyền đã được cấp. Bạn không cần thao tác thêm." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "所有权限均已授予，无需再次操作。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "所有權限均已授予，無需再次操作。" } }
      }
    },
    "preferences-permissions.authorization-complete": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Alle Berechtigungen sind bereit." } },
        "en": { "stringUnit": { "state": "translated", "value": "All permissions are ready." } },
        "es": { "stringUnit": { "state": "translated", "value": "Todos los permisos están listos." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Toutes les autorisations sont prêtes." } },
        "ja": { "stringUnit": { "state": "translated", "value": "すべての権限を設定しました。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "모든 권한이 준비되었습니다." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Все разрешения готовы." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Tất cả quyền đã sẵn sàng." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "所有权限均已完成。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "所有權限均已完成。" } }
      }
    },
    "preferences-permissions.authorization-step": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Schritt %1$d von %2$d: %3$@" } },
        "en": { "stringUnit": { "state": "translated", "value": "Step %1$d of %2$d: %3$@" } },
        "es": { "stringUnit": { "state": "translated", "value": "Paso %1$d de %2$d: %3$@" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Étape %1$d sur %2$d : %3$@" } },
        "ja": { "stringUnit": { "state": "translated", "value": "手順%1$d/%2$d：%3$@" } },
        "ko": { "stringUnit": { "state": "translated", "value": "%1$d/%2$d단계: %3$@" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Шаг %1$d из %2$d: %3$@" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Bước %1$d/%2$d: %3$@" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "第 %1$d/%2$d 步：%3$@" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "第 %1$d/%2$d 步：%3$@" } }
      }
    },
    "preferences-permissions.authorization-drag-instruction": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ziehe das ShotPaste-Symbol in die markierte App-Liste und aktiviere dann den Schalter." } },
        "en": { "stringUnit": { "state": "translated", "value": "Drag the ShotPaste icon into the highlighted app list, then turn its switch on." } },
        "es": { "stringUnit": { "state": "translated", "value": "Arrastra el icono de ShotPaste a la lista resaltada y activa su interruptor." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Faites glisser l’icône ShotPaste dans la liste surlignée, puis activez son interrupteur." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ShotPasteアイコンを強調表示された一覧へドラッグし、スイッチをオンにします。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "ShotPaste 아이콘을 강조 표시된 앱 목록으로 드래그한 다음 스위치를 켜세요." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Перетащите значок ShotPaste в выделенный список приложений и включите переключатель." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Kéo biểu tượng ShotPaste vào danh sách được tô sáng rồi bật công tắc." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "把 ShotPaste 图标拖入高亮的应用列表，然后打开权限开关。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "將 ShotPaste 圖示拖入醒目提示的 App 列表，然後開啟權限開關。" } }
      }
    },
    "preferences-permissions.authorization-microphone-instruction": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Aktiviere ShotPaste in der markierten Mikrofonliste. Falls es fehlt, verwende zuerst „Zugriff gewähren“ auf der Berechtigungsseite." } },
        "en": { "stringUnit": { "state": "translated", "value": "Turn on ShotPaste in the highlighted Microphone list. If it is missing, use Grant Access on the permission page first." } },
        "es": { "stringUnit": { "state": "translated", "value": "Activa ShotPaste en la lista de Micrófono resaltada. Si no aparece, usa primero Conceder acceso en la página de permisos." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Activez ShotPaste dans la liste Microphone surlignée. S’il manque, utilisez d’abord Accorder l’accès sur la page des autorisations." } },
        "ja": { "stringUnit": { "state": "translated", "value": "強調表示されたマイク一覧でShotPasteをオンにします。見つからない場合は、権限ページの「アクセスを許可」を先に使用してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "강조 표시된 마이크 목록에서 ShotPaste를 켜세요. 목록에 없으면 권한 페이지에서 먼저 접근 허용을 사용하세요." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Включите ShotPaste в выделенном списке микрофона. Если приложения нет, сначала нажмите «Предоставить доступ» на странице разрешений." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Bật ShotPaste trong danh sách Micrô được tô sáng. Nếu chưa có, hãy dùng Cấp quyền trên trang quyền trước." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在高亮的麦克风列表中打开 ShotPaste；如果列表中没有，请先在权限页点击“授予访问权限”。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在醒目提示的麥克風列表中開啟 ShotPaste；如果列表中沒有，請先在權限頁按一下「授予存取權限」。" } }
      }
    },
    "preferences-permissions.authorization-open-current": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Aktuelle Einstellung öffnen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Open Current Settings" } },
        "es": { "stringUnit": { "state": "translated", "value": "Abrir ajuste actual" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvrir le réglage actuel" } },
        "ja": { "stringUnit": { "state": "translated", "value": "現在の設定を開く" } },
        "ko": { "stringUnit": { "state": "translated", "value": "현재 설정 열기" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Открыть текущую настройку" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Mở cài đặt hiện tại" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开当前权限设置" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "開啟目前權限設定" } }
      }
    },
    "preferences-permissions.authorization-check-and-continue": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Prüfen und weiter" } },
        "en": { "stringUnit": { "state": "translated", "value": "Check & Continue" } },
        "es": { "stringUnit": { "state": "translated", "value": "Comprobar y continuar" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Vérifier et continuer" } },
        "ja": { "stringUnit": { "state": "translated", "value": "確認して続ける" } },
        "ko": { "stringUnit": { "state": "translated", "value": "확인 후 계속" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Проверить и продолжить" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Kiểm tra và tiếp tục" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "检查并继续" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "檢查並繼續" } }
      }
    },
    "preferences-permissions.authorization-not-detected": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die Berechtigung wurde noch nicht erkannt. Schließe den markierten Schritt ab und prüfe erneut." } },
        "en": { "stringUnit": { "state": "translated", "value": "Permission was not detected yet. Complete the highlighted step and check again." } },
        "es": { "stringUnit": { "state": "translated", "value": "Aún no se detectó el permiso. Completa el paso resaltado y vuelve a comprobar." } },
        "fr": { "stringUnit": { "state": "translated", "value": "L’autorisation n’est pas encore détectée. Terminez l’étape surlignée puis vérifiez à nouveau." } },
        "ja": { "stringUnit": { "state": "translated", "value": "権限をまだ確認できません。強調表示された操作を完了して、もう一度確認してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "아직 권한이 감지되지 않았습니다. 강조 표시된 단계를 완료하고 다시 확인하세요." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Разрешение пока не обнаружено. Выполните выделенный шаг и проверьте снова." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Chưa phát hiện quyền. Hãy hoàn tất bước được tô sáng rồi kiểm tra lại." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "尚未检测到此权限，请完成高亮步骤后再次检查。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "尚未偵測到此權限，請完成醒目提示的步驟後再次檢查。" } }
      }
    },
    "preferences-permissions.authorization-open-failed": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die Systemeinstellungen konnten nicht automatisch geöffnet werden. Verwende die Taste unten." } },
        "en": { "stringUnit": { "state": "translated", "value": "System Settings could not be opened automatically. Use the button below." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se pudo abrir Ajustes del Sistema automáticamente. Usa el botón de abajo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Réglages Système n’a pas pu s’ouvrir automatiquement. Utilisez le bouton ci-dessous." } },
        "ja": { "stringUnit": { "state": "translated", "value": "システム設定を自動で開けませんでした。下のボタンを使用してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "시스템 설정을 자동으로 열 수 없습니다. 아래 버튼을 사용하세요." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось автоматически открыть Системные настройки. Используйте кнопку ниже." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Không thể tự động mở Cài đặt hệ thống. Hãy dùng nút bên dưới." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法自动打开系统设置，请点击下方按钮打开。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法自動開啟系統設定，請按一下下方按鈕開啟。" } }
      }
    },
    "preferences-permissions.authorization-highlight-drag": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "ShotPaste hierher ziehen und aktivieren" } },
        "en": { "stringUnit": { "state": "translated", "value": "Drag ShotPaste here, then turn it on" } },
        "es": { "stringUnit": { "state": "translated", "value": "Arrastra ShotPaste aquí y actívalo" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Faites glisser ShotPaste ici, puis activez-le" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ここにShotPasteをドラッグしてオンにします" } },
        "ko": { "stringUnit": { "state": "translated", "value": "ShotPaste를 여기로 드래그한 다음 켜세요" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Перетащите ShotPaste сюда и включите" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Kéo ShotPaste vào đây rồi bật lên" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "拖动 ShotPaste 到这里，然后打开开关" } },
