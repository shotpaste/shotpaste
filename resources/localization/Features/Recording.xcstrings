    "recording.cloud.storage-checked" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Private storage checked; speech permission is checked by the paid sample test"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "私有存储检查通过；语音权限通过收费样本验证检查"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "私有儲存檢查通過；語音權限透過付費樣本驗證檢查"}}, "de": {"stringUnit": {"state": "translated", "value": "Privater Speicher geprüft; Sprachberechtigung durch kostenpflichtigen Beispieltest prüfen"}}, "es": {"stringUnit": {"state": "translated", "value": "Almacenamiento privado comprobado; el ejemplo de pago verifica permisos de voz"}}, "fr": {"stringUnit": {"state": "translated", "value": "Stockage privé vérifié ; le test payant vérifie les droits vocaux"}}, "ja": {"stringUnit": {"state": "translated", "value": "非公開ストレージ確認済み・音声権限は有料サンプルで確認"}}, "ko": {"stringUnit": {"state": "translated", "value": "비공개 저장소 확인됨; 음성 권한은 유료 샘플로 검증"}}, "ru": {"stringUnit": {"state": "translated", "value": "Хранилище проверено; права речи проверяет платный образец"}}, "vi": {"stringUnit": {"state": "translated", "value": "Đã kiểm tra bộ nhớ; mẫu có phí xác minh quyền giọng nói"}}}},
