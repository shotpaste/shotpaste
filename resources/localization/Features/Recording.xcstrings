    "audio-recording.pause": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Pausieren"}},"en":{"stringUnit":{"state":"translated","value":"Pause"}},"es":{"stringUnit":{"state":"translated","value":"Pausar"}},"fr":{"stringUnit":{"state":"translated","value":"Mettre en pause"}},"ja":{"stringUnit":{"state":"translated","value":"一時停止"}},"ko":{"stringUnit":{"state":"translated","value":"일시 정지"}},"ru":{"stringUnit":{"state":"translated","value":"Пауза"}},"vi":{"stringUnit":{"state":"translated","value":"Tạm dừng"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂停"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"暫停"}}}},
    "audio-recording.pause-menu": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audioaufnahme pausieren"}},"en":{"stringUnit":{"state":"translated","value":"Pause Audio Recording"}},"es":{"stringUnit":{"state":"translated","value":"Pausar grabación de audio"}},"fr":{"stringUnit":{"state":"translated","value":"Mettre en pause l’enregistrement audio"}},"ja":{"stringUnit":{"state":"translated","value":"音声録音を一時停止"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음 일시 정지"}},"ru":{"stringUnit":{"state":"translated","value":"Приостановить аудиозапись"}},"vi":{"stringUnit":{"state":"translated","value":"Tạm dừng bản ghi âm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂停录音"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"暫停錄音"}}}},
    "audio-recording.paused": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audioaufnahme pausiert"}},"en":{"stringUnit":{"state":"translated","value":"Audio recording paused"}},"es":{"stringUnit":{"state":"translated","value":"Grabación de audio en pausa"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrement audio en pause"}},"ja":{"stringUnit":{"state":"translated","value":"音声録音を一時停止中"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음 일시 정지됨"}},"ru":{"stringUnit":{"state":"translated","value":"Аудиозапись приостановлена"}},"vi":{"stringUnit":{"state":"translated","value":"Đã tạm dừng bản ghi âm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"录音已暂停"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"錄音已暫停"}}}},
    "audio-recording.polishing": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audiotranskript wird überarbeitet"}},"en":{"stringUnit":{"state":"translated","value":"Polishing audio transcript"}},"es":{"stringUnit":{"state":"translated","value":"Perfeccionando la transcripción de audio"}},"fr":{"stringUnit":{"state":"translated","value":"Amélioration de la transcription audio"}},"ja":{"stringUnit":{"state":"translated","value":"音声文字起こしを調整中"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 트랜스크립트 다듬는 중"}},"ru":{"stringUnit":{"state":"translated","value":"Обработка аудиорасшифровки"}},"vi":{"stringUnit":{"state":"translated","value":"Đang hoàn thiện bản chép lời âm thanh"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在润色录音转写"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在潤飾錄音轉錄"}}}},
    "audio-recording.preparation-title": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Neue Audioaufnahme"}},"en":{"stringUnit":{"state":"translated","value":"New Audio Recording"}},"es":{"stringUnit":{"state":"translated","value":"Nueva grabación de audio"}},"fr":{"stringUnit":{"state":"translated","value":"Nouvel enregistrement audio"}},"ja":{"stringUnit":{"state":"translated","value":"新しい音声録音"}},"ko":{"stringUnit":{"state":"translated","value":"새 오디오 녹음"}},"ru":{"stringUnit":{"state":"translated","value":"Новая аудиозапись"}},"vi":{"stringUnit":{"state":"translated","value":"Bản ghi âm mới"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新建录音"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新的錄音"}}}},
    "audio-recording.preparing": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audioaufnahme wird vorbereitet …"}},"en":{"stringUnit":{"state":"translated","value":"Preparing audio recording…"}},"es":{"stringUnit":{"state":"translated","value":"Preparando la grabación de audio…"}},"fr":{"stringUnit":{"state":"translated","value":"Préparation de l’enregistrement audio…"}},"ja":{"stringUnit":{"state":"translated","value":"音声録音を準備中…"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음 준비 중…"}},"ru":{"stringUnit":{"state":"translated","value":"Подготовка аудиозаписи…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang chuẩn bị bản ghi âm…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在准备录音…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在準備錄音…"}}}},
    "audio-recording.primary-language": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Primäre Sprache"}},"en":{"stringUnit":{"state":"translated","value":"Primary language"}},"es":{"stringUnit":{"state":"translated","value":"Idioma principal"}},"fr":{"stringUnit":{"state":"translated","value":"Langue principale"}},"ja":{"stringUnit":{"state":"translated","value":"主言語"}},"ko":{"stringUnit":{"state":"translated","value":"기본 언어"}},"ru":{"stringUnit":{"state":"translated","value":"Основной язык"}},"vi":{"stringUnit":{"state":"translated","value":"Ngôn ngữ chính"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"主要语言"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"主要語言"}}}},
    "audio-recording.privacy-disclosure": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audio bleibt auf diesem Mac. Zum Abrufen von Systemaudio kann intern ein sehr kleiner temporärer Bildschirmmedienstrom verwendet werden; nur die ausgewählte Audiodatei und abgeleitete Inhalte bleiben erhalten, und temporäres Video wird nach dem Speichern der Audiodatei gelöscht."}},"en":{"stringUnit":{"state":"translated","value":"Audio stays on this Mac. A small temporary screen media stream may be used to obtain system audio; only selected audio and derived content are kept, and temporary video is deleted after audio is saved."}},"es":{"stringUnit":{"state":"translated","value":"La grabación de audio permanece en este Mac. Para obtener el audio del sistema, ShotPaste puede usar internamente un flujo multimedia temporal de pantalla muy pequeño; solo se conservan el audio seleccionado y el contenido derivado, y el vídeo temporal se elimina después de guardar el audio."}},"fr":{"stringUnit":{"state":"translated","value":"L’audio reste sur ce Mac. Pour obtenir l’audio du système, ShotPaste peut utiliser en interne un très petit flux multimédia d’écran temporaire ; seuls l’audio sélectionné et le contenu dérivé sont conservés, et la vidéo temporaire est supprimée après l’enregistrement de l’audio."}},"ja":{"stringUnit":{"state":"translated","value":"音声はこのMac内に留まります。システムオーディオを取得するため、内部でごく小さな一時的な画面メディアストリームを使用する場合があります。選択した音声と派生コンテンツのみを保持し、一時的な動画は音声の保存後に削除します。"}},"ko":{"stringUnit":{"state":"translated","value":"오디오는 이 Mac에만 보관됩니다. 시스템 오디오를 얻기 위해 내부적으로 아주 작은 임시 화면 미디어 스트림을 사용할 수 있습니다. 선택한 오디오와 파생 콘텐츠만 보관하며, 임시 비디오는 오디오 저장 후 삭제됩니다."}},"ru":{"stringUnit":{"state":"translated","value":"Аудио остаётся на этом Mac. Для получения системного аудио ShotPaste может использовать внутри очень небольшой временный поток экранных медиаданных; сохраняются только выбранное аудио и производное содержимое, а временное видео удаляется после сохранения аудио."}},"vi":{"stringUnit":{"state":"translated","value":"Âm thanh được giữ trên máy Mac này. Để lấy âm thanh hệ thống, ShotPaste có thể dùng nội bộ một luồng phương tiện màn hình tạm thời rất nhỏ; chỉ âm thanh bạn chọn và nội dung phát sinh được giữ lại, còn video tạm thời sẽ bị xóa sau khi lưu âm thanh."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"音频保留在此 Mac 上。为获取系统音频，ShotPaste 内部可能使用极小的临时屏幕媒体流；最终仅保留你选择的音频及派生内容，临时视频会在音频保存完成后删除。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"音訊保留在此 Mac 上。為取得系統音訊，ShotPaste 內部可能使用極小的暫時螢幕媒體串流；最終僅保留你選擇的音訊及衍生內容，暫時影片會在音訊儲存完成後刪除。"}}}},
    "audio-recording.recording": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audioaufnahme"}},"en":{"stringUnit":{"state":"translated","value":"Audio recording"}},"es":{"stringUnit":{"state":"translated","value":"Grabación de audio"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrement audio"}},"ja":{"stringUnit":{"state":"translated","value":"音声録音"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음"}},"ru":{"stringUnit":{"state":"translated","value":"Аудиозапись"}},"vi":{"stringUnit":{"state":"translated","value":"Bản ghi âm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"录音"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"錄音"}}}},
    "audio-recording.restart": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Neu starten"}},"en":{"stringUnit":{"state":"translated","value":"Restart"}},"es":{"stringUnit":{"state":"translated","value":"Reiniciar"}},"fr":{"stringUnit":{"state":"translated","value":"Recommencer"}},"ja":{"stringUnit":{"state":"translated","value":"再起動"}},"ko":{"stringUnit":{"state":"translated","value":"다시 시작"}},"ru":{"stringUnit":{"state":"translated","value":"Начать заново"}},"vi":{"stringUnit":{"state":"translated","value":"Khởi động lại"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新开始"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重新開始"}}}},
    "audio-recording.restart-confirmation-message": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die aktuelle Audioaufnahme wird in den Papierkorb verschoben und eine neue Aufnahme mit denselben Einstellungen gestartet."}},"en":{"stringUnit":{"state":"translated","value":"The current audio recording will be moved to Trash and a new recording will start with the same settings."}},"es":{"stringUnit":{"state":"translated","value":"La grabación de audio actual se moverá a la Papelera y comenzará una nueva con los mismos ajustes."}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement audio actuel sera placé dans la corbeille et un nouvel enregistrement démarrera avec les mêmes réglages."}},"ja":{"stringUnit":{"state":"translated","value":"現在の音声録音をゴミ箱に移動し、同じ設定で新しい録音を開始します。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 오디오 녹음을 휴지통으로 이동하고 같은 설정으로 새 녹음을 시작합니다."}},"ru":{"stringUnit":{"state":"translated","value":"Текущая аудиозапись будет перемещена в Корзину, после чего начнётся новая запись с теми же настройками."}},"vi":{"stringUnit":{"state":"translated","value":"Bản ghi âm hiện tại sẽ được chuyển vào Thùng rác và bản ghi mới sẽ bắt đầu với cùng cài đặt."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前录音将移到废纸篓，并使用相同设置开始新的录音。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前錄音將移到垃圾桶，並使用相同設定開始新的錄音。"}}}},
    "audio-recording.restart-confirmation-title": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audioaufnahme neu starten?"}},"en":{"stringUnit":{"state":"translated","value":"Restart Audio Recording?"}},"es":{"stringUnit":{"state":"translated","value":"¿Reiniciar grabación de audio?"}},"fr":{"stringUnit":{"state":"translated","value":"Recommencer l’enregistrement audio ?"}},"ja":{"stringUnit":{"state":"translated","value":"音声録音を再起動しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음을 다시 시작할까요?"}},"ru":{"stringUnit":{"state":"translated","value":"Начать аудиозапись заново?"}},"vi":{"stringUnit":{"state":"translated","value":"Khởi động lại bản ghi âm?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新开始录音？"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"要重新開始錄音嗎？"}}}},
    "audio-recording.resume": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Fortsetzen"}},"en":{"stringUnit":{"state":"translated","value":"Resume"}},"es":{"stringUnit":{"state":"translated","value":"Reanudar"}},"fr":{"stringUnit":{"state":"translated","value":"Reprendre"}},"ja":{"stringUnit":{"state":"translated","value":"再開"}},"ko":{"stringUnit":{"state":"translated","value":"재개"}},"ru":{"stringUnit":{"state":"translated","value":"Продолжить"}},"vi":{"stringUnit":{"state":"translated","value":"Tiếp tục"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"繼續"}}}},
    "audio-recording.resume-menu": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audioaufnahme fortsetzen"}},"en":{"stringUnit":{"state":"translated","value":"Resume Audio Recording"}},"es":{"stringUnit":{"state":"translated","value":"Reanudar grabación de audio"}},"fr":{"stringUnit":{"state":"translated","value":"Reprendre l’enregistrement audio"}},"ja":{"stringUnit":{"state":"translated","value":"音声録音を再開"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음 재개"}},"ru":{"stringUnit":{"state":"translated","value":"Продолжить аудиозапись"}},"vi":{"stringUnit":{"state":"translated","value":"Tiếp tục bản ghi âm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续录音"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"繼續錄音"}}}},
