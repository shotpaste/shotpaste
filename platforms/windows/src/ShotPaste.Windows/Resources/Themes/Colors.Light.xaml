  <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#FFF1F4F9" />

  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="ControlBackgroundHoverBrush" Color="#FFEDF1F8" />
  <SolidColorBrush x:Key="ControlBackgroundPressedBrush" Color="#FFE1E7F1" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFDCE1EA" />
  <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#FFADB7C8" />
