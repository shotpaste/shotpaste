<Window x:Class="ShotPaste.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ShotPaste.Windows.Controls"
        AutomationProperties.AutomationId="SettingsWindow" Title="ShotPaste · 设置" Width="860" Height="650" MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterOwner" WindowStyle="None">
  <Window.Resources>
    <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}"/>
    <Style x:Key="HotkeyRecorder" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ToolTip" Value="单击后直接按下快捷键组合；按 Esc 取消本次输入。"/>
      <EventSetter Event="GotKeyboardFocus" Handler="OnHotkeyGotKeyboardFocus"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnHotkeyPreviewMouseLeftButtonDown"/>
      <EventSetter Event="PreviewKeyDown" Handler="OnHotkeyPreviewKeyDown"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
          <Setter Property="BorderThickness" Value="2"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}"/>
      <Setter Property="Padding" Value="{DynamicResource Settings.CardPadding}"/>
      <Setter Property="Margin" Value="{DynamicResource Settings.CardMargin}"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.SectionHeader}"/>
      <Setter Property="FontWeight" Value="{DynamicResource FontWeight.SectionHeader}"/>
      <Setter Property="Margin" Value="{DynamicResource Settings.SectionMargin}"/>
    </Style>
    <Style x:Key="SettingHint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Label.Medium}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SettingRowIcon" TargetType="ContentControl">
      <Setter Property="ContentTemplate" Value="{StaticResource Icon.Template}"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Margin" Value="0,0,14,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingRowTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="SettingDivider" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}"/>
      <Setter Property="Margin" Value="34,14,0,14"/>
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource WindowBackdropBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <controls:WindowTitleBar/>
  <Grid Grid.Row="1" Background="Transparent">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl x:Name="SettingsTabs" Margin="20,16,20,0" Background="Transparent" BorderThickness="0" TabStripPlacement="Top"
                Style="{StaticResource SettingsTabControl}" SelectionChanged="OnSettingsTabChanged">
      <TabItem x:Name="GeneralTab" Header="通用" Tag="{StaticResource Icon.Settings}" Style="{StaticResource SettingsTabItem}" AutomationProperties.AutomationId="SettingsGeneralTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Margin="0,14,0,0">
          <StackPanel Margin="22,0,22,20">
            <TextBlock Text="启动" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Content="{StaticResource Icon.Refresh}" Style="{StaticResource SettingRowIcon}"/>
                  <StackPanel Grid.Column="1"><TextBlock Text="登录时启动" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="登录 Windows 后自动启动 ShotPaste" Style="{StaticResource SettingHint}"/></StackPanel>
                  <CheckBox Grid.Column="2" IsChecked="{Binding LaunchAtStartup}" AutomationProperties.Name="登录时启动"/>
                </Grid>
                <Border Style="{StaticResource SettingDivider}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Content="{StaticResource Icon.Recording}" Style="{StaticResource SettingRowIcon}"/>
                  <StackPanel Grid.Column="1"><TextBlock Text="播放声音" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="截图、录屏与历史记录完成时播放提示音" Style="{StaticResource SettingHint}"/></StackPanel>
                  <CheckBox Grid.Column="2" IsChecked="{Binding PlaySounds}" AutomationProperties.Name="播放声音"/>
                </Grid>
                <Border Style="{StaticResource SettingDivider}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Content="{StaticResource Icon.QuickAccess}" Style="{StaticResource SettingRowIcon}"/>
                  <StackPanel Grid.Column="1"><TextBlock Text="显示系统托盘图标" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="从 Windows 系统托盘访问 ShotPaste" Style="{StaticResource SettingHint}"/></StackPanel>
                  <CheckBox Grid.Column="2" IsChecked="{Binding ShowTrayIcon}" AutomationProperties.Name="显示系统托盘图标"/>
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="外观" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Content="{StaticResource Icon.Keyboard}" Style="{StaticResource SettingRowIcon}"/>
                  <StackPanel Grid.Column="1"><TextBlock Text="应用语言" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="选择 ShotPaste 中使用的语言" Style="{StaticResource SettingHint}"/></StackPanel>
                  <ComboBox Grid.Column="2" SelectedValue="{Binding Language}" SelectedValuePath="Tag" Width="170">
                    <ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="繁體中文" Tag="zh-TW"/><ComboBoxItem Content="English" Tag="en-US"/><ComboBoxItem Content="日本語" Tag="ja-JP"/><ComboBoxItem Content="한국어" Tag="ko-KR"/><ComboBoxItem Content="Deutsch" Tag="de-DE"/><ComboBoxItem Content="Français" Tag="fr-FR"/><ComboBoxItem Content="Español" Tag="es-ES"/><ComboBoxItem Content="Русский" Tag="ru-RU"/><ComboBoxItem Content="Tiếng Việt" Tag="vi-VN"/>
                  </ComboBox>
                </Grid>
                <Border Style="{StaticResource SettingDivider}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Content="{StaticResource Icon.Advanced}" Style="{StaticResource SettingRowIcon}"/>
                  <StackPanel Grid.Column="1"><TextBlock Text="主题" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="选择偏好的应用外观" Style="{StaticResource SettingHint}"/></StackPanel>
                  <ComboBox Grid.Column="2" SelectedValue="{Binding Theme}" SelectedValuePath="Tag" Width="130"><ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="浅色" Tag="Light"/><ComboBoxItem Content="深色" Tag="Dark"/></ComboBox>
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="存储" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentControl Content="{StaticResource Icon.Save}" Style="{StaticResource SettingRowIcon}"/>
                <StackPanel Grid.Column="1"><TextBlock Text="保存位置" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="{Binding SaveDirectory}" Style="{StaticResource SettingHint}" TextTrimming="CharacterEllipsis"/></StackPanel>
                <Button Grid.Column="2" Content="选择…" Click="OnChooseDirectory"/>
              </Grid>
            </Border>

            <TextBlock Text="自动化" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Content="{StaticResource Icon.Open}" Style="{StaticResource SettingRowIcon}"/>
                  <StackPanel Grid.Column="1"><TextBlock Text="URL Scheme 集成" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="允许通过 shotpaste:// URL 进行外部触发" Style="{StaticResource SettingHint}"/></StackPanel>
                  <CheckBox x:Name="UrlSchemeCheckBox" Grid.Column="2" IsChecked="{Binding UrlSchemeEnabled}" AutomationProperties.Name="URL Scheme 集成"/>
                </Grid>
                <Border Style="{StaticResource SettingDivider}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Content="{StaticResource Icon.Advanced}" Style="{StaticResource SettingRowIcon}"/>
                  <StackPanel Grid.Column="1"><TextBlock Text="MCP Server" Style="{StaticResource SettingRowTitle}"/><TextBlock x:Name="McpServerStatusText" Text="仅监听 127.0.0.1，并要求 Bearer Token。" Style="{StaticResource SettingHint}" TextTrimming="CharacterEllipsis"/></StackPanel>
                  <TextBox Grid.Column="2" Text="{Binding McpServerPort}" ToolTip="1024–65535" Margin="8,0" AutomationProperties.Name="MCP Server 端口"/>
                  <Button Grid.Column="3" Content="复制连接配置" Click="OnCopyMcpConfiguration" Margin="8,0"/>
                  <CheckBox Grid.Column="4" IsChecked="{Binding McpServerEnabled}" AutomationProperties.AutomationId="SettingsMcpEnabled" AutomationProperties.Name="启用本机 MCP Server"/>
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="软件更新" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Content="{StaticResource Icon.Refresh}" Style="{StaticResource SettingRowIcon}"/>
                  <StackPanel Grid.Column="1"><TextBlock Text="自动检查" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="启动时检查更新" Style="{StaticResource SettingHint}"/></StackPanel>
                  <CheckBox Grid.Column="2" IsChecked="{Binding CheckForUpdatesAutomatically}" AutomationProperties.Name="启动时检查更新"/>
                </Grid>
                <Border Style="{StaticResource SettingDivider}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Content="{StaticResource Icon.Info}" Style="{StaticResource SettingRowIcon}"/>
                  <TextBlock x:Name="UpdateStatus" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingHint}" TextWrapping="Wrap"/>
                  <Button x:Name="CheckForUpdatesButton" Grid.Column="2" Content="检查更新" Click="OnCheckForUpdates" Margin="8,0,0,0"/>
                  <Button x:Name="OpenUpdatePageButton" Grid.Column="3" Content="前往 GitHub" Click="OnOpenUpdatePage" Margin="8,0,0,0" Visibility="Collapsed"/>
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="帮助" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock x:Name="PreviousCrashNotice" Text="检测到上次异常退出日志。导出诊断包可一并保存 crash.log，便于排查。" Style="{StaticResource SettingHint}" Foreground="{DynamicResource WarningBrush}" Visibility="Collapsed" Margin="34,0,0,12"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Content="{StaticResource Icon.Info}" Style="{StaticResource SettingRowIcon}"/>
                  <StackPanel Grid.Column="1"><TextBlock Text="报告问题" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="导出诊断信息或前往 GitHub 问题页面" Style="{StaticResource SettingHint}"/></StackPanel>
                  <Button Grid.Column="2" Content="导出诊断包…" Click="OnExportDiagnosticBundle" Margin="8,0"/>
                  <Button Grid.Column="3" Content="报告问题…" Click="OnOpenReportPage"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="CaptureRecordingTab" Header="捕获" Tag="{StaticResource Icon.Capture}" Style="{StaticResource SettingsTabItem}" AutomationProperties.AutomationId="SettingsCaptureRecordingTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
          <StackPanel Margin="2,0,8,12">
            <TabControl Background="Transparent" BorderThickness="0" Style="{StaticResource SettingsSubTabControl}" AutomationProperties.Name="捕获类型">
              <TabItem Header="通用" Style="{StaticResource SettingsSubTabItem}" AutomationProperties.AutomationId="SettingsCaptureGeneralSubtab">
                <StackPanel Margin="0,12,0,0">
                  <TextBlock Text="输出命名" Style="{StaticResource SectionTitle}"/>
                  <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="截图模板" Style="{StaticResource SettingRowTitle}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding ScreenshotNameTemplate}" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="录屏命名模板" Style="{StaticResource SettingRowTitle}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RecordingNameTemplate}" VerticalContentAlignment="Center" Margin="0,12,0,0"/>
                      </Grid>
                      <TextBlock Text="可在命名中使用日期、时间、毫秒和截图类型占位符。" Style="{StaticResource SettingHint}" Margin="0,12,0,0"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="保存与截图后操作" Style="{StaticResource SectionTitle}"/>
                  <Border Style="{StaticResource SettingsCard}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                      <TextBlock Grid.Column="1" Text="截图" HorizontalAlignment="Center" Style="{StaticResource SettingHint}"/>
                      <TextBlock Grid.Column="2" Text="屏幕录制" HorizontalAlignment="Center" Style="{StaticResource SettingHint}"/>
                      <TextBlock Grid.Row="1" Text="显示快速访问面板" Style="{StaticResource SettingRowTitle}" Margin="0,12,0,0"/>
                      <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding ShowQuickAccessForScreenshots}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                      <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding ShowQuickAccessForRecordings}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                      <TextBlock Grid.Row="2" Text="复制文件" Style="{StaticResource SettingRowTitle}" Margin="0,12,0,0"/>
                      <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding CopyScreenshots}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                      <CheckBox Grid.Row="2" Grid.Column="2" IsChecked="{Binding CopyRecordings}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                      <TextBlock Grid.Row="3" Text="保存" Style="{StaticResource SettingRowTitle}" Margin="0,12,0,0"/>
                      <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding SaveScreenshots}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                      <CheckBox Grid.Row="3" Grid.Column="2" IsChecked="{Binding SaveRecordings}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </TabItem>
              <TabItem Header="截图" Style="{StaticResource SettingsSubTabItem}" AutomationProperties.AutomationId="SettingsCaptureScreenshotSubtab">
                <StackPanel Margin="0,12,0,0">
                  <TextBlock Text="应用程序窗口" Style="{StaticResource SectionTitle}"/>
                  <Border Style="{StaticResource SettingsCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ContentControl Content="{StaticResource Icon.QuickAccess}" Style="{StaticResource SettingRowIcon}"/>
                      <StackPanel Grid.Column="1"><TextBlock Text="包含在屏幕截图中" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="在截取画面中显示 ShotPaste 窗口" Style="{StaticResource SettingHint}"/></StackPanel>
                      <CheckBox Grid.Column="2" IsChecked="{Binding IncludeOwnApplicationInScreenshots}" AutomationProperties.AutomationId="SettingsExcludeOwnApplication" AutomationProperties.Name="包含 ShotPaste 窗口"/>
                    </Grid>
                  </Border>

                  <TextBlock Text="桌面" Style="{StaticResource SectionTitle}"/>
                  <Border Style="{StaticResource SettingsCard}"><StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ContentControl Content="{StaticResource Icon.Screenshot}" Style="{StaticResource SettingRowIcon}"/>
                      <StackPanel Grid.Column="1"><TextBlock Text="隐藏桌面图标" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="截屏或录屏时暂时隐藏桌面图标" Style="{StaticResource SettingHint}"/></StackPanel>
                      <CheckBox Grid.Column="2" IsChecked="{Binding HideDesktopIconsInScreenshots}"/>
                    </Grid>
                    <Border Style="{StaticResource SettingDivider}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ContentControl Content="{StaticResource Icon.CompactTemplate}" Style="{StaticResource SettingRowIcon}"/>
                      <StackPanel Grid.Column="1"><TextBlock Text="隐藏桌面小组件" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="截屏或录屏时暂时隐藏桌面小组件" Style="{StaticResource SettingHint}"/></StackPanel>
                      <CheckBox Grid.Column="2" IsChecked="{Binding HideDesktopWidgetsInScreenshots}"/>
                    </Grid>
                  </StackPanel></Border>

                  <TextBlock Text="格式" Style="{StaticResource SectionTitle}"/>
                  <Border Style="{StaticResource SettingsCard}"><StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ContentControl Content="{StaticResource Icon.ArrowClassic}" Style="{StaticResource SettingRowIcon}"/>
                      <StackPanel Grid.Column="1"><TextBlock Text="显示光标" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="在截图中包含鼠标指针" Style="{StaticResource SettingHint}"/></StackPanel>
                      <CheckBox Grid.Column="2" IsChecked="{Binding ShowCursorInScreenshots}"/>
                    </Grid>
                    <Border Style="{StaticResource SettingDivider}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ContentControl Content="{StaticResource Icon.Search}" Style="{StaticResource SettingRowIcon}"/>
                      <StackPanel Grid.Column="1"><TextBlock Text="像素放大镜" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="选择时显示放大的像素和颜色值" Style="{StaticResource SettingHint}"/></StackPanel>
                      <CheckBox Grid.Column="2" IsChecked="{Binding ScreenshotMagnifierEnabled}"/>
                    </Grid>
                    <Border Style="{StaticResource SettingDivider}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ContentControl Content="{StaticResource Icon.Expand}" Style="{StaticResource SettingRowIcon}"/>
                      <StackPanel Grid.Column="1"><TextBlock Text="初始放大倍率" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="放大镜初始倍率（1–8 px）" Style="{StaticResource SettingHint}"/></StackPanel>
                      <ComboBox Grid.Column="2" SelectedValue="{Binding ScreenshotMagnifierZoom}" SelectedValuePath="Tag" Width="110" AutomationProperties.Name="放大镜像素缩放"><ComboBoxItem Content="1×" Tag="1"/><ComboBoxItem Content="2×" Tag="2"/><ComboBoxItem Content="4×" Tag="4"/><ComboBoxItem Content="8×" Tag="8"/></ComboBox>
                    </Grid>
                    <Border Style="{StaticResource SettingDivider}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ContentControl Content="{StaticResource Icon.Screenshot}" Style="{StaticResource SettingRowIcon}"/>
                      <StackPanel Grid.Column="1"><TextBlock Text="图像格式" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="屏幕截图的导出格式" Style="{StaticResource SettingHint}"/></StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal"><ComboBox SelectedValue="{Binding ScreenshotFormat}" SelectedValuePath="Tag" Width="100"><ComboBoxItem Content="PNG" Tag="Png"/><ComboBoxItem Content="JPEG" Tag="Jpeg"/><ComboBoxItem Content="WebP" Tag="WebP"/></ComboBox><TextBox Text="{Binding JpegQuality}" Width="54" Margin="8,0,0,0" ToolTip="JPEG / WebP 质量（1–100）"/></StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SettingDivider}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ContentControl Content="{StaticResource Icon.Expand}" Style="{StaticResource SettingRowIcon}"/>
                      <StackPanel Grid.Column="1"><TextBlock Text="输出缩放" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="自动和 1× 保留原生像素；2× 可放大" Style="{StaticResource SettingHint}"/></StackPanel>
                      <ComboBox Grid.Column="2" SelectedValue="{Binding ScreenshotScale}" SelectedValuePath="Tag" Width="110"><ComboBoxItem Content="自动" Tag="0"/><ComboBoxItem Content="1×" Tag="1"/><ComboBoxItem Content="2×" Tag="2"/></ComboBox>
                    </Grid>
                    <Border Style="{StaticResource SettingDivider}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ContentControl Content="{StaticResource Icon.Circle}" Style="{StaticResource SettingRowIcon}"/>
                      <StackPanel Grid.Column="1"><TextBlock Text="色彩空间" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="自动匹配显示器，或使用 sRGB / Display P3" Style="{StaticResource SettingHint}"/></StackPanel>
                      <ComboBox Grid.Column="2" SelectedValue="{Binding ScreenshotColorSpace}" SelectedValuePath="Tag" Width="130"><ComboBoxItem Content="自动" Tag="Auto"/><ComboBoxItem Content="sRGB" Tag="Srgb"/><ComboBoxItem Content="Display P3" Tag="DisplayP3"/></ComboBox>
                    </Grid>
                  </StackPanel></Border>

                  <TextBlock Text="滚动截屏" Style="{StaticResource SectionTitle}"/>
                  <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentControl Content="{StaticResource Icon.Info}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="显示会话提示" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="开始滚动截屏会话时保持操作提示可见" Style="{StaticResource SettingHint}"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding ScrollingShowHints}"/>
                  </Grid></Border>

                  <TextBlock Text="OCR（文本识别）" Style="{StaticResource SectionTitle}"/>
                  <Border Style="{StaticResource SettingsCard}"><StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.Check}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="捕获成功通知" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="截图或录屏保存后显示通知" Style="{StaticResource SettingHint}"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding ShowCaptureNotifications}"/></Grid>
                    <Border Style="{StaticResource SettingDivider}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.Info}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="成功通知" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="当文本复制到剪贴板时显示提示" Style="{StaticResource SettingHint}"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding ShowOcrSuccessNotifications}" AutomationProperties.AutomationId="SettingsOcrSuccessNotifications"/></Grid>
                    <Border Style="{StaticResource SettingDivider}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl Content="{StaticResource Icon.Open}" Style="{StaticResource SettingRowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="检测链接" Style="{StaticResource SettingRowTitle}"/><TextBlock Text="提示打开捕获文本中发现的网页链接" Style="{StaticResource SettingHint}"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding ShowOcrLinkNotifications}"/></Grid>
                    <Border Style="{StaticResource SettingDivider}"/>
