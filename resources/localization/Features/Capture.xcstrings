          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ShotPaste は、保存可能なステッチ画像をまだロックできませんでした。キャプチャを続行するか、「完了」を再試行するか、「キャンセル」することができます。"
          }
        },
        "ko": {
