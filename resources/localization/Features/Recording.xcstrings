    "recording.transcription.error-invalid-response": {
        "localizations": {
            "en": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Volcengine returned an invalid transcription response."
                }
            },
            "de": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Volcengine hat eine ungültige Transkriptionsantwort zurückgegeben."
                }
