<Window x:Class="ShotPaste.Windows.Views.PinnedImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:ShotPaste.Windows.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" Height="320" MinWidth="180" MinHeight="120" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" MouseWheel="OnMouseWheel" MouseLeftButtonDown="OnMouseDown" KeyDown="OnKeyDown"
        IsManipulationEnabled="True" ManipulationDelta="OnManipulationDelta"
        AutomationProperties.AutomationId="PinnedImageWindow">
  <Border CornerRadius="{DynamicResource Radius.Md}" Background="{DynamicResource Pinned.BackgroundBrush}" BorderBrush="{DynamicResource Pinned.BorderBrush}" BorderThickness="1">
    <Grid>
      <Image x:Name="PinnedImage" Stretch="Uniform" Margin="4" />
      <Border x:Name="ToolbarChrome" AutomationProperties.AutomationId="PinnedToolbarChrome"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="4"
              CornerRadius="{DynamicResource Radius.Md}" Background="{DynamicResource Pinned.ToolbarBackgroundBrush}"
              BorderBrush="{DynamicResource Pinned.ToolbarBorderBrush}" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="10" ShadowDepth="3" Opacity="0.38"/>
        </Border.Effect>
        <StackPanel x:Name="Toolbar" Orientation="Horizontal">
          <Button x:Name="LockButton" AutomationProperties.AutomationId="PinnedLock" Content="{loc:Localized Key='锁定'}" Style="{StaticResource HudTextButton}" Padding="7,3" MinHeight="24" Margin="0,0,5,0" Click="OnToggleLock" ToolTip="{loc:Localized Key='锁定后图片区域自动穿透；锁按钮保持可操作'}"/>
          <StackPanel x:Name="UnlockedControls" Orientation="Horizontal">
            <ComboBox x:Name="ZoomPicker" AutomationProperties.AutomationId="PinnedZoom" Width="70" Height="26" Margin="0,0,5,0" Style="{DynamicResource HudComboBox}"
                      IsEditable="True" IsReadOnly="True"
                      SelectedValuePath="Tag" SelectionChanged="OnZoomPresetChanged" ToolTip="{loc:Localized Key='贴图缩放'}">
              <ComboBoxItem Content="{loc:Localized Key='50%'}" Tag="0.5"/><ComboBoxItem Content="{loc:Localized Key='75%'}" Tag="0.75"/><ComboBoxItem Content="{loc:Localized Key='100%'}" Tag="1"/>
              <ComboBoxItem Content="{loc:Localized Key='125%'}" Tag="1.25"/><ComboBoxItem Content="{loc:Localized Key='150%'}" Tag="1.5"/><ComboBoxItem Content="{loc:Localized Key='200%'}" Tag="2"/>
            </ComboBox>
            <Button AutomationProperties.AutomationId="PinnedDrag" Content="{loc:Localized Key='拖出'}" Style="{StaticResource HudTextButton}" Padding="8,3" MinHeight="24" Margin="0,0,5,0" PreviewMouseLeftButtonDown="OnDragOut"/>
            <Button AutomationProperties.AutomationId="PinnedCopy" Content="{loc:Localized Key='复制'}" Style="{StaticResource HudTextButton}" Padding="8,3" MinHeight="24" Margin="0,0,5,0" Click="OnCopy" />
            <Button AutomationProperties.AutomationId="PinnedSave" Content="{loc:Localized Key='保存'}" Style="{StaticResource HudTextButton}" Padding="8,3" MinHeight="24" Margin="0,0,5,0" Click="OnSave" />
            <Button AutomationProperties.AutomationId="PinnedClose" Content="{StaticResource Icon.Close}" ContentTemplate="{StaticResource Icon.Template}" Style="{StaticResource HudIconButton}" Width="28" Height="24" Padding="0" Click="OnClose" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
