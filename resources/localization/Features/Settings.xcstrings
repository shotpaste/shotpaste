    "preferences-history.media-clipboard-description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablageinhalte behalten, auch wenn die Originaldatei verschoben oder gelöscht wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep clipboard content even if its original file moves or is deleted."
          }
