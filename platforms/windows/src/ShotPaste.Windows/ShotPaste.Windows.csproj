<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ShotPaste</AssemblyName>
    <RootNamespace>ShotPaste.Windows</RootNamespace>
    <Version>1.12.1</Version>
    <AssemblyVersion>1.12.1.0</AssemblyVersion>
    <FileVersion>1.12.1.0</FileVersion>
    <Product>ShotPaste</Product>
    <Description>Lightweight screenshot, annotation, OCR, scrolling capture, and screen recording tool.</Description>
    <Authors>ShotPaste</Authors>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Product>ShotPaste Debug</Product>
    <ApplicationIcon>Assets\shotpaste-debug-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <Reference Include="ScreenRecorderLib" Condition="'$(Platform)' == 'x64'">
      <HintPath>$(NuGetPackageRoot)screenrecorderlib\6.6.0\build\x64\ScreenRecorderLib.dll</HintPath>
      <Private>true</Private>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Reference>
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\..\..\assets\shotpaste-icon.png"
              Link="Assets\shotpaste-icon.png"
              Condition="'$(Configuration)' != 'Debug'" />
    <Resource Include="Assets\shotpaste-debug-icon.png"
              Link="Assets\shotpaste-icon.png"
              Condition="'$(Configuration)' == 'Debug'" />
    <EmbeddedResource Include="..\..\..\..\resources\localization\**\*.xcstrings"
                      Link="Localization\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\WindowsLocalization.en.json">
      <WithCulture>false</WithCulture>
      <LogicalName>ShotPaste.Windows.WindowsLocalization.en.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="ExcludeReleaseSymbolsFromPublish"
          AfterTargets="ComputeFilesToPublish"
          BeforeTargets="CopyFilesToPublishDirectory"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_ExistingReleasePublishSymbols Include="$(PublishDir)**\*.pdb" />
      <_ReleasePublishSymbols Include="@(ResolvedFileToPublish)"
                              Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(_ReleasePublishSymbols)" />
    </ItemGroup>
    <Delete Files="@(_ExistingReleasePublishSymbols)" />
    <Message Importance="High"
             Condition="'@(_ReleasePublishSymbols)' != '' Or '@(_ExistingReleasePublishSymbols)' != ''"
             Text="Excluding Release debug symbols from publish: @(_ReleasePublishSymbols->'%(Filename)%(Extension)', ', ')" />
  </Target>
</Project>
