<Window x:Class="ShotPaste.Windows.Views.ShotPasteDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ShotPaste.Windows.Controls"
        Title="ShotPaste" Width="430" SizeToContent="Height" MinHeight="190" MaxHeight="640"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource WindowBackdropBrush}"
        AutomationProperties.AutomationId="ShotPasteDialog">
  <Grid Background="{DynamicResource WindowBackdropBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <controls:WindowTitleBar ShowMinimize="False" ShowMaximize="False"/>
    <Grid Grid.Row="1" Margin="22,18,22,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="IconBackground" Width="38" Height="38" CornerRadius="{DynamicResource Radius.Pill}" Margin="0,1,14,0" VerticalAlignment="Top">
        <Path x:Name="IconPath" Width="20" Height="20" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource AccentForegroundBrush}"
              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ScrollViewer Grid.Column="1" MaxHeight="420" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="MessageText" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource FontSize.Body}"
                   TextWrapping="Wrap" LineHeight="19"/>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="TertiaryButton" Visibility="Collapsed" Margin="0,0,8,0" Click="OnTertiary"
                AutomationProperties.AutomationId="DialogTertiary"/>
        <Button x:Name="SecondaryButton" Visibility="Collapsed" Margin="0,0,8,0" Click="OnSecondary"
                AutomationProperties.AutomationId="DialogSecondary"/>
        <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}" MinWidth="82" Click="OnPrimary"
                AutomationProperties.AutomationId="DialogPrimary"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
