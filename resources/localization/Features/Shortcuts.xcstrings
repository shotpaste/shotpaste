    "preferences-shortcuts.no-conflicts-description": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die ShotPaste-Verknüpfungen, die Sie derzeit aktiviert haben, wurden keine überlappenden macOS-Screenshot-Verknüpfungen gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
