  <DataTemplate x:Key="Icon.Template">
    <Viewbox Width="15" Height="15" Stretch="Uniform">
      <Path Data="{Binding}" Fill="Transparent"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}"
            StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
    </Viewbox>
  </DataTemplate>
  <DataTemplate x:Key="Icon.CompactTemplate">
    <Viewbox Width="13" Height="13" Stretch="Uniform">
      <Path Data="{Binding}" Fill="Transparent"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}"
            StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
    </Viewbox>
  </DataTemplate>
  <DataTemplate x:Key="Icon.FillTemplate">
    <Viewbox Width="15" Height="15" Stretch="Uniform">
      <Path Data="{Binding}"
            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
    </Viewbox>
  </DataTemplate>

