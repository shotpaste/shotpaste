<Window x:Class="LiteScreen.Windows.Views.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lite Screen · OCR 与二维码" Width="520" Height="390" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen" Topmost="True">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="识别结果已复制" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TextBox Grid.Row="1" Text="{Binding Text}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock Text="可打开的链接" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <ItemsControl ItemsSource="{Binding Links}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding}" Tag="{Binding}" Click="OnOpenLink" HorizontalContentAlignment="Left"
                    HorizontalAlignment="Stretch" Margin="0,0,0,5" ToolTip="在默认应用中打开"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="再次复制全部" Click="OnCopy" Margin="0,0,8,0"/>
      <Button Content="完成" Click="OnClose" Style="{StaticResource AccentButton}"/>
    </StackPanel>
  </Grid>
</Window>
