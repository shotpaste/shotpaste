<Window x:Class="ShotPaste.Windows.Views.ScrollingProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotPaste · 滚动截屏" SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Background="Transparent" AllowsTransparency="True"
        ShowInTaskbar="False" ShowActivated="False" Focusable="True" Topmost="True"
        AutomationProperties.AutomationId="ScrollingProgressWindow" AutomationProperties.Name="滚动截屏控制">
  <Grid>
    <Border x:Name="CompactHud" CornerRadius="{DynamicResource Radius.Md}" Background="{DynamicResource HudBrush}"
            BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="8">
      <Grid x:Name="CaptureActions">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="PrimaryButton" Grid.Column="0" Content="开始截取" Padding="14,5"
                Style="{StaticResource AccentButton}" Click="OnPrimary"
                AutomationProperties.AutomationId="ScrollingPrimary" AutomationProperties.Name="开始或完成滚动截屏"/>
        <Button x:Name="CancelButton" Grid.Column="1" Content="{StaticResource Icon.Close}"
                ContentTemplate="{StaticResource Icon.Template}" Width="30" Height="28" Margin="8,0,0,0" Padding="0"
                Style="{StaticResource HudTextButton}" Click="OnCancel"
                AutomationProperties.AutomationId="ScrollingCancel" AutomationProperties.Name="取消滚动截屏"/>
      </Grid>
    </Border>

    <Border x:Name="SaveRecoveryPanel" Visibility="Collapsed" MinWidth="360" MaxWidth="520"
            CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource HudBrush}"
            BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="12">
      <StackPanel>
        <TextBlock x:Name="RecoveryTitle" Text="长图保存失败 · 成果仍保留"
                   Foreground="{DynamicResource HudTextBrush}" FontWeight="SemiBold" FontSize="13"/>
        <TextBlock x:Name="RecoveryDetail" Foreground="{DynamicResource HudSecondaryTextBrush}"
                   FontSize="11" TextWrapping="Wrap" Margin="0,7,0,10"/>
        <WrapPanel HorizontalAlignment="Right">
          <Button x:Name="CopyResultButton" Content="复制" Style="{StaticResource HudTextButton}"
                  Padding="10,5" Margin="0,0,6,0" Click="OnCopyResult"
                  AutomationProperties.AutomationId="ScrollingRecoveryCopy" AutomationProperties.Name="复制"/>
          <Button x:Name="SaveAsButton" Content="另存为..." Style="{StaticResource HudTextButton}"
                  Padding="10,5" Margin="0,0,6,0" Click="OnSaveAs"
                  AutomationProperties.AutomationId="ScrollingRecoverySaveAs" AutomationProperties.Name="另存为..."/>
          <Button x:Name="DiscardResultButton" Content="不要保存" Style="{StaticResource HudTextButton}"
                  Padding="10,5" Margin="0,0,6,0" Click="OnDiscardResult"
                  AutomationProperties.AutomationId="ScrollingRecoveryDiscard" AutomationProperties.Name="不要保存"/>
          <Button x:Name="RetrySaveButton" Content="重试保存" Style="{StaticResource AccentButton}"
                  Padding="12,5" Click="OnRetrySave"
                  AutomationProperties.AutomationId="ScrollingRecoveryRetry" AutomationProperties.Name="重试保存长图"/>
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
