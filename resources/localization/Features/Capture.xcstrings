      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MOV bietet eine bessere Qualität. MP4 bietet eine größere Kompatibilität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOV offers better quality. MP4 provides wider compatibility."
