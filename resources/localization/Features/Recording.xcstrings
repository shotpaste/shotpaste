    "recording.transcription.processing-privacy-note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the audio track is sent; video frames are not uploaded. Processing takes approximately the recording's playback duration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Audiospur wird gesendet; Videobilder werden nicht hochgeladen. Die Verarbeitung dauert ungefähr so lange wie die Wiedergabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se envía la pista de audio; los fotogramas de vídeo no se suben. El proceso tarda aproximadamente lo mismo que la reproducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la piste audio est envoyée ; les images vidéo ne sont pas téléversées. Le traitement dure environ aussi longtemps que la lecture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声トラックだけを送信し、映像フレームはアップロードしません。処理時間は録画の再生時間とほぼ同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 트랙만 전송하며 비디오 프레임은 업로드하지 않습니다. 처리 시간은 녹화 재생 시간과 비슷합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляется только аудиодорожка; кадры видео не загружаются. Обработка занимает примерно столько же времени, сколько воспроизведение записи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ gửi bản âm thanh, không tải khung hình video lên. Thời gian xử lý xấp xỉ thời lượng phát của bản ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只发送音轨，不上传视频画面；处理时长大致等于录屏播放时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只傳送音軌，不上傳影片畫面；處理時間大致等於螢幕錄影播放時間。"
          }
        }
      }
    },
