<Window x:Class="LiteScreen.Windows.Views.RecordingToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lite Screen · 正在录制" SizeToContent="WidthAndHeight" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        MouseLeftButtonDown="OnWindowMouseDown">
  <Window.Resources>
    <Style x:Key="RecordingIconButton" TargetType="Button" BasedOn="{StaticResource HudIconButton}">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="RecordingTextButton" TargetType="Button" BasedOn="{StaticResource HudTextButton}">
      <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="RecordingDivider" TargetType="Border">
      <Setter Property="Width" Value="1"/><Setter Property="Height" Value="20"/>
      <Setter Property="Margin" Value="4,0"/><Setter Property="Background" Value="#30FFFFFF"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Storyboard x:Key="RecordingPulseStoryboard" AutoReverse="True" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity"
                       From="1" To="0.25" Duration="0:0:0.65"/>
    </Storyboard>
  </Window.Resources>

  <Border CornerRadius="14" Background="{DynamicResource HudBrush}" BorderBrush="{DynamicResource HudBorderBrush}"
          BorderThickness="1" Padding="10,6">
    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.48"/></Border.Effect>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Grid Width="20" Height="20" Opacity="0.42" ToolTip="拖动工具栏">
        <Path Data="M5,7 H15 M5,10 H15 M5,13 H15" Stroke="{DynamicResource HudTextBrush}" StrokeThickness="1.4"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>
      <Border Style="{StaticResource RecordingDivider}"/>

      <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FFFF453A" Margin="0,0,8,0"/>
        <TextBlock x:Name="TimerText" Text="00:00" Foreground="{DynamicResource HudTextBrush}"
                   FontFamily="Cascadia Mono, Consolas" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <Border Style="{StaticResource RecordingDivider}"/>

      <StackPanel x:Name="MicrophonePanel" Orientation="Horizontal" Margin="7,0" VerticalAlignment="Center"
                  AutomationProperties.AutomationId="RecordingMicrophoneFeedback">
        <TextBlock Text="●" x:Name="MicrophoneDot" Foreground="#FF30D158" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <ProgressBar x:Name="MicrophoneMeter" AutomationProperties.AutomationId="RecordingMicrophoneLevel"
                     Width="42" Height="6" Minimum="0" Maximum="1" Value="0" BorderThickness="0"
                     Foreground="#FF30D158" Background="#35FFFFFF" VerticalAlignment="Center"/>
        <TextBlock x:Name="MicrophoneStateText" AutomationProperties.AutomationId="RecordingMicrophoneState"
                   Text="麦克风" Foreground="#DFFFFFFF" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"/>
      </StackPanel>
      <Border Style="{StaticResource RecordingDivider}"/>

      <Button x:Name="PauseButton" AutomationProperties.AutomationId="RecordingPause" Style="{StaticResource RecordingIconButton}" Click="OnPause" ToolTip="暂停录制">
        <TextBlock x:Name="PauseGlyph" Text="Ⅱ" FontSize="14" FontWeight="SemiBold"/>
      </Button>
      <Button x:Name="PenButton" AutomationProperties.AutomationId="RecordingPen" Style="{StaticResource RecordingIconButton}" Click="OnPen" ToolTip="在录制画面上标注">
        <Path Data="M3,14 L4.2,10 L11.8,2.4 C12.5,1.7 13.5,1.7 14.2,2.4 L15.6,3.8 C16.3,4.5 16.3,5.5 15.6,6.2 L8,13.8 Z M10.5,3.7 L14.3,7.5"
              Stroke="{DynamicResource HudTextBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform"/>
      </Button>
      <Border Style="{StaticResource RecordingDivider}"/>

      <Button Style="{StaticResource RecordingIconButton}" Click="OnRestart" ToolTip="重新录制">
        <Path Data="M14,5 A6,6 0 1 0 15,10 M14,2 V6 H10" Stroke="{DynamicResource HudTextBrush}" StrokeThickness="1.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"/>
      </Button>
      <Button Style="{StaticResource RecordingIconButton}" Click="OnDelete" ToolTip="丢弃本次录制">
        <Path Data="M3,5 H15 M6,5 V3 H12 V5 M5,7 V15 H13 V7 M8,8 V13 M10,8 V13"
              Stroke="{DynamicResource HudTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform"/>
      </Button>
      <Border Style="{StaticResource RecordingDivider}"/>

      <Button Content="停止" AutomationProperties.AutomationId="RecordingStop" Style="{StaticResource RecordingTextButton}" Click="OnStop" ToolTip="停止并保存"/>
    </StackPanel>
  </Border>
</Window>
