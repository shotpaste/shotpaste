<Window x:Class="ShotPaste.Windows.Views.RecordingInkToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:ShotPaste.Windows.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Background="{DynamicResource WindowBackdropBrush}"
        ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight">
  <Border CornerRadius="{DynamicResource Radius.Toolbar}" Background="{DynamicResource HudBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="7,6">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <StackPanel x:Name="ToolPanel" Orientation="Horizontal">
        <Button Tag="Selection" Content="{loc:Localized Key='选择'}" AutomationProperties.Name="{loc:Localized Key='选择标注'}" Style="{StaticResource HudTextButton}" Click="OnTool" Padding="7,3" MinHeight="26"/>
        <Button Tag="Rectangle" Content="{loc:Localized Key='矩形'}" AutomationProperties.Name="{loc:Localized Key='矩形标注'}" Style="{StaticResource HudTextButton}" Click="OnTool" Margin="3,0,0,0" Padding="7,3" MinHeight="26"/>
        <Button Tag="Oval" Content="{loc:Localized Key='椭圆'}" AutomationProperties.Name="{loc:Localized Key='椭圆标注'}" Style="{StaticResource HudTextButton}" Click="OnTool" Margin="3,0,0,0" Padding="7,3" MinHeight="26"/>
        <Button Tag="Arrow" Content="{loc:Localized Key='箭头'}" AutomationProperties.Name="{loc:Localized Key='箭头标注'}" Style="{StaticResource HudTextButton}" Click="OnTool" Margin="3,0,0,0" Padding="7,3" MinHeight="26"/>
        <Button Tag="Line" Content="{loc:Localized Key='直线'}" AutomationProperties.Name="{loc:Localized Key='直线标注'}" Style="{StaticResource HudTextButton}" Click="OnTool" Margin="3,0,0,0" Padding="7,3" MinHeight="26"/>
        <Button Tag="Pencil" Content="{loc:Localized Key='铅笔'}" AutomationProperties.Name="{loc:Localized Key='铅笔标注'}" Style="{StaticResource HudTextButton}" Click="OnTool" Margin="3,0,0,0" Padding="7,3" MinHeight="26"/>
        <Button Tag="Highlighter" Content="{loc:Localized Key='荧光'}" AutomationProperties.Name="{loc:Localized Key='荧光笔标注'}" Style="{StaticResource HudTextButton}" Click="OnTool" Margin="3,0,0,0" Padding="7,3" MinHeight="26"/>
      </StackPanel>
      <Border Width="1" Height="20" Background="{DynamicResource HudDividerBrush}" Margin="7,0"/>
      <StackPanel Orientation="Horizontal">
        <Button Tag="{StaticResource Annotation.Red.Value}" AutomationProperties.Name="{loc:Localized Key='红色'}" Background="{DynamicResource Annotation.RedBrush}" Width="22" Height="22" Padding="0" Click="OnColor" Margin="0,0,4,0"/>
        <Button Tag="{StaticResource Annotation.Yellow.Value}" AutomationProperties.Name="{loc:Localized Key='黄色'}" Background="{DynamicResource Annotation.YellowBrush}" Width="22" Height="22" Padding="0" Click="OnColor" Margin="0,0,4,0"/>
        <Button Tag="{StaticResource Annotation.Green.Value}" AutomationProperties.Name="{loc:Localized Key='绿色'}" Background="{DynamicResource Annotation.GreenBrush}" Width="22" Height="22" Padding="0" Click="OnColor" Margin="0,0,4,0"/>
        <Button Tag="{StaticResource Annotation.Blue.Value}" AutomationProperties.Name="{loc:Localized Key='蓝色'}" Background="{DynamicResource Annotation.BlueBrush}" Width="22" Height="22" Padding="0" Click="OnColor" Margin="0,0,4,0"/>
        <Button Tag="{StaticResource Annotation.White.Value}" AutomationProperties.Name="{loc:Localized Key='白色'}" Background="{DynamicResource Annotation.WhiteBrush}" Width="22" Height="22" Padding="0" Click="OnColor" Margin="0,0,7,0"/>
        <Slider x:Name="WidthSlider" AutomationProperties.Name="{loc:Localized Key='标注粗细'}" Style="{StaticResource HudSlider}" Minimum="1" Maximum="20" Value="4" Width="62" VerticalAlignment="Center" ValueChanged="OnWidthChanged"/>
      </StackPanel>
      <Border Width="1" Height="20" Background="{DynamicResource HudDividerBrush}" Margin="7,0"/>
      <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="ClearModePicker" Width="104" Height="26" Style="{DynamicResource HudComboBox}" SelectionChanged="OnClearModeChanged">
          <ComboBoxItem Content="{loc:Localized Key='手动清除'}" Tag="Manual"/>
          <ComboBoxItem Content="{loc:Localized Key='定时清除'}" Tag="AfterSeconds"/>
          <ComboBoxItem Content="{loc:Localized Key='按笔数清除'}" Tag="MaximumCount"/>
        </ComboBox>
        <TextBox x:Name="ClearValueBox" Style="{StaticResource HudTextBox}" Width="42" Height="26" Margin="5,0,0,0"
                 VerticalContentAlignment="Center" TextChanged="OnClearValueChanged"/>
        <TextBlock x:Name="ClearValueUnit" Foreground="{DynamicResource HudSecondaryTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
        <Button Content="{loc:Localized Key='撤销'}" AutomationProperties.Name="{loc:Localized Key='撤销最后标注'}" Style="{StaticResource HudTextButton}" Click="OnUndo" Margin="7,0,0,0" Padding="8,3" MinHeight="26"/>
        <Button Content="{loc:Localized Key='清空'}" AutomationProperties.Name="{loc:Localized Key='清空所有标注'}" Style="{StaticResource HudTextButton}" Click="OnClear" Margin="5,0,0,0" Padding="8,3" MinHeight="26"/>
      </StackPanel>
      <CheckBox x:Name="FadeCheckBox" Content="{loc:Localized Key='淡出'}" Foreground="{DynamicResource HudTextBrush}" Style="{DynamicResource HudCheckBox}" VerticalAlignment="Center"
                Checked="OnFadeChanged" Unchecked="OnFadeChanged" Margin="7,0,0,0"/>
      <Button Content="{StaticResource Icon.Close}" ContentTemplate="{StaticResource Icon.Template}" AutomationProperties.Name="{loc:Localized Key='关闭录屏标注'}"
              Style="{StaticResource HudIconButton}" Click="OnClose" Width="26" Height="24" Padding="0" Margin="7,0,0,0"/>
    </StackPanel>
  </Border>
</Window>
