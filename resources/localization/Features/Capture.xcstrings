    "scrolling-capture-status.no-savable-result-ready": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ShotPaste konnte ein speicherbares zusammengefügtes Bild noch nicht sperren. Sie können mit der Aufnahme fortfahren, es erneut mit „Fertig“ versuchen oder abbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
