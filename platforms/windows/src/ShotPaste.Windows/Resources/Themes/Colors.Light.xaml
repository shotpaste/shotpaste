<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WindowColor">#FFF7F7FA</Color>
  <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
  <Color x:Key="SurfaceSecondaryColor">#FFF1F1F5</Color>
  <Color x:Key="TextColor">#FF19191D</Color>
  <Color x:Key="SecondaryTextColor">#FF71717A</Color>
  <Color x:Key="ShadowColor">#FF000000</Color>

  <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
  <SolidColorBrush x:Key="HistoryHudBrush" Color="{StaticResource WindowColor}" Opacity="0.92" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondaryColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="#1F000000" />
  <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource TextColor}" Opacity="0.10" />
  <SolidColorBrush x:Key="PressedBackgroundBrush" Color="{StaticResource TextColor}" Opacity="0.15" />
  <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="{StaticResource TextColor}" Opacity="0.05" />

  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="ControlBackgroundHoverBrush" Color="#FFF8F8FA" />
  <SolidColorBrush x:Key="ControlBackgroundPressedBrush" Color="#FFEFEFF4" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#2A000000" />
  <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#52000000" />
  <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="PopupBorderBrush" Color="#24000000" />
  <SolidColorBrush x:Key="WindowBackdropBrush" Color="#E6F7F7FA" />
  <SolidColorBrush x:Key="TitleBarBrush" Color="#B8FFFFFF" />
  <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#3D000000" />
  <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#45000000" />
  <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#73000000" />
  <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#1A000000" />
  <SolidColorBrush x:Key="DialogOverlayBrush" Color="#18000000" />
  <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#ECFFFFFF" />
</ResourceDictionary>
