<Window x:Class="ShotPaste.Windows.Views.KeystrokeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="60" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" IsHitTestVisible="False"
        AutomationProperties.AutomationId="KeystrokeEffectPreview">
  <Border x:Name="GesturePanel" Background="#D91C1C1E" CornerRadius="13" Padding="20,11" Opacity="0">
    <TextBlock x:Name="GestureText" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
  </Border>
</Window>
