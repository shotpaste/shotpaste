    "recording.trash-failed-preserved": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die Aufnahme konnte nicht in den Papierkorb verschoben werden. Sie wurde unter %@ beibehalten." } },
        "en": { "stringUnit": { "state": "translated", "value": "The recording couldn’t be moved to Trash. It was kept at %@." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se pudo mover la grabación a la Papelera. Se conservó en %@." } },
        "fr": { "stringUnit": { "state": "translated", "value": "L’enregistrement n’a pas pu être placé dans la corbeille. Il a été conservé dans %@." } },
        "ja": { "stringUnit": { "state": "translated", "value": "収録をゴミ箱に移動できませんでした。%@ に保持されています。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "녹화를 휴지통으로 이동하지 못했습니다. %@에 보관했습니다." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось переместить запись в Корзину. Файл сохранён по адресу %@." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Không thể chuyển bản ghi vào Thùng rác. Tệp được giữ tại %@." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法将录制移到废纸篓，文件已保留在 %@。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法將錄製移到垃圾桶，檔案已保留在 %@。" } }
      }
    },
    "recording.quit-confirmation-message": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Stoppe und speichere die Aufnahme vor dem Beenden oder verschiebe die aktuelle Aufnahme in den Papierkorb." } },
        "en": { "stringUnit": { "state": "translated", "value": "Stop and save the recording before quitting, or move the current recording to Trash." } },
        "es": { "stringUnit": { "state": "translated", "value": "Detén y guarda la grabación antes de salir, o mueve la grabación actual a la Papelera." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Arrêtez et enregistrez la capture avant de quitter, ou placez l’enregistrement en cours dans la corbeille." } },
        "ja": { "stringUnit": { "state": "translated", "value": "終了前に収録を停止して保存するか、現在の収録をゴミ箱に移動してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "종료하기 전에 녹화를 중지하고 저장하거나 현재 녹화를 휴지통으로 이동하세요." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Перед выходом остановите и сохраните запись либо переместите текущую запись в Корзину." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Dừng và lưu bản ghi trước khi thoát, hoặc chuyển bản ghi hiện tại vào Thùng rác." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "退出前停止并保存录制，或将当前录制移到废纸篓。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "結束前停止並儲存錄製，或將目前錄製移到垃圾桶。" } }
      }
    },
    "recording.quit-confirmation-title": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Aufnahme läuft" } },
