    "permission.save-folder-description": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht ShotPaste, Screenshots und Aufnahmen im ausgewählten Ordner zu speichern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets ShotPaste save screenshots and recordings to your chosen folder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que ShotPaste guarde capturas y grabaciones en la carpeta elegida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à ShotPaste d’enregistrer les captures et les enregistrements dans le dossier choisi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したフォルダーにスクリーンショットと録画を保存します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 폴더에 스크린샷과 녹화를 저장합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет ShotPaste сохранять снимки и записи в выбранную папку"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép ShotPaste lưu ảnh chụp và bản ghi vào thư mục bạn chọn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 ShotPaste 将截图和录屏保存到你选择的文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 ShotPaste 將截圖和錄屏儲存到你選擇的檔案夾"
          }
        }
      }
    },
