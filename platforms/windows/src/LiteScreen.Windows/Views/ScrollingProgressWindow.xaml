<Window x:Class="LiteScreen.Windows.Views.ScrollingProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lite Screen · 滚动截屏" Width="270" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        WindowStartupLocation="Manual" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False" Topmost="True">
  <Border CornerRadius="16" Background="#F21C1C22" BorderBrush="#35FFFFFF" BorderThickness="1" Padding="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition x:Name="PreviewRow" Height="300"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="滚动截屏" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock x:Name="ProgressText" Text="正在锁定首帧…" Foreground="#BFFFFFFF" Margin="0,3,0,0" FontSize="11"/>
        </StackPanel>
        <Border Grid.Column="1" CornerRadius="7" Background="#274CD964" Padding="7,3" VerticalAlignment="Top">
          <TextBlock x:Name="TruthBadge" Text="已捕获" Foreground="#FF70E58A" FontSize="10" FontWeight="SemiBold"/>
        </Border>
      </Grid>

      <Border Grid.Row="1" Margin="0,10,0,8" CornerRadius="11" Background="#74000000" ClipToBounds="True">
        <Grid>
          <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock x:Name="PreviewPlaceholder" Text="滚动后将在这里实时预览长图" Foreground="#80FFFFFF"
                     FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28"/>
        </Grid>
      </Border>

      <TextBlock x:Name="GuidanceText" Grid.Row="2" Text="把鼠标放回选区，可向上补齐顶部或向下继续滚动；停下不会结束。"
                 Foreground="#CFFFFFFF" FontSize="11" TextWrapping="Wrap" Margin="1,0,1,10"/>

      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="FooterHint" Text="换向前稍作停顿，保持平稳滚动" Foreground="#80FFFFFF" FontSize="10" VerticalAlignment="Center"/>
        <Button x:Name="CancelButton" Grid.Column="1" Content="取消" Margin="8,0,0,0" Padding="14,5"
                Style="{StaticResource HudTextButton}" Click="OnCancel"/>
        <Button x:Name="AutoScrollButton" Grid.Column="2" Content="自动滚动" Margin="8,0,0,0" Padding="10,5"
                Visibility="Collapsed" IsEnabled="False" Style="{StaticResource HudTextButton}" Click="OnAutoScroll"/>
        <Button x:Name="PrimaryButton" Grid.Column="3" Content="开始截取" Margin="8,0,0,0" Padding="16,5"
                Style="{StaticResource AccentButton}" Click="OnPrimary"/>
      </Grid>
    </Grid>
  </Border>
</Window>
