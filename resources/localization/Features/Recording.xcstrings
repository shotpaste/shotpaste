    "audio-recording.automatic-ai": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatische KI-Verarbeitung"}},"en":{"stringUnit":{"state":"translated","value":"Automatic AI processing"}},"es":{"stringUnit":{"state":"translated","value":"Procesamiento de IA automático"}},"fr":{"stringUnit":{"state":"translated","value":"Traitement IA automatique"}},"ja":{"stringUnit":{"state":"translated","value":"AI処理（自動）"}},"ko":{"stringUnit":{"state":"translated","value":"자동 AI 처리"}},"ru":{"stringUnit":{"state":"translated","value":"Автоматическая обработка ИИ"}},"vi":{"stringUnit":{"state":"translated","value":"Xử lý AI tự động"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动 AI 处理"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自動 AI 處理"}}}},
    "audio-recording.automatic-transcription": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatische Transkription"}},"en":{"stringUnit":{"state":"translated","value":"Automatic transcription"}},"es":{"stringUnit":{"state":"translated","value":"Transcripción automática"}},"fr":{"stringUnit":{"state":"translated","value":"Transcription automatique"}},"ja":{"stringUnit":{"state":"translated","value":"自動文字起こし"}},"ko":{"stringUnit":{"state":"translated","value":"자동 받아쓰기"}},"ru":{"stringUnit":{"state":"translated","value":"Автоматическая расшифровка"}},"vi":{"stringUnit":{"state":"translated","value":"Chép lời tự động"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动转写"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自動轉錄"}}}},
    "audio-recording.completed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audioaufnahme abgeschlossen"}},"en":{"stringUnit":{"state":"translated","value":"Audio recording complete"}},"es":{"stringUnit":{"state":"translated","value":"Grabación de audio completada"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrement audio terminé"}},"ja":{"stringUnit":{"state":"translated","value":"音声録音が完了しました"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음 완료"}},"ru":{"stringUnit":{"state":"translated","value":"Аудиозапись завершена"}},"vi":{"stringUnit":{"state":"translated","value":"Đã hoàn tất bản ghi âm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"录音已完成"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"錄音已完成"}}}},
    "audio-recording.delete": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Löschen"}},"en":{"stringUnit":{"state":"translated","value":"Delete"}},"es":{"stringUnit":{"state":"translated","value":"Eliminar"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer"}},"ja":{"stringUnit":{"state":"translated","value":"削除"}},"ko":{"stringUnit":{"state":"translated","value":"삭제"}},"ru":{"stringUnit":{"state":"translated","value":"Удалить"}},"vi":{"stringUnit":{"state":"translated","value":"Xóa"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"刪除"}}}},
    "audio-recording.delete-confirmation-message": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die aktuelle Audioaufnahme wird in den Papierkorb verschoben. Dies kann in ShotPaste nicht rückgängig gemacht werden."}},"en":{"stringUnit":{"state":"translated","value":"The current audio recording will be moved to Trash. This cannot be undone in ShotPaste."}},"es":{"stringUnit":{"state":"translated","value":"La grabación de audio actual se moverá a la Papelera. Esto no se puede deshacer en ShotPaste."}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement audio actuel sera déplacé vers la corbeille. Cette action est irréversible dans ShotPaste."}},"ja":{"stringUnit":{"state":"translated","value":"現在の音声録音をゴミ箱に移動します。この操作はShotPasteでは取り消せません。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 오디오 녹음을 휴지통으로 이동합니다. ShotPaste에서는 이 작업을 취소할 수 없습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Текущая аудиозапись будет перемещена в Корзину. Это действие нельзя отменить в ShotPaste."}},"vi":{"stringUnit":{"state":"translated","value":"Bản ghi âm hiện tại sẽ được chuyển vào Thùng rác. Không thể hoàn tác trong ShotPaste."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前录音将移到废纸篓。此操作无法在 ShotPaste 中撤销。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前錄音將移到垃圾桶。此操作無法在 ShotPaste 中還原。"}}}},
    "audio-recording.delete-confirmation-title": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audioaufnahme löschen?"}},"en":{"stringUnit":{"state":"translated","value":"Delete Audio Recording?"}},"es":{"stringUnit":{"state":"translated","value":"¿Eliminar grabación de audio?"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer l’enregistrement audio ?"}},"ja":{"stringUnit":{"state":"translated","value":"音声録音を削除しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음을 삭제할까요?"}},"ru":{"stringUnit":{"state":"translated","value":"Удалить аудиозапись?"}},"vi":{"stringUnit":{"state":"translated","value":"Xóa bản ghi âm?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除录音？"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"刪除錄音？"}}}},
    "audio-recording.ended-early-saved": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Audioaufnahme wurde vorzeitig beendet und gespeichert."}},"en":{"stringUnit":{"state":"translated","value":"Audio recording ended early and was saved."}},"es":{"stringUnit":{"state":"translated","value":"La grabación de audio terminó antes de tiempo y se guardó."}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement audio s’est terminé prématurément et a été enregistré."}},"ja":{"stringUnit":{"state":"translated","value":"音声録音は途中で終了しましたが、保存されました。"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음이 일찍 종료되었지만 저장되었습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Аудиозапись завершена раньше времени и сохранена."}},"vi":{"stringUnit":{"state":"translated","value":"Bản ghi âm kết thúc sớm nhưng đã được lưu."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"录音提前结束，但已保存。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"錄音提前結束，但已儲存。"}}}},
    "audio-recording.extraction-recoverable": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Audioaufnahme muss wiederhergestellt werden. Sie können das Speichern erneut versuchen."}},"en":{"stringUnit":{"state":"translated","value":"Audio recording needs recovery. You can retry saving it."}},"es":{"stringUnit":{"state":"translated","value":"La grabación de audio necesita recuperación. Puede intentar guardarla de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement audio doit être récupéré. Vous pouvez réessayer de l’enregistrer."}},"ja":{"stringUnit":{"state":"translated","value":"音声録音を復旧する必要があります。保存を再試行できます。"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음을 복구해야 합니다. 저장을 다시 시도할 수 있습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Для аудиозаписи требуется восстановление. Сохранение можно повторить."}},"vi":{"stringUnit":{"state":"translated","value":"Cần khôi phục bản ghi âm. Bạn có thể thử lưu lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"录音需要恢复。你可以重试保存。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"錄音需要復原。你可以重試儲存。"}}}},
    "audio-recording.failed-title": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audioaufnahme fehlgeschlagen"}},"en":{"stringUnit":{"state":"translated","value":"Audio Recording Failed"}},"es":{"stringUnit":{"state":"translated","value":"Grabación de audio fallida"}},"fr":{"stringUnit":{"state":"translated","value":"Échec de l’enregistrement audio"}},"ja":{"stringUnit":{"state":"translated","value":"音声録音に失敗しました"}},"ko":{"stringUnit":{"state":"translated","value":"오디오 녹음 실패"}},"ru":{"stringUnit":{"state":"translated","value":"Сбой аудиозаписи"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể ghi âm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"录音失败"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"錄音失敗"}}}},
    "audio-recording.microphone": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofon"}},"en":{"stringUnit":{"state":"translated","value":"Microphone"}},"es":{"stringUnit":{"state":"translated","value":"Micrófono"}},"fr":{"stringUnit":{"state":"translated","value":"Microphone"}},"ja":{"stringUnit":{"state":"translated","value":"マイク"}},"ko":{"stringUnit":{"state":"translated","value":"마이크"}},"ru":{"stringUnit":{"state":"translated","value":"Микрофон"}},"vi":{"stringUnit":{"state":"translated","value":"Micrô"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"麦克风"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"麥克風"}}}},
