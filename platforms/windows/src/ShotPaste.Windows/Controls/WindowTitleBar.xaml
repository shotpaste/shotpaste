<UserControl x:Class="ShotPaste.Windows.Controls.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ShotPaste.Windows.Controls"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="{DynamicResource Window.TitleBarHeight}"
             MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource HudIconButton}">
      <Setter Property="Width" Value="{DynamicResource Window.CaptionButtonWidth}"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource DangerBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/></Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid Background="{DynamicResource TitleBarBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Margin="14,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False">
      <Image Source="../Assets/shotpaste-icon.png" Width="18" Height="18" Margin="0,0,9,0"/>
      <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                 Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource FontSize.Body}"
                 FontWeight="{DynamicResource FontWeight.SectionHeader}" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
      <Button Content="{StaticResource Icon.Minimize}" ContentTemplate="{StaticResource Icon.Template}" Style="{StaticResource CaptionButton}"
              Visibility="{Binding ShowMinimize, RelativeSource={RelativeSource AncestorType={x:Type local:WindowTitleBar}}, Converter={StaticResource BooleanToVisibility}}"
              Click="OnMinimize" ToolTip="最小化"/>
      <Button x:Name="MaximizeButton" Content="{StaticResource Icon.Maximize}" ContentTemplate="{StaticResource Icon.Template}" Style="{StaticResource CaptionButton}"
              Visibility="{Binding ShowMaximize, RelativeSource={RelativeSource AncestorType={x:Type local:WindowTitleBar}}, Converter={StaticResource BooleanToVisibility}}"
              Click="OnMaximize" ToolTip="最大化"/>
      <Button Content="{StaticResource Icon.Close}" ContentTemplate="{StaticResource Icon.Template}" Style="{StaticResource CloseCaptionButton}"
              Visibility="{Binding ShowClose, RelativeSource={RelativeSource AncestorType={x:Type local:WindowTitleBar}}, Converter={StaticResource BooleanToVisibility}}"
              Click="OnClose" ToolTip="关闭"/>
    </StackPanel>
  </Grid>
</UserControl>
