    "preferences-shortcuts.disable-shortcuts-message": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können Screenshots oder Aufnahmen nicht per Tastaturkürzel aus einer App heraus erfassen. Sie müssen ShotPaste manuell öffnen, um die Aufnahmefunktionen zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won't be able to capture screenshots or recordings using keyboard shortcuts from any app. You'll need to open ShotPaste manually to use capture features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podrás realizar capturas de pantalla ni grabaciones utilizando atajos de teclado desde ninguna aplicación. Deberá abrir ShotPaste manualmente para utilizar las funciones de captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pourrez pas capturer de captures d'écran ou d'enregistrements à l'aide des raccourcis clavier d'une application. Vous devrez ouvrir ShotPaste manuellement pour utiliser les fonctionnalités de capture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリからでも、キーボード ショートカットを使用してスクリーンショットや録音をキャプチャすることはできません。キャプチャ機能を使用するには、ShotPaste を手動で開く必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 앱에서도 키보드 단축키를 사용하여 스크린샷이나 녹음을 캡처할 수 없습니다. 캡처 기능을 사용하려면 ShotPaste를 수동으로 열어야 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не сможете делать снимки экрана или записи с помощью сочетаний клавиш ни в одном приложении. Вам нужно будет открыть ShotPaste вручную, чтобы использовать функции захвата."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ không thể dùng phím tắt để chụp ảnh hoặc ghi màn hình từ bất kỳ ứng dụng nào. Bạn sẽ cần mở ShotPaste thủ công để dùng các tính năng chụp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，你将无法在任何应用中使用键盘快捷键截屏或进行屏幕录制，需要手动打开 ShotPaste 才能使用相关功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，你將無法在任何應用程式中使用鍵盤快速鍵來截圖或進行螢幕錄製；必須手動開啟 ShotPaste 才能使用這些功能。"
          }
        }
      }
    },
    "preferences-shortcuts.disable-shortcuts-title": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturkürzel deaktivieren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable Keyboard Shortcuts?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Desactivar los atajos de teclado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver les raccourcis clavier ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードショートカットを無効にしますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 단축키를 비활성화하시겠습니까?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить сочетания клавиш?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt phím tắt bàn phím?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用键盘快捷键？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用鍵盤快捷鍵？"
          }
        }
      }
    },
