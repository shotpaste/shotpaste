    "recording.transcription.privacy-description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, wird Audio zur Transkription an Volcengine gesendet; Videobilder bleiben lokal. Die KI-Verarbeitung sendet Transkripttext an die konfigurierte Agent-API."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, recorded audio is sent to Volcengine for transcription; video frames stay on your device. AI processing sends transcript text to the configured Agent API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activarla, el audio se envía a Volcengine; las imágenes de vídeo permanecen en el dispositivo. El procesamiento con IA envía el texto a la API del Agent configurada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activée, la transcription envoie l’audio à Volcengine ; les images restent sur l’appareil. Le traitement IA envoie le texte à l’API Agent configurée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると音声がVolcengineに送信されます。映像は端末に保持されます。AI処理では文字起こしが設定済みのAgent APIに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 오디오가 Volcengine으로 전송되며 영상은 기기에 남습니다. AI 처리 시 텍스트가 설정된 Agent API로 전송됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включении аудио передаётся в Volcengine; видеокадры остаются на устройстве. Обработка ИИ отправляет текст в настроенный API Agent."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, âm thanh được gửi tới Volcengine; khung hình vẫn ở thiết bị. Xử lý AI gửi văn bản tới API Agent đã cấu hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后将录制的音频发送至火山引擎转写，视频画面保留在本机。智能处理会将文字稿发送至配置的 Agent API。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後將錄製的音訊傳送至火山引擎轉寫，影片畫面保留在本機。智慧處理會將文字稿傳送至配置的 Agent API。"
          }
        }
      }
    },
    "recording.transcription.credential-save-failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the API Key securely. Check the credential and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der API-Schlüssel konnte nicht sicher gespeichert werden. Prüfen Sie die Anmeldedaten und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la clave de API de forma segura. Revisa la credencial e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la clé API de manière sécurisée. Vérifiez l’identifiant et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key を安全に保存できませんでした。認証情報を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키를 안전하게 저장할 수 없습니다. 자격 증명을 확인하고 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось безопасно сохранить ключ API. Проверьте учетные данные и повторите попытку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu khóa API an toàn. Hãy kiểm tra thông tin xác thực rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全保存 API Key，请检查凭证后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全儲存 API Key，請檢查憑證後再試一次。"
          }
        }
      }
    },
