<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="ShotPasteCheckBox" TargetType="{x:Type CheckBox}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Control.BorderThickness}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Margin" Value="0,5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="{DynamicResource CheckBox.FocusSize}"
                  Height="{DynamicResource CheckBox.FocusSize}"
                  VerticalAlignment="Center">
              <Border x:Name="FocusRing"
                      Background="Transparent"
                      BorderBrush="{DynamicResource FocusRingBrush}"
                      BorderThickness="2"
                      CornerRadius="{DynamicResource Radius.Sm}"
                      Opacity="0" />
              <Border x:Name="Box"
                      Width="{DynamicResource CheckBox.GlyphSize}"
                      Height="{DynamicResource CheckBox.GlyphSize}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource Radius.Xs}" />
              <Path x:Name="CheckMark"
                    Width="9"
                    Height="7"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M 0.8,3.4 L 3.2,5.8 L 8.2,0.8"
                    Stroke="{DynamicResource AccentForegroundBrush}"
                    StrokeThickness="1.8"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Visibility="Collapsed" />
              <Border x:Name="IndeterminateMark"
                      Width="8"
                      Height="2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="{DynamicResource AccentForegroundBrush}"
                      CornerRadius="1"
                      Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Grid.Column="1"
                              Margin="{DynamicResource CheckBox.ContentMargin}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlBackgroundHoverBrush}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlBackgroundPressedBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.42" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource ShotPasteCheckBox}" />

  <Style x:Key="HudCheckBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource ShotPasteCheckBox}">
    <Setter Property="Foreground" Value="{DynamicResource HudTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource HudInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HudBorderBrush}" />
  </Style>
</ResourceDictionary>
