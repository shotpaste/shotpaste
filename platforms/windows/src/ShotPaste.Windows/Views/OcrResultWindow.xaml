<Window x:Class="ShotPaste.Windows.Views.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotPaste · OCR 与二维码" Width="440" SizeToContent="Height" MaxHeight="360"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowActivated="False" ShowInTaskbar="False" Focusable="True"
        AutomationProperties.AutomationId="OcrResultCard">
  <Border x:Name="ResultLiveRegion" Background="{DynamicResource HudBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1"
          CornerRadius="{DynamicResource Radius.Card}" Padding="14" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave"
          AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="OCR 结果已复制">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel>
        <Border Width="30" Height="30" CornerRadius="{DynamicResource Radius.Pill}" Background="{DynamicResource SuccessSoftBrush}" Margin="0,0,10,0">
          <ContentControl Content="{StaticResource Icon.Ocr}" ContentTemplate="{StaticResource Icon.Template}" Foreground="{DynamicResource SuccessBrush}" Width="16" Height="16"/>
        </Border>
        <StackPanel>
          <TextBlock Text="识别结果已复制" Foreground="{DynamicResource HudTextBrush}" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock Text="10 秒后自动关闭 · 悬停暂停" Foreground="{DynamicResource HudSecondaryTextBrush}" FontSize="10" Margin="0,2,0,0"/>
        </StackPanel>
        <Button DockPanel.Dock="Right" Content="{StaticResource Icon.Close}" ContentTemplate="{StaticResource Icon.Template}"
                Style="{StaticResource HudIconButton}" Width="26" Height="26" Padding="0" Click="OnClose"
                AutomationProperties.AutomationId="OcrResultClose" AutomationProperties.Name="关闭 OCR 卡片"/>
      </DockPanel>
      <Border Grid.Row="1" Background="{DynamicResource HudInputBrush}" BorderBrush="{DynamicResource HudBorderBrush}"
              BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}" MaxHeight="78" Margin="0,10,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="9,7">
          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource HudTextBrush}"
                     AutomationProperties.AutomationId="OcrResultText"/>
        </ScrollViewer>
      </Border>
      <ItemsControl Grid.Row="2" ItemsSource="{Binding Links}" Margin="0,8,0,0" MaxHeight="110">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding}" Tag="{Binding}" Click="OnOpenLink" HorizontalContentAlignment="Left"
                    Style="{StaticResource HudTextButton}" Margin="0,0,0,4" Padding="9,5" ToolTip="在默认应用中打开"
                    AutomationProperties.AutomationId="OcrResultLink" AutomationProperties.Name="{Binding}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Grid.Row="3" Content="再次复制全部" Click="OnCopy" Style="{StaticResource HudTextButton}"
              HorizontalAlignment="Right" Margin="0,8,0,0" Padding="10,5"
              AutomationProperties.AutomationId="OcrResultCopy" AutomationProperties.Name="再次复制全部识别结果"/>
    </Grid>
  </Border>
</Window>
