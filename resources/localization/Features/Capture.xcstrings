    "preferences-capture.hover-bar-visible-description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuerelemente während der Aufnahme auf dem Bildschirm anzeigen. Wenn ausgeblendet, das Menüleistensymbol zum Stoppen verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display controls on screen during recording. When hidden, use the menu bar icon to stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los controles en pantalla durante la grabación. Si se ocultan, usa el icono de la barra de menús para detener."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les contrôles à l'écran pendant l'enregistrement. Si masqués, utiliser l'icône de la barre des menus pour arrêter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画中にコントロールを画面に表示します。非表示の場合はメニューバーのアイコンから停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화 중 화면에 컨트롤을 표시합니다. 숨겨진 경우 메뉴 막대 아이콘을 사용하여 중지합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать элементы управления на экране во время записи. Если они скрыты, используйте значок в строке меню для остановки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các nút điều khiển trên màn hình khi ghi. Khi ẩn, sử dụng biểu tượng trên thanh menu để dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制时在屏幕上显示控件。隐藏时，可使用菜单栏图标停止录制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製時在螢幕上顯示控制項。隱藏時，可使用選單列圖示停止錄製。"
          }
        }
      }
    },
