  <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#FFFBFCFF" />
  <Color x:Key="AccentColor">#FF3478F6</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB" />
  <SolidColorBrush x:Key="AccentSoftForegroundBrush" Color="#FF2563EB" />
