    "recording.transcription.error-audio-too-long": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volcengine simultaneous interpretation supports recordings up to two hours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Volcengine-Simultandolmetschen unterstützt Aufnahmen bis zu zwei Stunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La interpretación simultánea de Volcengine admite grabaciones de hasta dos horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interprétation simultanée Volcengine prend en charge les enregistrements de deux heures maximum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Volcengine の同時通訳は 2 時間以内の録音に対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Volcengine 동시통역은 최대 2시간 길이의 녹음을 지원합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронный перевод Volcengine поддерживает записи длительностью до двух часов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên dịch đồng thời của Volcengine hỗ trợ bản ghi dài tối đa hai giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "火山引擎同声传译仅支持两小时以内的录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "火山引擎同聲傳譯僅支援兩小時以內的錄音。"
          }
        }
      }
    },
    "recording.transcription.error-audio-decode": {
      "localizations": {
        "en": {
