<Window x:Class="LiteScreen.Windows.Views.InlineAnnotateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="InlineAnnotateWindow" Title="Lite Screen · One Shot" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Cursor="Cross"
        PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp"
        MouseLeftButtonDown="OnWindowMouseDown" MouseMove="OnWindowMouseMove" MouseLeftButtonUp="OnWindowMouseUp">
  <Window.Resources>
    <Style x:Key="OneShotTabButton" TargetType="Button">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Foreground" Value="{DynamicResource HudTextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="11" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.64"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="InlinePropertyOptionButton" TargetType="Button" BasedOn="{StaticResource HudIconButton}">
      <Setter Property="Width" Value="25"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="7" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HudHoverBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="InlineColorSwatchButton" TargetType="Button">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="MinHeight" Value="20"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource HudTextBrush}"/>
      <Setter Property="BorderBrush" Value="#52FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.62"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="Root">
    <Image x:Name="BackdropImage" Stretch="Fill" IsHitTestVisible="False"
           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
    <Canvas x:Name="DimCanvas" IsHitTestVisible="False">
      <Rectangle x:Name="DimTop" Fill="#6B000000"/>
      <Rectangle x:Name="DimLeft" Fill="#6B000000"/>
      <Rectangle x:Name="DimRight" Fill="#6B000000"/>
      <Rectangle x:Name="DimBottom" Fill="#6B000000"/>
    </Canvas>

    <Canvas x:Name="OverlayCanvas">
      <Grid x:Name="SelectionHost" Visibility="Collapsed" Background="Transparent" ClipToBounds="False"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Viewbox x:Name="EditorViewbox" Stretch="Fill" ClipToBounds="True" SnapsToDevicePixels="True">
          <Grid x:Name="EditorSurface">
            <Image x:Name="SelectionImage" Stretch="Fill" IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
            <Canvas x:Name="AnnotationCanvas" Background="Transparent" ClipToBounds="True"
                    PreviewMouseLeftButtonDown="OnCanvasPreviewMouseDown" MouseLeftButtonDown="OnCanvasMouseDown"
                    MouseMove="OnCanvasMouseMove" MouseLeftButtonUp="OnCanvasMouseUp"/>
          </Grid>
        </Viewbox>
        <!-- Selection chrome stays outside the Viewbox: handles remain a constant screen size and are never exported. -->
        <Canvas x:Name="ElementSelectionChrome" Visibility="Collapsed" ClipToBounds="False"
                MouseMove="OnElementSelectionMouseMove" MouseLeftButtonUp="OnElementSelectionMouseUp">
          <Rectangle x:Name="ElementMoveHitTarget" Visibility="Collapsed" Fill="#01000000" Cursor="SizeAll"
                     MouseLeftButtonDown="OnElementMoveMouseDown"/>
          <Rectangle x:Name="ElementSelectionBorder" Fill="#140A84FF" Stroke="#FF0A84FF" StrokeThickness="1.4"
                     StrokeDashArray="4,4" IsHitTestVisible="False"/>
          <Ellipse x:Name="ElementHandleTopLeft" Tag="TopLeft" Width="10" Height="10" Fill="White" Stroke="#FF0A84FF" StrokeThickness="2"
                   Cursor="SizeNWSE" MouseLeftButtonDown="OnElementResizeMouseDown"/>
          <Ellipse x:Name="ElementHandleTopRight" Tag="TopRight" Width="10" Height="10" Fill="White" Stroke="#FF0A84FF" StrokeThickness="2"
                   Cursor="SizeNESW" MouseLeftButtonDown="OnElementResizeMouseDown"/>
          <Ellipse x:Name="ElementHandleBottomRight" Tag="BottomRight" Width="10" Height="10" Fill="White" Stroke="#FF0A84FF" StrokeThickness="2"
                   Cursor="SizeNWSE" MouseLeftButtonDown="OnElementResizeMouseDown"/>
          <Ellipse x:Name="ElementHandleBottomLeft" Tag="BottomLeft" Width="10" Height="10" Fill="White" Stroke="#FF0A84FF" StrokeThickness="2"
                   Cursor="SizeNESW" MouseLeftButtonDown="OnElementResizeMouseDown"/>
          <Rectangle x:Name="SelectionMarquee" Visibility="Collapsed" Fill="#1F0A84FF" Stroke="#FF0A84FF" StrokeThickness="1.2"
                     StrokeDashArray="5,3" IsHitTestVisible="False"/>
        </Canvas>
        <!-- Keep the border out of the image layout so it cannot shrink/re-scale selected pixels. -->
        <Border BorderBrush="White" BorderThickness="1.4" IsHitTestVisible="False">
          <Border.Effect><DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="1" Opacity="0.72"/></Border.Effect>
        </Border>
        <Canvas x:Name="OneShotOcrOverlay" Visibility="Collapsed" Background="#01000000" Cursor="Cross"
                MouseLeftButtonDown="OnOneShotOcrMouseDown" MouseMove="OnOneShotOcrMouseMove" MouseLeftButtonUp="OnOneShotOcrMouseUp">
          <Rectangle x:Name="OcrDimTop" Fill="#80000000" IsHitTestVisible="False"/>
          <Rectangle x:Name="OcrDimLeft" Fill="#80000000" IsHitTestVisible="False"/>
          <Rectangle x:Name="OcrDimRight" Fill="#80000000" IsHitTestVisible="False"/>
          <Rectangle x:Name="OcrDimBottom" Fill="#80000000" IsHitTestVisible="False"/>
          <Rectangle x:Name="OcrSelectionMarquee" Visibility="Collapsed" Fill="Transparent" Stroke="White"
                     StrokeThickness="1.5" StrokeDashArray="5,3" IsHitTestVisible="False"/>
        </Canvas>
      </Grid>

      <Canvas x:Name="ResizeChrome" Visibility="Collapsed">
        <Path x:Name="VisualTopLeft" Width="16" Height="16" Data="M 16,1 L 1,1 L 1,16" Stroke="White" StrokeThickness="2.4" Stretch="None" IsHitTestVisible="False"/>
        <Rectangle x:Name="VisualTop" Width="22" Height="2.4" Fill="White" IsHitTestVisible="False"/>
        <Path x:Name="VisualTopRight" Width="16" Height="16" Data="M 0,1 L 15,1 L 15,16" Stroke="White" StrokeThickness="2.4" Stretch="None" IsHitTestVisible="False"/>
        <Rectangle x:Name="VisualRight" Width="2.4" Height="22" Fill="White" IsHitTestVisible="False"/>
        <Path x:Name="VisualBottomRight" Width="16" Height="16" Data="M 15,0 L 15,15 L 0,15" Stroke="White" StrokeThickness="2.4" Stretch="None" IsHitTestVisible="False"/>
        <Rectangle x:Name="VisualBottom" Width="22" Height="2.4" Fill="White" IsHitTestVisible="False"/>
        <Path x:Name="VisualBottomLeft" Width="16" Height="16" Data="M 1,0 L 1,15 L 16,15" Stroke="White" StrokeThickness="2.4" Stretch="None" IsHitTestVisible="False"/>
        <Rectangle x:Name="VisualLeft" Width="2.4" Height="22" Fill="White" IsHitTestVisible="False"/>
        <Rectangle x:Name="HandleTopLeft" Tag="TopLeft" Width="20" Height="20" Fill="Transparent" Cursor="SizeNWSE" MouseLeftButtonDown="OnResizeMouseDown"/>
        <Rectangle x:Name="HandleTop" Tag="Top" Width="30" Height="18" Fill="Transparent" Cursor="SizeNS" MouseLeftButtonDown="OnResizeMouseDown"/>
        <Rectangle x:Name="HandleTopRight" Tag="TopRight" Width="20" Height="20" Fill="Transparent" Cursor="SizeNESW" MouseLeftButtonDown="OnResizeMouseDown"/>
        <Rectangle x:Name="HandleRight" Tag="Right" Width="18" Height="30" Fill="Transparent" Cursor="SizeWE" MouseLeftButtonDown="OnResizeMouseDown"/>
        <Rectangle x:Name="HandleBottomRight" Tag="BottomRight" Width="20" Height="20" Fill="Transparent" Cursor="SizeNWSE" MouseLeftButtonDown="OnResizeMouseDown"/>
        <Rectangle x:Name="HandleBottom" Tag="Bottom" Width="30" Height="18" Fill="Transparent" Cursor="SizeNS" MouseLeftButtonDown="OnResizeMouseDown"/>
        <Rectangle x:Name="HandleBottomLeft" Tag="BottomLeft" Width="20" Height="20" Fill="Transparent" Cursor="SizeNESW" MouseLeftButtonDown="OnResizeMouseDown"/>
        <Rectangle x:Name="HandleLeft" Tag="Left" Width="18" Height="30" Fill="Transparent" Cursor="SizeWE" MouseLeftButtonDown="OnResizeMouseDown"/>
      </Canvas>

      <Border x:Name="Toolbar" Visibility="Collapsed" Height="46" CornerRadius="14" Background="{DynamicResource HudBrush}"
              BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="8,6">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.48"/></Border.Effect>
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ToolbarContent" Orientation="Horizontal">
            <Button x:Name="MoveButton" AutomationProperties.AutomationId="OneShotMoveToolbar" Style="{StaticResource HudTextButton}" ToolTip="移动选区（按住 Space）"
                    PreviewMouseLeftButtonDown="OnMoveMouseDown" MouseMove="OnToolbarMoveMouseMove" MouseLeftButtonUp="OnToolbarMoveMouseUp">
              <ContentControl x:Name="MoveIcon" Content="Move" ContentTemplate="{StaticResource AnnotationMoveIcon}" IsHitTestVisible="False"/>
            </Button>
            <Separator Margin="5,5" Background="#30FFFFFF"/>
            <Button Content="Selection" AutomationProperties.AutomationId="InlineToolSelection" ContentTemplate="{StaticResource AnnotationSelectionIcon}" Tag="Selection" Style="{StaticResource HudIconButton}" Click="OnSelectTool" ToolTip="选择"/>
            <Separator Margin="5,5" Background="#30FFFFFF"/>
            <Button Content="Rectangle" AutomationProperties.AutomationId="InlineToolRectangle" ContentTemplate="{StaticResource AnnotationRectangleIcon}" Tag="Rectangle" Style="{StaticResource HudIconButton}" Click="OnSelectTool" ToolTip="矩形"/>
            <Button Content="FilledRectangle" AutomationProperties.AutomationId="InlineToolFilledRectangle" ContentTemplate="{StaticResource AnnotationFilledRectangleIcon}" Tag="FilledRectangle" Style="{StaticResource HudIconButton}" Click="OnSelectTool" ToolTip="填充矩形"/>
            <Button Content="Oval" AutomationProperties.AutomationId="InlineToolOval" ContentTemplate="{StaticResource AnnotationOvalIcon}" Tag="Oval" Style="{StaticResource HudIconButton}" Click="OnSelectTool" ToolTip="椭圆形"/>
            <Button Content="Arrow" AutomationProperties.AutomationId="InlineToolArrow" ContentTemplate="{StaticResource AnnotationArrowIcon}" Tag="Arrow" Style="{StaticResource HudIconButton}" Click="OnSelectTool" ToolTip="箭头"/>
            <Button Content="Line" AutomationProperties.AutomationId="InlineToolLine" ContentTemplate="{StaticResource AnnotationLineIcon}" Tag="Line" Style="{StaticResource HudIconButton}" Click="OnSelectTool" ToolTip="直线"/>
            <Separator Margin="5,5" Background="#30FFFFFF"/>
            <Button Content="Text" AutomationProperties.AutomationId="InlineToolText" ContentTemplate="{StaticResource AnnotationTextIcon}" Tag="Text" Style="{StaticResource HudIconButton}" Click="OnSelectTool" ToolTip="文字"/>
            <Button Content="Highlighter" AutomationProperties.AutomationId="InlineToolHighlighter" ContentTemplate="{StaticResource AnnotationHighlighterIcon}" Tag="Highlighter" Style="{StaticResource HudIconButton}" Click="OnSelectTool" ToolTip="荧光笔"/>
            <Button Content="Blur" AutomationProperties.AutomationId="InlineToolBlur" ContentTemplate="{StaticResource AnnotationBlurIcon}" Tag="Blur" Style="{StaticResource HudIconButton}" Click="OnSelectTool" ToolTip="模糊"/>
            <Button Content="Spotlight" AutomationProperties.AutomationId="InlineToolSpotlight" ContentTemplate="{StaticResource AnnotationSpotlightIcon}" Tag="Spotlight" Style="{StaticResource HudIconButton}" Click="OnSelectTool" ToolTip="聚光灯"/>
            <Button Content="Counter" AutomationProperties.AutomationId="InlineToolCounter" ContentTemplate="{StaticResource AnnotationCounterIcon}" Tag="Counter" Style="{StaticResource HudIconButton}" Click="OnSelectTool" ToolTip="计数器"/>
            <Button Content="Pencil" AutomationProperties.AutomationId="InlineToolPencil" ContentTemplate="{StaticResource AnnotationPencilIcon}" Tag="Pencil" Style="{StaticResource HudIconButton}" Click="OnSelectTool" ToolTip="铅笔"/>
            <Separator Margin="5,5" Background="#30FFFFFF"/>
            <Button x:Name="UndoButton" AutomationProperties.AutomationId="InlineUndo" Content="Undo" ContentTemplate="{StaticResource AnnotationUndoIcon}" Style="{StaticResource HudIconButton}" Click="OnUndo" ToolTip="撤销"/>
            <Button x:Name="RedoButton" AutomationProperties.AutomationId="InlineRedo" Content="Redo" ContentTemplate="{StaticResource AnnotationRedoIcon}" Style="{StaticResource HudIconButton}" Click="OnRedo" ToolTip="重做"/>
            <StackPanel x:Name="OneShotToolbarActions" Visibility="Collapsed" Orientation="Horizontal">
              <Separator Margin="5,5" Background="#30FFFFFF"/>
              <Button Content="OCR" AutomationProperties.AutomationId="OneShotOcr" ContentTemplate="{StaticResource AnnotationOcrIcon}"
                      Style="{StaticResource HudIconButton}" Click="OnOneShotOcr" ToolTip="提取文字"/>
              <Separator Margin="5,5" Background="#30FFFFFF"/>
              <Button Content="Pin" AutomationProperties.AutomationId="OneShotPin" ContentTemplate="{StaticResource AnnotationPinIcon}"
                      Style="{StaticResource HudIconButton}" Click="OnPin" ToolTip="贴到屏幕"/>
              <Button Content="Copy" AutomationProperties.AutomationId="OneShotCopy" ContentTemplate="{StaticResource AnnotationCopyIcon}"
                      Style="{StaticResource HudIconButton}" Click="OnCopy" ToolTip="复制"/>
              <Button Content="Cancel" AutomationProperties.AutomationId="OneShotCancel" ContentTemplate="{StaticResource AnnotationCloseIcon}"
                      Style="{StaticResource HudIconButton}" Click="OnCancel" ToolTip="取消"/>
              <Button Content="Done" AutomationProperties.AutomationId="OneShotDone" ContentTemplate="{StaticResource AnnotationDoneIcon}"
                      Style="{StaticResource HudIconButton}" Tag="Selected" Click="OnDone" ToolTip="完成"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="PropertiesBar" Visibility="Collapsed" Height="38" CornerRadius="14" Background="{DynamicResource HudBrush}"
              BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="6,5">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="6" Opacity="0.4"/></Border.Effect>
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="PropertiesContent" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Height="24" CornerRadius="8" Background="#17FFFFFF" Padding="8,0" Margin="0,0,8,0" MaxWidth="142">
              <StackPanel Orientation="Horizontal"><TextBlock Text="工具" Foreground="{DynamicResource HudSecondaryTextBrush}" Margin="0,0,7,0"/><TextBlock x:Name="ContextPillText" AutomationProperties.AutomationId="ContextPillText" Text="选择" Foreground="{DynamicResource HudTextBrush}" FontWeight="SemiBold" FontSize="12"/></StackPanel>
            </Border>

            <StackPanel x:Name="StrokeColorGroup" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="StrokeColorLabel" Text="颜色" Foreground="{DynamicResource HudSecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <Button Tag="Stroke:#FFFF453A" Style="{StaticResource InlineColorSwatchButton}" Margin="0,0,5,0" Background="#FFFF453A" Click="OnColorSelected"/>
              <Button Tag="Stroke:#FFFF9F0A" Style="{StaticResource InlineColorSwatchButton}" Margin="0,0,5,0" Background="#FFFF9F0A" Click="OnColorSelected"/>
              <Button Tag="Stroke:#FFFFD60A" Style="{StaticResource InlineColorSwatchButton}" Margin="0,0,5,0" Background="#FFFFD60A" Click="OnColorSelected"/>
              <Button Tag="Stroke:#FF30D158" Style="{StaticResource InlineColorSwatchButton}" Margin="0,0,5,0" Background="#FF30D158" Click="OnColorSelected"/>
              <Button Tag="Stroke:#FF0A84FF" Style="{StaticResource InlineColorSwatchButton}" Margin="0,0,5,0" Background="#FF0A84FF" Click="OnColorSelected"/>
              <Button Tag="Stroke:#FFBF5AF2" Style="{StaticResource InlineColorSwatchButton}" Margin="0,0,5,0" Background="#FFBF5AF2" Click="OnColorSelected"/>
              <Button Tag="Stroke:#FFFFFFFF" Style="{StaticResource InlineColorSwatchButton}" Margin="0,0,5,0" Background="White" Click="OnColorSelected"/>
              <Button Tag="Stroke:#FF000000" Style="{StaticResource InlineColorSwatchButton}" Margin="0,0,8,0" Background="Black" Click="OnColorSelected"/>
            </StackPanel>

            <StackPanel x:Name="TextBackgroundGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="背景" Foreground="{DynamicResource HudSecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <Button Tag="TextBackground:Clear" Content="╱" Style="{StaticResource InlineColorSwatchButton}" Margin="0,0,5,0" Background="Transparent" Click="OnColorSelected"/>
              <Button Tag="TextBackground:#FFFFFFFF" Style="{StaticResource InlineColorSwatchButton}" Margin="0,0,5,0" Background="White" Click="OnColorSelected"/>
              <Button Tag="TextBackground:#FF000000" Style="{StaticResource InlineColorSwatchButton}" Margin="0,0,5,0" Background="Black" Click="OnColorSelected"/>
              <Button Tag="TextBackground:#FFFFD60A" Style="{StaticResource InlineColorSwatchButton}" Margin="0,0,5,0" Background="#FFFFD60A" Click="OnColorSelected"/>
              <Button Tag="TextBackground:#FF0A84FF" Style="{StaticResource InlineColorSwatchButton}" Margin="0,0,8,0" Background="#FF0A84FF" Click="OnColorSelected"/>
            </StackPanel>

            <StackPanel x:Name="BlurTypeGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="模糊" Foreground="{DynamicResource HudSecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <Button Tag="Blur:Pixelated" Content="▦" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected" ToolTip="像素化"/>
              <Button Tag="Blur:Gaussian" Content="◉" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected" ToolTip="高斯"/>
              <Button Tag="Blur:Hexagonal" Content="⬡" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected" ToolTip="六边形"/>
              <Button Tag="Blur:Crystallized" Content="✦" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected" ToolTip="结晶"/>
              <Button Tag="Blur:Pointillism" Content="⠇" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected" ToolTip="点彩"/>
              <Button Tag="Blur:Halftone" Content="▒" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected" ToolTip="半色调"/>
              <Button Tag="Blur:Tape" Content="▰" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected" ToolTip="胶带"/>
              <Button Tag="Blur:Washi" Content="▧" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected" ToolTip="和纸"/>
            </StackPanel>

            <StackPanel x:Name="ArrowStyleGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="样式" Foreground="{DynamicResource HudSecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <Button Tag="ArrowStyle:Straight" Content="↗" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected" ToolTip="直线"/>
              <Button Tag="ArrowStyle:CurvedRight" Content="↱" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected" ToolTip="右弯"/>
              <Button Tag="ArrowStyle:CurvedLeft" Content="↰" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected" ToolTip="左弯"/>
              <TextBlock Text="外观" Foreground="{DynamicResource HudSecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,7,0"/>
              <Button Tag="ArrowType:Classic" Content="→" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected" ToolTip="经典"/>
              <Button Tag="ArrowType:Tapered" Content="➤" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected" ToolTip="渐变"/>
              <Button Tag="ArrowType:Outlined" Content="⇢" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected" ToolTip="描边"/>
            </StackPanel>

            <StackPanel x:Name="ArrowBendGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="弯曲" Foreground="{DynamicResource HudSecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,7,0"/>
              <Button Tag="ArrowBend:Primary" Content="↷" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected"/>
              <Button Tag="ArrowBend:Alternate" Content="↶" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected"/>
            </StackPanel>

            <StackPanel x:Name="ArrowEndpointGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="起点" Foreground="{DynamicResource HudSecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,7,0"/>
              <Button Tag="StartHead:None" Content="—" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected"/>
              <Button Tag="StartHead:Arrow" Content="▶" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected"/>
              <Button Tag="StartHead:Circle" Content="●" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected"/>
              <TextBlock Text="终点" Foreground="{DynamicResource HudSecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,7,0"/>
              <Button Tag="EndHead:None" Content="—" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected"/>
              <Button Tag="EndHead:Arrow" Content="▶" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected"/>
              <Button Tag="EndHead:Circle" Content="●" Style="{StaticResource InlinePropertyOptionButton}" Click="OnPropertyOptionSelected"/>
            </StackPanel>

            <StackPanel x:Name="StrokeWidthGroup" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="StrokeWidthLabel" Text="描边" Foreground="{DynamicResource HudSecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,7,0"/>
              <TextBlock Text="╱" Foreground="{DynamicResource HudTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <Slider x:Name="StrokeSlider" Style="{StaticResource HudSlider}" Minimum="1" Maximum="20" Value="4" Width="58" ValueChanged="OnStrokeChanged"
                      PreviewMouseLeftButtonDown="OnPropertySliderStarted" PreviewMouseLeftButtonUp="OnPropertySliderCompleted"/>
              <TextBlock x:Name="StrokeValue" Text="4" Foreground="{DynamicResource HudTextBrush}" FontSize="10" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="FontSizeGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="字号" Foreground="{DynamicResource HudSecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,7,0"/>
              <Slider x:Name="FontSizeSlider" Style="{StaticResource HudSlider}" Minimum="12" Maximum="72" Value="20" Width="58" ValueChanged="OnFontSizeChanged"
                      PreviewMouseLeftButtonDown="OnPropertySliderStarted" PreviewMouseLeftButtonUp="OnPropertySliderCompleted"/>
              <TextBlock x:Name="FontSizeValue" Text="20" Foreground="{DynamicResource HudTextBrush}" FontSize="10" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="CornerRadiusGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="圆角" Foreground="{DynamicResource HudSecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,7,0"/>
              <Slider x:Name="CornerRadiusSlider" Style="{StaticResource HudSlider}" Minimum="0" Maximum="60" Value="0" Width="58" ValueChanged="OnCornerRadiusChanged"
                      PreviewMouseLeftButtonDown="OnPropertySliderStarted" PreviewMouseLeftButtonUp="OnPropertySliderCompleted"/>
              <TextBlock x:Name="CornerRadiusValue" Text="0" Foreground="{DynamicResource HudTextBrush}" FontSize="10" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="OneShotSwitcher" Visibility="Collapsed" Width="520" Height="56" CornerRadius="16"
              Background="{DynamicResource HudBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1"
              Padding="6" AutomationProperties.AutomationId="OneShotSwitcher">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="7" Opacity="0.45"/></Border.Effect>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Button x:Name="OneShotDragHandle" AutomationProperties.AutomationId="OneShotSwitcherDragHandle" Width="34" Height="44" Style="{StaticResource HudIconButton}"
                  Cursor="SizeWE" ToolTip="水平拖动以移动 One Shot"
                  PreviewMouseLeftButtonDown="OnOneShotDragMouseDown" MouseMove="OnOneShotDragMouseMove" MouseLeftButtonUp="OnOneShotDragMouseUp">
            <ContentControl Content="Drag" ContentTemplate="{StaticResource AnnotationToolbarDragIcon}" IsHitTestVisible="False"/>
          </Button>
          <Button x:Name="OneShotScreenshotButton" Grid.Column="1" Tag="Screenshot" Click="OnOneShotMode"
                  Style="{StaticResource OneShotTabButton}" AutomationProperties.AutomationId="OneShotScreenshot" Margin="2">
            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
              <ContentControl Content="Screenshot" ContentTemplate="{StaticResource OneShotScreenshotIcon}" Margin="0,0,6,0"/>
              <TextBlock Text="截图" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="OneShotScrollingButton" Grid.Column="2" Tag="Scrolling" Click="OnOneShotMode"
                  Style="{StaticResource OneShotTabButton}" AutomationProperties.AutomationId="OneShotScrolling" Margin="2">
            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
              <ContentControl Content="Scrolling" ContentTemplate="{StaticResource OneShotScrollingIcon}" Margin="0,0,6,0"/>
              <TextBlock Text="滚动截屏" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="OneShotRecordingButton" Grid.Column="3" Tag="Recording" Click="OnOneShotMode"
                  Style="{StaticResource OneShotTabButton}" AutomationProperties.AutomationId="OneShotRecording" Margin="2">
            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
              <ContentControl Content="Recording" ContentTemplate="{StaticResource OneShotRecordingIcon}" Margin="0,0,6,0"/>
              <TextBlock Text="录屏" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="OneShotClipboardButton" Grid.Column="4" Tag="Clipboard" Click="OnOneShotMode"
                  Style="{StaticResource OneShotTabButton}" AutomationProperties.AutomationId="OneShotClipboard" Margin="2">
            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
              <ContentControl Content="Clipboard" ContentTemplate="{StaticResource OneShotClipboardIcon}" Margin="0,0,6,0"/>
              <TextBlock Text="剪贴板历史" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Border x:Name="OneShotModePanel" Visibility="Collapsed" CornerRadius="14"
              Background="{DynamicResource HudBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="12">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="7" Opacity="0.42"/></Border.Effect>
        <Grid>
          <StackPanel x:Name="OneShotScrollingPanel" Visibility="Collapsed">
            <TextBlock x:Name="OneShotScrollingHelpText" Visibility="Collapsed" Width="330" TextWrapping="Wrap"
                       Foreground="{DynamicResource HudTextBrush}" Margin="3,0,3,10"
                       Text="保持内容位于选区内，开始截屏后纵向滚动，直到完整页面收集完成。"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Content="开始滚动截屏" Click="OnOneShotStartScrolling" Style="{StaticResource AccentButton}" Padding="15,7" Margin="0,0,8,0"
                      AutomationProperties.AutomationId="OneShotStartScrolling"/>
              <Button Content="帮助" Click="OnOneShotToggleScrollingHelp" Padding="12,7"
                      AutomationProperties.AutomationId="OneShotScrollingHelp"/>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="OneShotRecordingPanel" Visibility="Collapsed" VerticalAlignment="Center">
            <Button Content="开始录屏" Click="OnOneShotStartRecording" Style="{StaticResource AccentButton}" MinHeight="36" Padding="15,8" Margin="0,0,0,14"
                    AutomationProperties.AutomationId="OneShotStartRecording"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
              <TextBlock Text="格式" Foreground="{DynamicResource HudSecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <RadioButton x:Name="OneShotVideo" Content="MP4" GroupName="OneShotOutput" Checked="OnOneShotRecordingOptionChanged" Margin="0,0,14,0"
                           Foreground="{DynamicResource HudTextBrush}"/>
              <RadioButton x:Name="OneShotGif" Content="GIF" GroupName="OneShotOutput" Checked="OnOneShotRecordingOptionChanged"
                           Foreground="{DynamicResource HudTextBrush}"/>
            </StackPanel>
            <WrapPanel HorizontalAlignment="Center">
              <CheckBox x:Name="OneShotRecordingCursor" Content="鼠标指针" Click="OnOneShotRecordingOptionChanged" Margin="6,3"
                        Foreground="{DynamicResource HudTextBrush}"/>
              <CheckBox x:Name="OneShotSystemAudio" Content="系统声音" Click="OnOneShotRecordingOptionChanged" Margin="6,3"
                        Foreground="{DynamicResource HudTextBrush}"/>
              <CheckBox x:Name="OneShotMicrophone" Content="麦克风" Click="OnOneShotRecordingOptionChanged" Margin="6,3"
                        Foreground="{DynamicResource HudTextBrush}"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="InstructionBadge" CornerRadius="12" Background="{DynamicResource HudBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="14,8">
        <TextBlock x:Name="InstructionText" Foreground="{DynamicResource HudTextBrush}" Text="拖动选择区域  ·  Esc 取消" FontSize="12" FontWeight="SemiBold"/>
      </Border>
      <Border x:Name="SizeBadge" Visibility="Collapsed" CornerRadius="8" Background="{DynamicResource HudBrush}" Padding="9,5">
        <TextBlock x:Name="SizeText" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
      </Border>
      <Border x:Name="StatusBadge" Visibility="Collapsed" CornerRadius="9" Background="{DynamicResource HudBrush}"
              BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="11,7">
        <TextBlock x:Name="InlineStatusText" AutomationProperties.AutomationId="InlineStatusText"
                   Foreground="{DynamicResource HudTextBrush}" FontSize="12" FontWeight="SemiBold"/>
      </Border>
    </Canvas>
  </Grid>
</Window>
