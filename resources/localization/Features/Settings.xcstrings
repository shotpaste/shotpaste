{
  "sourceLanguage": "en",
  "strings": {
    "preferences-general.login-item-requires-approval-message": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Erlaube ShotPaste unter Systemeinstellungen → Allgemein → Anmeldeobjekte und kehre dann hierher zurück." } },
        "en": { "stringUnit": { "state": "translated", "value": "Allow ShotPaste in System Settings → General → Login Items, then return here." } },
        "es": { "stringUnit": { "state": "translated", "value": "Permite ShotPaste en Ajustes del Sistema → General → Ítems de inicio y vuelve aquí." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Autorisez ShotPaste dans Réglages Système → Général → Ouverture, puis revenez ici." } },
        "ja": { "stringUnit": { "state": "translated", "value": "「システム設定」→「一般」→「ログイン項目」で ShotPaste を許可してから、ここに戻ってください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "시스템 설정 → 일반 → 로그인 항목에서 ShotPaste를 허용한 다음 여기로 돌아오세요." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Разрешите ShotPaste в меню «Системные настройки» → «Основные» → «Объекты входа», затем вернитесь сюда." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Cho phép ShotPaste trong Cài đặt hệ thống → Cài đặt chung → Mục đăng nhập, rồi quay lại đây." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请在“系统设置 → 通用 → 登录项”中允许 ShotPaste，然后返回此处。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "請在「系統設定 → 一般 → 登入項目」中允許 ShotPaste，然後返回此處。" } }
      }
    },
    "preferences-general.login-item-requires-approval-title": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Genehmigung erforderlich" } },
        "en": { "stringUnit": { "state": "translated", "value": "Approval Required" } },
        "es": { "stringUnit": { "state": "translated", "value": "Se requiere aprobación" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Autorisation requise" } },
        "ja": { "stringUnit": { "state": "translated", "value": "承認が必要です" } },
        "ko": { "stringUnit": { "state": "translated", "value": "승인 필요" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Требуется разрешение" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Cần phê duyệt" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "需要批准" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "需要核准" } }
      }
    },
    "preferences-general.login-item-update-failed": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die Einstellung für das Anmeldeobjekt konnte nicht aktualisiert werden." } },
        "en": { "stringUnit": { "state": "translated", "value": "Could not update the login item setting." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se pudo actualizar el ajuste del ítem de inicio." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Impossible de mettre à jour le réglage d’ouverture de session." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ログイン項目の設定を更新できませんでした。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "로그인 항목 설정을 업데이트할 수 없습니다." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось изменить настройку объекта входа." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Không thể cập nhật cài đặt mục đăng nhập." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法更新登录项设置。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法更新登入項目設定。" } }
      }
    },
    "preferences-history.delete-failed": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "%d Aufnahme(n) konnten nicht gelöscht werden" } },
        "en": { "stringUnit": { "state": "translated", "value": "Could not delete %d capture item(s)" } },
        "es": { "stringUnit": { "state": "translated", "value": "No se pudieron eliminar %d captura(s)" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Impossible de supprimer %d capture(s)" } },
        "ja": { "stringUnit": { "state": "translated", "value": "%d 件のキャプチャを削除できませんでした" } },
        "ko": { "stringUnit": { "state": "translated", "value": "캡처 %d개를 삭제할 수 없습니다" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось удалить объектов: %d" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Không thể xoá %d mục đã chụp" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法删除 %d 个捕获项目" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法刪除 %d 個擷取項目" } }
      }
    },
