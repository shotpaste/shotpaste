<Window x:Class="ShotPaste.Windows.Views.PinnedImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" Height="320" MinWidth="180" MinHeight="120" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" MouseWheel="OnMouseWheel" MouseLeftButtonDown="OnMouseDown" KeyDown="OnKeyDown"
        AutomationProperties.AutomationId="PinnedImageWindow">
  <Border CornerRadius="9" Background="#DD111113" BorderBrush="#55FFFFFF" BorderThickness="1">
    <Grid>
      <Image x:Name="PinnedImage" Stretch="Uniform" Margin="4" />
      <StackPanel x:Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
        <Button x:Name="LockButton" AutomationProperties.AutomationId="PinnedLock" Content="锁定" Padding="7,3" MinHeight="24" Margin="0,0,5,0" Click="OnToggleLock" ToolTip="锁定后图片区域自动穿透；锁按钮保持可操作"/>
        <StackPanel x:Name="UnlockedControls" Orientation="Horizontal">
          <ComboBox x:Name="ZoomPicker" AutomationProperties.AutomationId="PinnedZoom" Width="70" Height="26" Margin="0,0,5,0"
                    IsEditable="True" IsReadOnly="True"
                    SelectedValuePath="Tag" SelectionChanged="OnZoomPresetChanged" ToolTip="贴图缩放">
            <ComboBoxItem Content="50%" Tag="0.5"/><ComboBoxItem Content="75%" Tag="0.75"/><ComboBoxItem Content="100%" Tag="1"/>
            <ComboBoxItem Content="125%" Tag="1.25"/><ComboBoxItem Content="150%" Tag="1.5"/><ComboBoxItem Content="200%" Tag="2"/>
          </ComboBox>
          <Button AutomationProperties.AutomationId="PinnedDrag" Content="拖出" Padding="8,3" MinHeight="24" Margin="0,0,5,0" PreviewMouseLeftButtonDown="OnDragOut"/>
          <Button AutomationProperties.AutomationId="PinnedCopy" Content="复制" Padding="8,3" MinHeight="24" Margin="0,0,5,0" Click="OnCopy" />
          <Button AutomationProperties.AutomationId="PinnedSave" Content="保存" Padding="8,3" MinHeight="24" Margin="0,0,5,0" Click="OnSave" />
          <Button AutomationProperties.AutomationId="PinnedClose" Content="×" Padding="8,3" MinHeight="24" Click="OnClose" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
