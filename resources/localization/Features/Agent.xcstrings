    "agent.activity.event.observed": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已观察屏幕"}}}},
    "agent.activity.event.paused": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"因用户输入暂停"}}}},
    "agent.activity.event.planned": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已规划下一动作"}}}},
    "agent.activity.event.resumed": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Agent 已继续"}}}},
    "agent.activity.event.started": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"任务已开始"}}}},
    "agent.activity.event.stopped": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"任务已停止"}}}},
    "agent.activity.event.user-answered": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已收到回答"}}}},
    "agent.activity.hide": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"隐藏 Agent 活动"}}}},
    "agent.activity.input-pause-hint": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"使用鼠标或键盘会暂停 Agent"}}}},
    "agent.activity.live": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"实时"}}}},
    "agent.activity.no-events": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"正在准备首次观察…"}}}},
    "agent.activity.observation-detail": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"%1$lld 个可访问元素 · %2$lld 行 OCR"}}}},
    "agent.activity.show": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"显示 Agent 活动"}}}},
    "agent.activity.stop": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"停止"}}}},
    "agent.activity.task": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"任务"}}}},
    "agent.activity.timeline": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"活动轨迹"}}}},
    "agent.activity.title": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Agent 活动"}}}},
    "agent.activity.waiting-task": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"等待任务…"}}}},
    "agent.api-key-description": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"直接存储在应用偏好设置中；界面仅显示脱敏值"}}}},
    "agent.api-key-title": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"LLM API Key"}}}},
    "agent.approve-once": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"仅允许一次"}}}},
    "agent.busy-message": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"另一个捕获、录屏或 Agent 会话正在进行"}}}},
    "agent.click-anywhere-prompt": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"点击希望 Agent 关注的位置"}}}},
    "agent.connection-test-authentication-failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Authentication failed. Check the API key."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"认证失败，请检查 API Key。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"驗證失敗，請檢查 API Key。"}},"de":{"stringUnit":{"state":"translated","value":"Authentifizierung fehlgeschlagen. Prüfe den API-Schlüssel."}},"es":{"stringUnit":{"state":"translated","value":"La autenticación falló. Comprueba la clave API."}},"fr":{"stringUnit":{"state":"translated","value":"Échec de l’authentification. Vérifiez la clé API."}},"ja":{"stringUnit":{"state":"translated","value":"認証に失敗しました。API キーを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"인증에 실패했습니다. API 키를 확인하세요."}},"ru":{"stringUnit":{"state":"translated","value":"Ошибка аутентификации. Проверьте API-ключ."}},"vi":{"stringUnit":{"state":"translated","value":"Xác thực thất bại. Kiểm tra khóa API."}}}},
    "agent.connection-test-hint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The test sends only fixed short text, never screenshots, recordings, or transcripts. The provider may charge for it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"测试只发送固定短文本，不会发送截图、录音或文字稿；供应商可能计费。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"測試只傳送固定短文字，不會傳送截圖、錄音或文字稿；供應商可能收費。"}},"de":{"stringUnit":{"state":"translated","value":"Der Test sendet nur einen festen kurzen Text, keine Screenshots, Aufnahmen oder Transkripte. Der Anbieter kann dafür Gebühren berechnen."}},"es":{"stringUnit":{"state":"translated","value":"La prueba solo envía un texto breve fijo, nunca capturas, grabaciones ni transcripciones. El proveedor puede cobrar por ella."}},"fr":{"stringUnit":{"state":"translated","value":"Le test envoie uniquement un court texte prédéfini, jamais de captures d’écran, d’enregistrements ou de transcriptions. Le fournisseur peut le facturer."}},"ja":{"stringUnit":{"state":"translated","value":"テストでは固定の短いテキストだけを送信し、スクリーンショット、録音、文字起こしは送信しません。プロバイダーが料金を請求する場合があります。"}},"ko":{"stringUnit":{"state":"translated","value":"테스트는 고정된 짧은 텍스트만 전송하며 스크린샷, 녹음 또는 전사문은 전송하지 않습니다. 공급자가 요금을 청구할 수 있습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Проверка отправляет только короткий фиксированный текст, без снимков экрана, записей или расшифровок. Поставщик может взимать плату."}},"vi":{"stringUnit":{"state":"translated","value":"Kiểm tra chỉ gửi văn bản ngắn cố định, không gửi ảnh chụp màn hình, bản ghi âm hoặc bản chép lời. Nhà cung cấp có thể tính phí."}}}},
    "agent.connection-test-invalid-configuration": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check the API endpoint and model settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请检查 API 端点和模型配置。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請檢查 API 端點與模型設定。"}},"de":{"stringUnit":{"state":"translated","value":"Prüfe den API-Endpunkt und die Modelleinstellungen."}},"es":{"stringUnit":{"state":"translated","value":"Comprueba el endpoint de API y la configuración del modelo."}},"fr":{"stringUnit":{"state":"translated","value":"Vérifiez le point de terminaison API et les paramètres du modèle."}},"ja":{"stringUnit":{"state":"translated","value":"API エンドポイントとモデルの設定を確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"API 엔드포인트와 모델 설정을 확인하세요."}},"ru":{"stringUnit":{"state":"translated","value":"Проверьте конечную точку API и настройки модели."}},"vi":{"stringUnit":{"state":"translated","value":"Kiểm tra điểm cuối API và cấu hình mô hình."}}}},
    "agent.connection-test-invalid-response": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The provider returned no valid text. Check the protocol and model."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"供应商未返回有效文本，请检查协议和模型。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"供應商未傳回有效文字，請檢查通訊協定與模型。"}},"de":{"stringUnit":{"state":"translated","value":"Der Anbieter hat keinen gültigen Text zurückgegeben. Prüfe das Protokoll und das Modell."}},"es":{"stringUnit":{"state":"translated","value":"El proveedor no devolvió texto válido. Comprueba el protocolo y el modelo."}},"fr":{"stringUnit":{"state":"translated","value":"Le fournisseur n’a renvoyé aucun texte valide. Vérifiez le protocole et le modèle."}},"ja":{"stringUnit":{"state":"translated","value":"プロバイダーが有効なテキストを返しませんでした。プロトコルとモデルを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"공급자가 유효한 텍스트를 반환하지 않았습니다. 프로토콜과 모델을 확인하세요."}},"ru":{"stringUnit":{"state":"translated","value":"Поставщик не вернул допустимый текст. Проверьте протокол и модель."}},"vi":{"stringUnit":{"state":"translated","value":"Nhà cung cấp không trả về văn bản hợp lệ. Kiểm tra giao thức và mô hình."}}}},
    "agent.connection-test-missing-key": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save an LLM API key first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先保存 LLM API Key。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請先儲存 LLM API Key。"}},"de":{"stringUnit":{"state":"translated","value":"Speichere zuerst einen LLM-API-Schlüssel."}},"es":{"stringUnit":{"state":"translated","value":"Guarda primero una clave API de LLM."}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrez d’abord une clé API LLM."}},"ja":{"stringUnit":{"state":"translated","value":"先に LLM API キーを保存してください。"}},"ko":{"stringUnit":{"state":"translated","value":"먼저 LLM API 키를 저장하세요."}},"ru":{"stringUnit":{"state":"translated","value":"Сначала сохраните API-ключ LLM."}},"vi":{"stringUnit":{"state":"translated","value":"Trước tiên hãy lưu khóa API LLM."}}}},
    "agent.connection-test-network-failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not connect to the provider. Check the network and API endpoint."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法连接供应商，请检查网络和 API 端点。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法連線至供應商，請檢查網路與 API 端點。"}},"de":{"stringUnit":{"state":"translated","value":"Keine Verbindung zum Anbieter. Prüfe das Netzwerk und den API-Endpunkt."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo conectar con el proveedor. Comprueba la red y el endpoint de API."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de se connecter au fournisseur. Vérifiez le réseau et le point de terminaison API."}},"ja":{"stringUnit":{"state":"translated","value":"プロバイダーに接続できません。ネットワークと API エンドポイントを確認してください。"}},"ko":{"stringUnit":{"state":"translated","value":"공급자에 연결할 수 없습니다. 네트워크와 API 엔드포인트를 확인하세요."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось подключиться к поставщику. Проверьте сеть и конечную точку API."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể kết nối đến nhà cung cấp. Kiểm tra mạng và điểm cuối API."}}}},
    "agent.connection-test-provider-failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The provider could not complete the request. Try again later."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"供应商暂时无法完成请求，请稍后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"供應商暫時無法完成請求，請稍後重試。"}},"de":{"stringUnit":{"state":"translated","value":"Der Anbieter konnte die Anfrage nicht abschließen. Versuche es später erneut."}},"es":{"stringUnit":{"state":"translated","value":"El proveedor no pudo completar la solicitud. Inténtalo de nuevo más tarde."}},"fr":{"stringUnit":{"state":"translated","value":"Le fournisseur n’a pas pu traiter la requête. Réessayez plus tard."}},"ja":{"stringUnit":{"state":"translated","value":"プロバイダーがリクエストを完了できませんでした。後でもう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"공급자가 요청을 완료하지 못했습니다. 나중에 다시 시도하세요."}},"ru":{"stringUnit":{"state":"translated","value":"Поставщик не смог выполнить запрос. Повторите попытку позже."}},"vi":{"stringUnit":{"state":"translated","value":"Nhà cung cấp không thể hoàn tất yêu cầu. Hãy thử lại sau."}}}},
    "agent.connection-test-rate-limited": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The request was rate limited. Try again later."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请求受到限流，请稍后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請求受到速率限制，請稍後重試。"}},"de":{"stringUnit":{"state":"translated","value":"Das Anfragelimit wurde erreicht. Versuche es später erneut."}},"es":{"stringUnit":{"state":"translated","value":"Se alcanzó el límite de solicitudes. Inténtalo de nuevo más tarde."}},"fr":{"stringUnit":{"state":"translated","value":"La limite de requêtes a été atteinte. Réessayez plus tard."}},"ja":{"stringUnit":{"state":"translated","value":"リクエストがレート制限されました。後でもう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"요청이 속도 제한에 걸렸습니다. 나중에 다시 시도하세요."}},"ru":{"stringUnit":{"state":"translated","value":"Превышен лимит запросов. Повторите попытку позже."}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu bị giới hạn tốc độ. Hãy thử lại sau."}}}},
    "agent.connection-test-success": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connected. The model returned text."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接成功，模型已返回文本。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"連線成功，模型已傳回文字。"}},"de":{"stringUnit":{"state":"translated","value":"Verbunden. Das Modell hat Text zurückgegeben."}},"es":{"stringUnit":{"state":"translated","value":"Conexión correcta. El modelo devolvió texto."}},"fr":{"stringUnit":{"state":"translated","value":"Connexion réussie. Le modèle a renvoyé du texte."}},"ja":{"stringUnit":{"state":"translated","value":"接続に成功しました。モデルがテキストを返しました。"}},"ko":{"stringUnit":{"state":"translated","value":"연결되었습니다. 모델이 텍스트를 반환했습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Подключение установлено. Модель вернула текст."}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối thành công. Mô hình đã trả về văn bản."}}}},
    "agent.connection-test-timeout": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The connection test timed out. Try again later."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接测试超时，请稍后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"連線測試逾時，請稍後重試。"}},"de":{"stringUnit":{"state":"translated","value":"Zeitüberschreitung beim Verbindungstest. Versuche es später erneut."}},"es":{"stringUnit":{"state":"translated","value":"La prueba de conexión agotó el tiempo de espera. Inténtalo de nuevo más tarde."}},"fr":{"stringUnit":{"state":"translated","value":"Le test de connexion a expiré. Réessayez plus tard."}},"ja":{"stringUnit":{"state":"translated","value":"接続テストがタイムアウトしました。後でもう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"연결 테스트 시간이 초과되었습니다. 나중에 다시 시도하세요."}},"ru":{"stringUnit":{"state":"translated","value":"Время проверки подключения истекло. Повторите попытку позже."}},"vi":{"stringUnit":{"state":"translated","value":"Kiểm tra kết nối đã hết thời gian chờ. Hãy thử lại sau."}}}},
    "agent.continue-action": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"继续"}}}},
    "agent.deny-action": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"拒绝"}}}},
