    "recording.transcription.completed-description": {
        "localizations": {
            "en": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Review the text, then copy it or save it as a separate text file."
                }
            },
            "de": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Prüfen Sie den Text und kopieren oder speichern Sie ihn anschließend als separate Textdatei."
                }
            },
            "es": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Revisa el texto y después cópialo o guárdalo como un archivo de texto independiente."
                }
            },
            "fr": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Vérifiez le texte, puis copiez-le ou enregistrez-le dans un fichier texte séparé."
                }
            },
            "ja": {
                "stringUnit": {
                    "state": "translated",
                    "value": "内容を確認してから、コピーするか別のテキストファイルとして保存できます。"
                }
            },
            "ko": {
                "stringUnit": {
                    "state": "translated",
                    "value": "텍스트를 확인한 뒤 복사하거나 별도의 텍스트 파일로 저장하세요."
                }
            },
            "ru": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Проверьте текст, затем скопируйте его или сохраните отдельным текстовым файлом."
                }
            },
            "vi": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Kiểm tra văn bản, sau đó sao chép hoặc lưu thành tệp văn bản riêng."
