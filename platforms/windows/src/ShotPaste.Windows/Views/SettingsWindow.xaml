<Window x:Class="ShotPaste.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="SettingsWindow" Title="ShotPaste · 设置" Width="780" Height="620" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="SettingsTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Chrome" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FixedSettingsTabs" TargetType="TabControl">
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <UniformGrid Rows="2"/>
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <ItemsPresenter x:Name="HeaderPanel" Grid.Row="0" KeyboardNavigation.TabIndex="1"/>
              <ContentPresenter x:Name="PART_SelectedContentHost"
                                Grid.Row="1"
                                ContentSource="SelectedContent"
                                KeyboardNavigation.TabNavigation="Local"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HotkeyRecorder" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ToolTip" Value="单击后直接按下快捷键组合；按 Esc 取消本次输入。"/>
      <EventSetter Event="GotKeyboardFocus" Handler="OnHotkeyGotKeyboardFocus"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnHotkeyPreviewMouseLeftButtonDown"/>
      <EventSetter Event="PreviewKeyDown" Handler="OnHotkeyPreviewKeyDown"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
          <Setter Property="BorderThickness" Value="2"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="SettingHint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Margin" Value="0,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource WindowBrush}">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl Margin="20,16,20,0" Background="Transparent" BorderThickness="0" TabStripPlacement="Top"
                Style="{StaticResource FixedSettingsTabs}">
      <TabItem x:Name="GeneralTab" Header="⚙  通用" Style="{StaticResource SettingsTab}" AutomationProperties.AutomationId="SettingsGeneralTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
          <StackPanel Margin="2,0,8,12">
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="启动与声音" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="登录 Windows 后自动启动" IsChecked="{Binding LaunchAtStartup}"/>
                <CheckBox Content="播放截图、录屏与历史提示音" IsChecked="{Binding PlaySounds}"/>
                <CheckBox Content="显示系统托盘图标" IsChecked="{Binding ShowTrayIcon}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="外观与语言" Style="{StaticResource SectionTitle}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="语言" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" SelectedValue="{Binding Language}" SelectedValuePath="Tag" Width="210" HorizontalAlignment="Left">
                    <ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="繁體中文" Tag="zh-TW"/><ComboBoxItem Content="English" Tag="en-US"/><ComboBoxItem Content="日本語" Tag="ja-JP"/><ComboBoxItem Content="한국어" Tag="ko-KR"/><ComboBoxItem Content="Deutsch" Tag="de-DE"/><ComboBoxItem Content="Français" Tag="fr-FR"/><ComboBoxItem Content="Español" Tag="es-ES"/><ComboBoxItem Content="Русский" Tag="ru-RU"/><ComboBoxItem Content="Tiếng Việt" Tag="vi-VN"/>
                  </ComboBox>
                  <TextBlock Grid.Row="1" Text="外观" VerticalAlignment="Center" Margin="0,10,0,0"/>
                  <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding Theme}" SelectedValuePath="Tag" Width="150" HorizontalAlignment="Left" Margin="0,10,0,0">
                    <ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="浅色" Tag="Light"/><ComboBoxItem Content="深色" Tag="Dark"/>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="保存位置" Style="{StaticResource SectionTitle}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                  <Button Grid.Column="1" Content="选择…" Margin="8,0,0,0" Click="OnChooseDirectory"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="URL Scheme" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="允许 shotpaste:// 自动化链接" IsChecked="{Binding UrlSchemeEnabled}"/>
                <TextBlock Text="支持 One Shot、截图、滚动截屏、OCR、录屏、历史与设置页面；关闭后会注销协议。" Style="{StaticResource SettingHint}" Margin="24,2,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="帮助" Style="{StaticResource SectionTitle}"/>
                <Button Content="报告问题…" Click="OnOpenReportPage" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="CaptureRecordingTab" Header="⚙  截图与录屏" Style="{StaticResource SettingsTab}" AutomationProperties.AutomationId="SettingsCaptureRecordingTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
          <StackPanel Margin="2,0,8,12">
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="保存与截图后操作" Style="{StaticResource SectionTitle}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                  <Button Grid.Column="1" Content="选择…" Margin="8,0,0,0" Click="OnChooseDirectory"/>
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                  <CheckBox Content="保存截图" IsChecked="{Binding SaveScreenshots}" Margin="0,5,20,5"/>
                  <CheckBox Content="复制到剪贴板" IsChecked="{Binding CopyScreenshots}" Margin="0,5,20,5"/>
                  <CheckBox Content="显示 Quick Access" IsChecked="{Binding ShowQuickAccessForScreenshots}" Margin="0,5,20,5"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="图片格式与命名" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal">
                  <ComboBox SelectedValue="{Binding ScreenshotFormat}" SelectedValuePath="Tag" Width="110" Padding="8,6" Margin="0,0,12,0">
                    <ComboBoxItem Content="PNG" Tag="Png"/><ComboBoxItem Content="JPEG" Tag="Jpeg"/><ComboBoxItem Content="WebP" Tag="WebP"/>
                  </ComboBox>
                  <TextBlock Text="质量" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBox Text="{Binding JpegQuality}" Width="64" ToolTip="JPEG / WebP 质量（1–100）"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="色彩空间" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox SelectedValue="{Binding ScreenshotColorSpace}" SelectedValuePath="Tag" Width="130">
                    <ComboBoxItem Content="自动" Tag="Auto"/><ComboBoxItem Content="sRGB" Tag="Srgb"/><ComboBoxItem Content="Display P3" Tag="DisplayP3"/>
                  </ComboBox>
                </StackPanel>
                <TextBox Text="{Binding ScreenshotNameTemplate}" Margin="0,10,0,0" ToolTip="支持 {datetime}、{date}、{time}、{ms}、{type}"/>
                <TextBlock Text="可在命名中使用日期、时间、毫秒和截图类型占位符。" Style="{StaticResource SettingHint}" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="录屏" Style="{StaticResource SectionTitle}"/>
                <WrapPanel>
                  <CheckBox Content="保存录屏" IsChecked="{Binding SaveRecordings}" Margin="0,5,20,5"/>
                  <CheckBox Content="复制录屏文件" IsChecked="{Binding CopyRecordings}" Margin="0,5,20,5"/>
                  <CheckBox Content="显示 Quick Access" IsChecked="{Binding ShowQuickAccessForRecordings}"/>
                </WrapPanel>
                <TextBox Text="{Binding RecordingNameTemplate}" Margin="0,8,0,8" ToolTip="录屏命名模板"/>
                <WrapPanel>
                  <CheckBox Content="包含鼠标指针" IsChecked="{Binding IncludeCursorInRecording}" Margin="0,5,20,5"/>
                  <CheckBox Content="高亮鼠标点击" IsChecked="{Binding HighlightMouseClicks}" Margin="0,5,20,5"/>
                  <CheckBox Content="显示按键" IsChecked="{Binding ShowKeystrokes}" Margin="0,5,20,5"/>
                  <CheckBox Content="录制中包含 ShotPaste" IsChecked="{Binding IncludeShotPasteInRecording}" Margin="0,5,20,5"
                            AutomationProperties.AutomationId="IncludeShotPasteInRecording"/>
                  <CheckBox Content="暗化未选区域" IsChecked="{Binding DimNonSelectedRecordingArea}" Margin="0,5,20,5"/>
                  <CheckBox Content="系统声音" IsChecked="{Binding RecordSystemAudio}" Margin="0,5,20,5"/>
                  <CheckBox Content="麦克风" IsChecked="{Binding RecordMicrophone}" Margin="0,5,20,5"/>
                </WrapPanel>
                <Border Margin="0,9,0,0" Padding="10" CornerRadius="8" Background="#0BFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1">
                  <StackPanel>
                    <DockPanel LastChildFill="False">
                      <Button DockPanel.Dock="Right" Content="预览效果" Click="OnPreviewRecordingEffects" Padding="10,4"
                              AutomationProperties.AutomationId="PreviewRecordingEffects"/>
                      <TextBlock Text="点击与按键效果" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/><ColumnDefinition Width="74"/><ColumnDefinition Width="88"/><ColumnDefinition Width="74"/>
                        <ColumnDefinition Width="86"/><ColumnDefinition Width="80"/><ColumnDefinition Width="86"/><ColumnDefinition Width="80"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="光圈尺寸" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="1" Text="{Binding RecordingClickRadius, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RecordingClickRadius"/>
                      <TextBlock Grid.Column="2" Text="透明度" Margin="12,0,0,0" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="3" Text="{Binding RecordingClickOpacity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RecordingClickOpacity"/>
                      <TextBlock Grid.Column="4" Text="持续毫秒" Margin="12,0,0,0" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="5" Text="{Binding RecordingClickDurationMs, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RecordingClickDuration"/>
                      <TextBlock Grid.Column="6" Text="波纹数量" Margin="12,0,0,0" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="7" SelectedValue="{Binding RecordingClickRippleCount}" SelectedValuePath="Tag"
                                AutomationProperties.AutomationId="RecordingClickRippleCount">
                        <ComboBoxItem Content="1" Tag="1"/><ComboBoxItem Content="2" Tag="2"/><ComboBoxItem Content="3" Tag="3"/>
                        <ComboBoxItem Content="4" Tag="4"/><ComboBoxItem Content="5" Tag="5"/>
                      </ComboBox>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="150"/><ColumnDefinition Width="86"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                      <TextBlock Text="左键颜色" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="1" Text="{Binding RecordingClickLeftColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RecordingClickLeftColor"/>
                      <TextBlock Grid.Column="2" Text="右键颜色" Margin="12,0,0,0" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="3" Text="{Binding RecordingClickRightColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RecordingClickRightColor"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74"/><ColumnDefinition Width="116"/><ColumnDefinition Width="60"/><ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="76"/><ColumnDefinition Width="72"/><ColumnDefinition Width="72"/><ColumnDefinition Width="138"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="按键位置" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1" SelectedValue="{Binding RecordingKeystrokePosition}" SelectedValuePath="Tag"
                                AutomationProperties.AutomationId="RecordingKeystrokePosition">
                        <ComboBoxItem Content="左上" Tag="TopLeft"/><ComboBoxItem Content="上中" Tag="TopCenter"/><ComboBoxItem Content="右上" Tag="TopRight"/>
                        <ComboBoxItem Content="左下" Tag="BottomLeft"/><ComboBoxItem Content="下中" Tag="BottomCenter"/><ComboBoxItem Content="右下" Tag="BottomRight"/>
                      </ComboBox>
                      <TextBlock Grid.Column="2" Text="字号" Margin="12,0,0,0" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="3" Text="{Binding RecordingKeystrokeFontSize, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RecordingKeystrokeFontSize"/>
                      <TextBlock Grid.Column="4" Text="持续毫秒" Margin="12,0,0,0" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="5" Text="{Binding RecordingKeystrokeDurationMs, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RecordingKeystrokeDuration"/>
                      <TextBlock Grid.Column="6" Text="显示规则" Margin="12,0,0,0" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="7" SelectedValue="{Binding RecordingKeystrokeVisibility}" SelectedValuePath="Tag"
                                AutomationProperties.AutomationId="RecordingKeystrokeVisibility">
                        <ComboBoxItem Content="全部按键" Tag="All"/><ComboBoxItem Content="特殊键与组合键" Tag="SpecialAndShortcuts"/>
                        <ComboBoxItem Content="仅组合键" Tag="ShortcutsOnly"/><ComboBoxItem Content="仅特殊键" Tag="SpecialOnly"/>
                      </ComboBox>
                    </Grid>
                    <TextBlock Text="预览使用与 MP4/GIF 成片相同的光圈和按键叠加层。" Style="{StaticResource SettingHint}" Margin="0,7,0,0"/>
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="帧率" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <ComboBox SelectedValue="{Binding RecordingFps}" SelectedValuePath="Tag" Width="120" Padding="8,6">
                    <ComboBoxItem Content="15 FPS" Tag="15"/><ComboBoxItem Content="30 FPS" Tag="30"/><ComboBoxItem Content="60 FPS" Tag="60"/>
                  </ComboBox>
                </StackPanel>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="170"/><ColumnDefinition Width="96"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                  <TextBlock Text="视频容器" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" SelectedValue="{Binding RecordingVideoFormat}" SelectedValuePath="Tag" SelectionChanged="OnRecordingFormatChanged"
                            AutomationProperties.AutomationId="RecordingVideoFormat">
                    <ComboBoxItem Content="MP4（Windows 推荐）" Tag="Mp4"/>
                    <ComboBoxItem x:Name="RecordingMovItem" Content="MOV（Windows 不可用）" Tag="Mov" IsEnabled="False"/>
                  </ComboBox>
                  <TextBlock Grid.Column="2" Text="视频编码" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  <ComboBox Grid.Column="3" SelectedValue="{Binding RecordingVideoCodec}" SelectedValuePath="Tag" SelectionChanged="OnRecordingFormatChanged"
                            AutomationProperties.AutomationId="RecordingVideoCodec">
                    <ComboBoxItem Content="H.264（兼容优先）" Tag="H264"/>
                    <ComboBoxItem x:Name="RecordingHevcItem" Content="HEVC / H.265" Tag="Hevc"/>
                  </ComboBox>
                </Grid>
                <TextBlock x:Name="RecordingFormatStatus" Style="{StaticResource SettingHint}" Margin="0,5,0,0"
                           AutomationProperties.AutomationId="RecordingFormatStatus"
                           Text="正在检查 Windows 媒体编码能力…"/>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="170"/><ColumnDefinition Width="96"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                  <TextBlock Text="系统声音音量" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding RecordingSystemAudioVolume}"/>
                  <TextBlock Grid.Column="2" Text="麦克风音量" VerticalAlignment="Center" Margin="12,0,0,0"/><Slider Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding RecordingMicrophoneVolume}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="GIF 帧率" Width="96" VerticalAlignment="Center"/>
                  <ComboBox SelectedValue="{Binding RecordingGifFps}" SelectedValuePath="Tag" Width="120">
                    <ComboBoxItem Content="10 FPS" Tag="10"/><ComboBoxItem Content="15 FPS" Tag="15"/><ComboBoxItem Content="20 FPS" Tag="20"/><ComboBoxItem Content="30 FPS" Tag="30"/>
                  </ComboBox>
                  <CheckBox Content="显示录屏控制条" IsChecked="{Binding ShowRecordingToolbar}" Margin="22,0,0,0"/>
                  <CheckBox Content="托盘显示录屏时长" IsChecked="{Binding ShowRecordingDurationInTray}" Margin="18,0,0,0"/>
                </StackPanel>
                <TextBlock Text="录屏实时标注" Style="{StaticResource SectionTitle}" Margin="0,14,0,8"/>
                <WrapPanel>
                  <TextBlock Text="颜色" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBox Text="{Binding RecordingAnnotationColor}" Width="90" Margin="0,0,12,0"/>
                  <TextBlock Text="粗细" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBox Text="{Binding RecordingAnnotationWidth}" Width="54" Margin="0,0,12,0"/>
                  <TextBlock Text="自动清除" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox SelectedValue="{Binding RecordingAnnotationClearMode}" SelectedValuePath="Tag" Width="120">
                    <ComboBoxItem Content="手动" Tag="Manual"/><ComboBoxItem Content="按时间" Tag="AfterSeconds"/><ComboBoxItem Content="按数量" Tag="MaximumCount"/>
                  </ComboBox>
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                  <TextBlock Text="定时清除秒数" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBox Text="{Binding RecordingAnnotationClearSeconds}" Width="54" Margin="0,0,16,0"/>
                  <TextBlock Text="最多保留笔数" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBox Text="{Binding RecordingAnnotationMaxCount}" Width="54"/>
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                  <CheckBox Content="到期前淡出" IsChecked="{Binding RecordingAnnotationFadeEnabled}" Margin="0,0,12,0"
                            AutomationProperties.AutomationId="RecordingAnnotationFadeEnabled"/>
                  <TextBlock Text="淡出毫秒" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBox Text="{Binding RecordingAnnotationFadeMilliseconds, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="0,0,16,0"
                           AutomationProperties.AutomationId="RecordingAnnotationFadeDuration"/>
                </WrapPanel>
                <TextBlock Text="标注清除策略会在录屏标注面板中按工具分别保存。"
                           Style="{StaticResource SettingHint}" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="QuickAccessTab" Header="▣  Quick Access" Style="{StaticResource SettingsTab}" AutomationProperties.AutomationId="SettingsQuickAccessTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
          <StackPanel Margin="2,0,8,12">
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="Quick Access 浮动卡片" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="启用 Quick Access" IsChecked="{Binding ShowQuickAccess}"/>
                <TextBlock Text="截图或录屏后在屏幕边缘显示预览卡片，操作与 macOS 版保持一致。" Style="{StaticResource SettingHint}" Margin="0,4,0,14"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="显示位置" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" SelectedValue="{Binding QuickAccessPosition}" SelectedValuePath="Tag" Width="130" HorizontalAlignment="Left" Padding="8,6">
                    <ComboBoxItem Content="屏幕左侧" Tag="BottomLeft"/><ComboBoxItem Content="屏幕右侧" Tag="BottomRight"/>
                  </ComboBox>
                  <TextBlock Grid.Row="1" Text="自动关闭" VerticalAlignment="Center" Margin="0,12,0,0"/>
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox Content="启用" IsChecked="{Binding QuickAccessAutoDismissEnabled}" Margin="0,0,12,0"/>
                    <TextBox Text="{Binding QuickAccessAutoDismissSeconds}" Width="56" ToolTip="3–30 秒"/>
                    <TextBlock Text="秒（3–30）" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="2" Text="悬停行为" VerticalAlignment="Center" Margin="0,12,0,0"/>
                  <CheckBox Grid.Row="2" Grid.Column="1" Content="鼠标悬停时暂停倒计时" IsChecked="{Binding PauseQuickAccessOnHover}" Margin="0,12,0,0"/>
                  <TextBlock Grid.Row="3" Text="启用操作（最多 6 个）" VerticalAlignment="Center" Margin="0,12,0,0"/>
                  <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,12,0,0">
                    <ComboBox SelectedValue="{Binding QuickAccessAction1}" SelectedValuePath="Tag" Width="104" Margin="0,0,6,6"><ComboBoxItem Content="复制" Tag="Copy"/><ComboBoxItem Content="保存 / 打开" Tag="SaveOrOpen"/><ComboBoxItem Content="关闭" Tag="Close"/><ComboBoxItem Content="删除" Tag="Delete"/><ComboBoxItem Content="贴图" Tag="Pin"/><ComboBoxItem Content="空" Tag="None"/></ComboBox>
                    <ComboBox SelectedValue="{Binding QuickAccessAction2}" SelectedValuePath="Tag" Width="104" Margin="0,0,6,6"><ComboBoxItem Content="复制" Tag="Copy"/><ComboBoxItem Content="保存 / 打开" Tag="SaveOrOpen"/><ComboBoxItem Content="关闭" Tag="Close"/><ComboBoxItem Content="删除" Tag="Delete"/><ComboBoxItem Content="贴图" Tag="Pin"/><ComboBoxItem Content="空" Tag="None"/></ComboBox>
                    <ComboBox SelectedValue="{Binding QuickAccessAction3}" SelectedValuePath="Tag" Width="104" Margin="0,0,6,6"><ComboBoxItem Content="复制" Tag="Copy"/><ComboBoxItem Content="保存 / 打开" Tag="SaveOrOpen"/><ComboBoxItem Content="关闭" Tag="Close"/><ComboBoxItem Content="删除" Tag="Delete"/><ComboBoxItem Content="贴图" Tag="Pin"/><ComboBoxItem Content="空" Tag="None"/></ComboBox>
                    <ComboBox SelectedValue="{Binding QuickAccessAction4}" SelectedValuePath="Tag" Width="104" Margin="0,0,6,6"><ComboBoxItem Content="复制" Tag="Copy"/><ComboBoxItem Content="保存 / 打开" Tag="SaveOrOpen"/><ComboBoxItem Content="关闭" Tag="Close"/><ComboBoxItem Content="删除" Tag="Delete"/><ComboBoxItem Content="贴图" Tag="Pin"/><ComboBoxItem Content="空" Tag="None"/></ComboBox>
                    <ComboBox SelectedValue="{Binding QuickAccessAction5}" SelectedValuePath="Tag" Width="104" Margin="0,0,6,6"><ComboBoxItem Content="复制" Tag="Copy"/><ComboBoxItem Content="保存 / 打开" Tag="SaveOrOpen"/><ComboBoxItem Content="关闭" Tag="Close"/><ComboBoxItem Content="删除" Tag="Delete"/><ComboBoxItem Content="贴图" Tag="Pin"/><ComboBoxItem Content="空" Tag="None"/></ComboBox>
                    <ComboBox SelectedValue="{Binding QuickAccessAction6}" SelectedValuePath="Tag" Width="104" Margin="0,0,6,6"><ComboBoxItem Content="复制" Tag="Copy"/><ComboBoxItem Content="保存 / 打开" Tag="SaveOrOpen"/><ComboBoxItem Content="关闭" Tag="Close"/><ComboBoxItem Content="删除" Tag="Delete"/><ComboBoxItem Content="贴图" Tag="Pin"/><ComboBoxItem Content="空" Tag="None"/></ComboBox>
                  </WrapPanel>
                  <TextBlock Grid.Row="4" Text="卡片缩放" VerticalAlignment="Center" Margin="0,12,0,0"/>
                  <Slider Grid.Row="4" Grid.Column="1" Minimum="0.75" Maximum="1.5" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding QuickAccessScale}" Width="150" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                  <CheckBox Grid.Row="5" Grid.Column="1" Content="允许拖动卡片" IsChecked="{Binding QuickAccessEnableDrag}" Margin="0,12,0,0"/>
                  <TextBlock Grid.Row="6" Text="动画样式" VerticalAlignment="Center" Margin="0,12,0,0"/>
                  <ComboBox Grid.Row="6" Grid.Column="1" SelectedValue="{Binding QuickAccessAnimationStyle}" SelectedValuePath="Tag" Width="130" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <ComboBoxItem Content="滑入" Tag="Slide"/><ComboBoxItem Content="缩放" Tag="Scale"/>
                  </ComboBox>
                  <CheckBox Grid.Row="7" Grid.Column="1" Content="启用双指滑动关闭卡片" IsChecked="{Binding QuickAccessTwoFingerSwipeEnabled}" Margin="0,12,0,0"/>
                  <TextBlock Grid.Row="8" Text="滑动灵敏度" VerticalAlignment="Center" Margin="0,12,0,0"/>
                  <Slider Grid.Row="8" Grid.Column="1" Minimum="0.5" Maximum="3" Value="{Binding QuickAccessSwipeSensitivity}" Width="150" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                  <CheckBox Grid.Row="9" Grid.Column="1" Content="打开对应贴图窗口时隐藏此卡片" IsChecked="{Binding QuickAccessHideCardWhenWindowOpen}" Margin="0,12,0,0"/>
                  <TextBlock Grid.Row="10" Text="触控板方向" VerticalAlignment="Center" Margin="0,12,0,0"/>
                  <ComboBox Grid.Row="10" Grid.Column="1" SelectedValue="{Binding QuickAccessTrackpadSwipeMode}" SelectedValuePath="Tag" Width="130" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <ComboBoxItem Content="自然" Tag="Natural"/><ComboBoxItem Content="反向" Tag="Inverted"/>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="卡片操作" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="最多同时保留 5 张卡片。每个动作使用固定语义位置；停用动作会保留空位，不会让其余按钮跳位。" Style="{StaticResource SettingHint}"/>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                  <TextBlock Text="向左滑动" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" SelectedValue="{Binding QuickAccessSwipeLeftAction}" SelectedValuePath="Tag"><ComboBoxItem Content="关闭" Tag="Close"/><ComboBoxItem Content="复制" Tag="Copy"/><ComboBoxItem Content="保存 / 打开" Tag="SaveOrOpen"/><ComboBoxItem Content="贴图" Tag="Pin"/><ComboBoxItem Content="删除" Tag="Delete"/><ComboBoxItem Content="无动作" Tag="None"/></ComboBox>
                  <TextBlock Grid.Column="2" Text="向右滑动" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  <ComboBox Grid.Column="3" SelectedValue="{Binding QuickAccessSwipeRightAction}" SelectedValuePath="Tag"><ComboBoxItem Content="关闭" Tag="Close"/><ComboBoxItem Content="复制" Tag="Copy"/><ComboBoxItem Content="保存 / 打开" Tag="SaveOrOpen"/><ComboBoxItem Content="贴图" Tag="Pin"/><ComboBoxItem Content="删除" Tag="Delete"/><ComboBoxItem Content="无动作" Tag="None"/></ComboBox>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="HistoryTab" Header="◷  剪贴板历史" Style="{StaticResource SettingsTab}" AutomationProperties.AutomationId="SettingsHistoryTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
          <StackPanel Margin="2,0,8,12">
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="剪贴板与默认筛选" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="记录剪贴板图片、文件和文本" IsChecked="{Binding ClipboardHistoryEnabled}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <TextBlock Text="打开时显示" Width="140" VerticalAlignment="Center"/>
                  <ComboBox SelectedValue="{Binding DefaultHistoryFilter}" SelectedValuePath="Tag" Width="170" Padding="8,6">
                    <ComboBoxItem Content="截图" Tag="Screenshot"/><ComboBoxItem Content="滚动截屏" Tag="ScrollingScreenshot"/><ComboBoxItem Content="录屏" Tag="Recording"/><ComboBoxItem Content="剪贴板" Tag="Clipboard"/>
                  </ComboBox>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="存储管理" Style="{StaticResource SectionTitle}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="自动清理天数（0 为关闭）" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" Text="{Binding HistoryRetentionDays}" Width="80" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Row="1" Text="最大记录数（0 为无限）" VerticalAlignment="Center" Margin="0,12,0,0"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HistoryMaxCount}" Width="80" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </Grid>
                <TextBlock Text="剪贴板历史窗口支持搜索、类型 / 时间筛选、多选以及 Ctrl+A、Ctrl+C、Delete 和 Enter。" Style="{StaticResource SettingHint}" Margin="0,14,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="剪贴板历史背景样式" Width="180" VerticalAlignment="Center"/>
                  <ComboBox SelectedValue="{Binding HistoryBackgroundStyle}" SelectedValuePath="Tag" Width="150"
                            AutomationProperties.AutomationId="SettingsHistoryBackground">
                    <ComboBoxItem Content="HUD 材质" Tag="Hud"/><ComboBoxItem Content="纯色" Tag="Solid"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="紧凑面板位置" Width="180" VerticalAlignment="Center"/>
                  <ComboBox SelectedValue="{Binding HistoryPanelPosition}" SelectedValuePath="Tag" Width="150">
                    <ComboBoxItem Content="顶部中央" Tag="TopCenter"/><ComboBoxItem Content="左上角" Tag="TopLeft"/><ComboBoxItem Content="右上角" Tag="TopRight"/><ComboBoxItem Content="左下角" Tag="BottomLeft"/><ComboBoxItem Content="右下角" Tag="BottomRight"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="紧凑面板缩放" Width="180" VerticalAlignment="Center"/>
                  <Slider Minimum="0.75" Maximum="1.5" Value="{Binding HistoryPanelScale}" Width="150"/>
                  <TextBlock Text="显示数（3–50）" Margin="22,0,8,0" VerticalAlignment="Center"/><TextBox Text="{Binding HistoryPanelMaxItems}" Width="70"/>
                </StackPanel>
                <TextBlock Text="历史面板每次都以紧凑模式打开；可在面板内临时展开。提示音跟随“通用 → 播放提示音”。" Style="{StaticResource SettingHint}" Margin="0,9,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="ShortcutsTab" Header="⌨  快捷键" Style="{StaticResource SettingsTab}" AutomationProperties.AutomationId="SettingsShortcutsTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
          <StackPanel Margin="2,0,8,12">
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="全局快捷键" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="启用全局快捷键" IsChecked="{Binding ShortcutsEnabled}"/>
                <TextBlock Text="单击快捷键框后，直接按下 Ctrl、Alt、Shift、Win 与一个普通按键的组合。One Shot 是唯一的闲置捕获入口。" Style="{StaticResource SettingHint}" Margin="0,3,0,12"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="One Shot" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding OneShotHotkey}" Tag="OneShotHotkey" Style="{StaticResource HotkeyRecorder}" Margin="0,3" AutomationProperties.AutomationId="SettingsOneShotHotkey"/>
                  <TextBlock Grid.Row="1" Text="剪贴板历史" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HistoryHotkey}" Tag="HistoryHotkey" Style="{StaticResource HotkeyRecorder}" Margin="0,3"/>
                  <TextBlock Grid.Row="2" Text="录屏暂停/继续" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RecordingPauseHotkey}" Tag="RecordingPauseHotkey" Style="{StaticResource HotkeyRecorder}" Margin="0,3"/>
                  <TextBlock Grid.Row="3" Text="录屏标注开关" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RecordingAnnotationHotkey}" Tag="RecordingAnnotationHotkey" Style="{StaticResource HotkeyRecorder}" Margin="0,3"/>
                  <TextBlock Grid.Row="4" Text="重新录制" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RecordingRestartHotkey}" Tag="RecordingRestartHotkey" Style="{StaticResource HotkeyRecorder}" Margin="0,3"/>
                  <TextBlock Grid.Row="5" Text="删除当前录屏" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RecordingDeleteHotkey}" Tag="RecordingDeleteHotkey" Style="{StaticResource HotkeyRecorder}" Margin="0,3"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                  <TextBlock Text="切换剪贴板历史布局" Width="155" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding HistoryModeHotkey}" Tag="HistoryModeHotkey" Style="{StaticResource HotkeyRecorder}"
                           Width="220" AutomationProperties.AutomationId="SettingsHistoryModeHotkey"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="155,10,0,0">
                  <Button Content="恢复默认" Click="OnResetHotkeys" Margin="0,0,8,0"/>
                  <Button Content="清除全部" Click="OnClearHotkeys"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="ScrollingTab" Header="↕  滚动截屏" Style="{StaticResource SettingsTab}" AutomationProperties.AutomationId="SettingsScrollingTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
          <StackPanel Margin="2,0,8,12">
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="滚动捕获" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="允许自动滚动（需要鼠标停留在选区内）" IsChecked="{Binding ScrollingAutoScrollEnabled}"/>
                <CheckBox Content="开始滚动截屏时显示操作提示" IsChecked="{Binding ScrollingShowHints}"/>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="100"/><ColumnDefinition Width="170"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="自动滚动间隔（毫秒）" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ScrollingAutoScrollIntervalMs}"/>
                  <TextBlock Grid.Column="2" Text="最大输出高度" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox Grid.Column="3" Text="{Binding ScrollingMaxHeight}"/>
                  <TextBlock Grid.Row="1" Text="实时预览最大高度" VerticalAlignment="Center" Margin="0,9,0,0"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ScrollingPreviewMaxHeight}" Margin="0,9,0,0"/>
                  <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="识别固定页头 / 页尾 / 侧栏" IsChecked="{Binding ScrollingDetectFixedBars}" Margin="12,9,0,0"/>
                  <CheckBox Grid.Row="2" Grid.ColumnSpan="4" Content="启用匹配失败恢复与减速提示" IsChecked="{Binding ScrollingSafetyGuardEnabled}" Margin="0,9,0,0"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
              <TextBlock Text="滚动截屏会锁定首帧，按滚动事件提交新帧；对齐不可靠时预览会标记为需减速，最终只保存已确认的拼接内容。" Style="{StaticResource SettingHint}"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="ScreenshotTab" Header="▣  截图选项" Style="{StaticResource SettingsTab}" AutomationProperties.AutomationId="SettingsScreenshotTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
          <StackPanel Margin="2,0,8,12">
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="捕获内容" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="截图中包含鼠标指针" IsChecked="{Binding ShowCursorInScreenshots}"/>
                <CheckBox Content="隐藏桌面图标与桌面组件" IsChecked="{Binding HideDesktopIconsInScreenshots}"/>
                <CheckBox Content="隐藏桌面小组件（兼容第三方桌面控件）" IsChecked="{Binding HideDesktopWidgetsInScreenshots}"/>
                <CheckBox Content="捕获时排除 ShotPaste 自身窗口" IsChecked="{Binding ExcludeOwnApplicationFromScreenshots}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="输出倍率" Width="140" VerticalAlignment="Center"/>
                  <ComboBox SelectedValue="{Binding ScreenshotScale}" SelectedValuePath="Tag" Width="150">
                    <ComboBoxItem Content="自动" Tag="0"/><ComboBoxItem Content="1×" Tag="1"/><ComboBoxItem Content="2×" Tag="2"/>
                  </ComboBox>
                </StackPanel>
                <TextBlock Text="自动与 1× 都保留显示器原生物理像素；2× 仅用于需要放大交付的场景。" Style="{StaticResource SettingHint}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="输出" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="色彩空间" Width="140" VerticalAlignment="Center"/>
                  <ComboBox SelectedValue="{Binding ScreenshotColorSpace}" SelectedValuePath="Tag" Width="150">
                    <ComboBoxItem Content="自动" Tag="Auto"/><ComboBoxItem Content="sRGB" Tag="Srgb"/><ComboBoxItem Content="Display P3" Tag="DisplayP3"/>
                  </ComboBox>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="通知与 OCR" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="截图和录屏成功后显示通知" IsChecked="{Binding ShowCaptureNotifications}"/>
                <CheckBox Content="OCR 成功后显示通知" IsChecked="{Binding ShowOcrSuccessNotifications}"/>
                <CheckBox Content="识别到链接时显示提示" IsChecked="{Binding ShowOcrLinkNotifications}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="OCR 识别语言" Width="140" VerticalAlignment="Center"/>
                  <ComboBox SelectedValue="{Binding OcrRecognitionLanguage}" SelectedValuePath="Tag" Width="210">
                    <ComboBoxItem Content="跟随应用语言" Tag="Auto"/><ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="繁體中文" Tag="zh-TW"/><ComboBoxItem Content="English" Tag="en-US"/><ComboBoxItem Content="日本語" Tag="ja-JP"/><ComboBoxItem Content="한국어" Tag="ko-KR"/><ComboBoxItem Content="Deutsch" Tag="de-DE"/><ComboBoxItem Content="Français" Tag="fr-FR"/><ComboBoxItem Content="Español" Tag="es-ES"/><ComboBoxItem Content="Русский" Tag="ru-RU"/><ComboBoxItem Content="Tiếng Việt" Tag="vi-VN"/>
                  </ComboBox>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="AdvancedTab" Header="☷  高级" Style="{StaticResource SettingsTab}" AutomationProperties.AutomationId="SettingsAdvancedTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
          <StackPanel Margin="2,0,8,12">
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="恢复默认设置" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="恢复应用设置，同时保留当前快捷键，避免影响并行进行的快捷键改造。" Style="{StaticResource SettingHint}" Margin="0,0,0,10"/>
                <Button Content="恢复默认…" Click="OnRestoreDefaults" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="诊断" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="启用本地诊断日志" IsChecked="{Binding DiagnosticsEnabled}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="日志保留天数" Width="140" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding DiagnosticsRetentionDays}" Width="70" AutomationProperties.AutomationId="SettingsDiagnosticsRetention"/>
                  <TextBlock Text="1–30 天" Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Content="打开日志文件夹" Click="OnOpenLogDirectory" HorizontalAlignment="Left" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="法律信息" Style="{StaticResource SectionTitle}"/>
                <Button Content="查看开源许可证" Click="OnOpenLegalNotices" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12" Background="{DynamicResource SurfaceBrush}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Margin="0,0,8,0" Click="OnCancel"/>
        <Button Content="保存" Style="{StaticResource AccentButton}" MinWidth="82" Click="OnSave"
                AutomationProperties.AutomationId="SettingsSave"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
