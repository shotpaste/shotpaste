<Window x:Class="ShotPaste.Windows.Views.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ShotPaste.Windows.Services"
        xmlns:controls="clr-namespace:ShotPaste.Windows.Controls"
        Title="{loc:Localized Key='AI 翻译', IsWindowTitle=True}" Width="980" Height="700" MinWidth="660" MinHeight="480"
        WindowStyle="None" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="TranslationWindow">
  <Grid Background="{DynamicResource WindowBackdropBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <controls:WindowTitleBar/>
    <StackPanel Grid.Row="1" Margin="18,8">
      <WrapPanel>
        <ComboBox x:Name="SourceLanguage" AutomationProperties.AutomationId="TranslationSourceLanguage" Width="140" DisplayMemberPath="NativeName" SelectedValuePath="Code" Margin="0,0,8,8" AutomationProperties.Name="{loc:Localized Key='源语言'}"/>
        <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox x:Name="TargetLanguage" AutomationProperties.AutomationId="TranslationTargetLanguage" Width="140" DisplayMemberPath="NativeName" SelectedValuePath="Code" Margin="0,0,8,8" AutomationProperties.Name="{loc:Localized Key='目标语言'}"/>
        <Button x:Name="TranslateSelection" Content="{loc:Localized Key='选区翻译'}" Click="OnTranslateSelection" Margin="0,0,8,8" AutomationProperties.AutomationId="TranslationSelection"/>
        <Button x:Name="TranslateScreen" Content="{loc:Localized Key='全屏翻译'}" Click="OnTranslateScreen" Margin="0,0,8,8" AutomationProperties.AutomationId="TranslationFullScreen"/>
        <Button x:Name="CancelRequest" Content="{loc:Localized Key='取消'}" Click="OnCancel" IsEnabled="False" Margin="0,0,8,8" AutomationProperties.AutomationId="TranslationCancel"/>
      </WrapPanel>
      <TextBlock Text="{loc:Localized Key='屏幕图片不会上传。ShotPaste 会在本地识别文字，并仅将识别出的文字发送到已配置的 API。'}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
    </StackPanel>
    <TabControl Grid.Row="2" Margin="18,0">
      <TabItem Header="{loc:Localized Key='图像'}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Image x:Name="Preview" Stretch="Uniform" AutomationProperties.Name="{loc:Localized Key='AI 翻译'}"/>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Localized Key='原文'}">
        <TextBox x:Name="OriginalText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="TranslationOriginalText"/>
      </TabItem>
      <TabItem Header="{loc:Localized Key='译文'}">
        <TextBox x:Name="TranslatedText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="TranslationText"/>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="3" Margin="18,10,18,18">
      <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="TranslationStatus"/>
      <TextBlock Text="{loc:Localized Key='图片中的长译文可能被裁切；完整内容可在译文标签中查看和复制。'}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6"/>
      <WrapPanel HorizontalAlignment="Right">
        <Button x:Name="OpenSettings" Content="{loc:Localized Key='打开设置'}" Click="OnOpenSettings" Margin="0,0,8,0" AutomationProperties.AutomationId="TranslationOpenSettings"/>
        <Button x:Name="CopyImage" Content="{loc:Localized Key='复制图片'}" Click="OnCopyImage" IsEnabled="False" Margin="0,0,8,0"/>
        <Button x:Name="CopyText" Content="{loc:Localized Key='复制文字'}" Click="OnCopyText" IsEnabled="False" Margin="0,0,8,0"/>
        <Button Content="{loc:Localized Key='关闭'}" Click="OnClose" AutomationProperties.AutomationId="TranslationClose"/>
      </WrapPanel>
    </StackPanel>
  </Grid>
</Window>
