    "recording.results.processing-note": {
      "comment": "Transcription results processing-note",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing continues when this window is closed. Results will appear here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭窗口后任务会继续，结果会保存在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉視窗後任務會繼續，結果會儲存在這裡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを閉じても処理は続き、結果はここに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창을 닫아도 처리가 계속되며 결과는 여기에 저장됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verarbeitung läuft nach dem Schließen weiter. Ergebnisse erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesamiento continúa al cerrar esta ventana. Los resultados aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traitement continue après la fermeture. Les résultats apparaîtront ici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработка продолжится после закрытия окна. Результаты появятся здесь."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng cửa sổ không dừng xử lý. Kết quả sẽ xuất hiện ở đây."
          }
        }
      }
    },
    "recording.results.unavailable": {
      "comment": "Transcription results unavailable",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This result has not been generated. Existing results are available in the other tabs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此产物尚未生成，可切换页签查看已有结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此產物尚未產生，可切換頁籤查看已有結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この結果はまだ生成されていません。他のタブで既存の結果を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결과는 아직 생성되지 않았습니다. 다른 탭에서 기존 결과를 볼 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Ergebnis wurde noch nicht erzeugt. Vorhandene Ergebnisse stehen in den anderen Tabs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este resultado aún no se ha generado. Consulta los resultados existentes en las otras pestañas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce résultat n’a pas encore été généré. Les résultats existants sont dans les autres onglets."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот результат ещё не создан. Готовые результаты доступны на других вкладках."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả này chưa được tạo. Xem kết quả hiện có trong các thẻ khác."
          }
        }
      }
    },
    "recording.results.saved-locally": {
      "comment": "Transcription results saved-locally",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generated results are saved locally. Copy or save the selected result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已生成的产物自动保存在本机；复制、保存作用于当前页签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已產生的產物自動儲存在本機；複製、儲存作用於目前頁籤。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成済みの結果はローカルに保存されます。選択中の結果をコピー・保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성된 결과는 로컬에 저장됩니다. 선택한 결과를 복사하거나 저장하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzeugte Ergebnisse werden lokal gespeichert. Kopieren oder speichern Sie das ausgewählte Ergebnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados se guardan localmente. Copia o guarda el resultado seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats sont enregistrés localement. Copiez ou enregistrez le résultat sélectionné."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты сохраняются локально. Копируйте или сохраняйте выбранный результат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả được lưu trên máy. Sao chép hoặc lưu kết quả đã chọn."
          }
        }
      }
    },
