    "preferences-advanced.restore-defaults-confirm-button": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardeinstellungen wiederherstellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Defaults"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar valores predeterminados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer les réglages par défaut"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトに戻す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값 복원"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить умолчания"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục mặc định"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复默认设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復預設值"
          }
        }
      }
    },
    "preferences-advanced.restore-defaults-confirmation-message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du bestätigst, setzt ShotPaste die App-Einstellungen auf ihre Standardwerte zurück. Gespeicherte Aufnahmen werden nicht gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you confirm, ShotPaste will reset app settings to their default values. Saved captures are not deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si confirmas, ShotPaste restablecerá los ajustes de la app a sus valores predeterminados. Las capturas guardadas no se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous confirmez, ShotPaste réinitialisera les réglages de l’app à leurs valeurs par défaut. Les captures enregistrées ne sont pas supprimées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認すると、ShotPaste はアプリ設定をデフォルト値にリセットします。保存済みのキャプチャは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인하면 ShotPaste가 앱 설정을 기본값으로 재설정합니다. 저장된 캡처는 삭제되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если подтвердить действие, ShotPaste сбросит настройки приложения до значений по умолчанию. Сохранённые снимки не удаляются."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu xác nhận, ShotPaste sẽ đặt lại cài đặt ứng dụng về giá trị mặc định. Ảnh và bản ghi đã lưu sẽ không bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认后，ShotPaste 会将应用设置重置为默认值。已保存的捕捉内容不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認後，ShotPaste 會將 App 設定重置為預設值。已儲存的擷取內容不會被刪除。"
          }
        }
      }
    },
    "preferences-advanced.restore-defaults-confirmation-title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardeinstellungen wiederherstellen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore default settings?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restaurar ajustes predeterminados?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer les réglages par défaut ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定をデフォルトに戻しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 설정을 복원할까요?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить настройки по умолчанию?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục cài đặt mặc định?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要恢复默认设置吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要恢復預設設定嗎？"
          }
        }
      }
    },
