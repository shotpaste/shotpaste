          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ShotPaste пока не удалось заблокировать сохраненное сшитое изображение. Вы можете продолжить съемку, попробовать «Готово» еще раз или «Отмена»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
