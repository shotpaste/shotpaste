    "permission.optional-global-shortcuts": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional für automatisches Scrollen und Kurzbefehle mit der Fn-Taste"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional for auto-scroll and shortcuts that use the Fn key"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional para el desplazamiento automático y los atajos que usan la tecla Fn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif pour le défilement automatique et les raccourcis utilisant la touche Fn"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動スクロールと Fn キーを使うショートカットで任意"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 스크롤 및 Fn 키를 사용하는 단축키에 선택 사항"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно для автопрокрутки и сочетаний с клавишей Fn"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn cho cuộn tự động và phím tắt dùng phím Fn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动滚动和使用 Fn 键的快捷键可选"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動捲動和使用 Fn 鍵的快速鍵可選"
          }
        }
      }
    },
