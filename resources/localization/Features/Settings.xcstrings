    "preferences-history.clear-history-alert-message": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will move all capture files to Trash and remove them from Clipboard History. This action cannot be undone in ShotPaste."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ chuyển toàn bộ file capture vào Thùng rác và xóa khỏi lịch sử bảng nhớ tạm. Không thể hoàn tác trong ShotPaste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Aufnahmedateien werden in den Papierkorb gelegt und aus dem Zwischenablageverlauf entfernt. Dies kann in ShotPaste nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se moverán todos los archivos de captura a la papelera y se quitarán del historial del portapapeles. Esta acción no se puede deshacer en ShotPaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les fichiers de capture seront déplacés vers la corbeille et retirés de l’historique du presse-papiers. Cette action est irréversible dans ShotPaste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのキャプチャファイルがゴミ箱に移動され、クリップボード履歴から削除されます。この操作は ShotPaste では取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 캡처 파일이 휴지통으로 이동되고 클립보드 기록에서 제거됩니다. 이 작업은 ShotPaste에서 되돌릴 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все файлы записей будут перемещены в корзину и удалены из истории буфера обмена. Это действие нельзя отменить в ShotPaste."
          }
        },
