    "app-identity.invalid-signature": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses App-Bundle besteht die Code-Signatur-Validierung von macOS nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app bundle does not pass macOS code-signature validation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este paquete de aplicaciones no pasa la validación de firma de código de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet ensemble d'applications ne réussit pas la validation de signature de code macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリ バンドルは macOS コード署名の検証に合格しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱 번들은 macOS 코드 서명 검증을 통과하지 못했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот пакет приложений не проходит проверку подписи кода macOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói ứng dụng này không vượt qua kiểm tra chữ ký mã của macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用程序包未通过 macOS 代码签名验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程序包未通過 macOS 代碼簽名驗證。"
          }
        }
      }
    },
    "app-identity.outside-applications": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie ShotPaste in /Applications, bevor Sie Berechtigungen erteilen. Aktueller Pfad: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install ShotPaste in /Applications before granting permissions. Current path: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale ShotPaste en /Aplicaciones antes de otorgar permisos. Ruta actual: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez ShotPaste dans /Applications avant d'accorder les autorisations. Chemin actuel : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限を付与する前に、/Applications に ShotPaste をインストールします。現在のパス: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한을 부여하기 전에 /Applications에 ShotPaste를 설치하세요. 현재 경로: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем предоставлять разрешения, установите ShotPaste в каталоге /Applications. Текущий путь: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cài ShotPaste trong /Applications trước khi cấp quyền. Đường dẫn hiện tại: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先将 ShotPaste 安装到 /Applications，再授予权限。当前路径：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先將 ShotPaste 安裝到 /Applications，再授予權限。目前路徑：%@"
          }
        }
      }
    },
    "app-identity.quarantined": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App hat immer noch die macOS-Quarantäne-Flagge. Führen Sie eine Neuinstallation mit dem Installationsskript durch oder entfernen Sie die Quarantäne, bevor Sie Berechtigungen erteilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app still has the macOS quarantine flag. Reinstall with the installer script or remove quarantine before granting permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aplicación todavía tiene la bandera de cuarentena de macOS. Vuelva a instalar con el script del instalador o elimine la cuarentena antes de otorgar permisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette application a toujours l'indicateur de quarantaine macOS. Réinstallez avec le script d'installation ou supprimez la quarantaine avant d'accorder les autorisations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリには macOS 隔離フラグがまだあります。インストーラー スクリプトを使用して再インストールするか、権限を付与する前に隔離を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에는 여전히 macOS 격리 플래그가 있습니다. 권한을 부여하기 전에 설치 프로그램 스크립트를 사용하여 다시 설치하거나 격리를 제거하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение все еще имеет флаг карантина macOS. Переустановите с помощью сценария установки или удалите карантин перед предоставлением разрешений."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng này vẫn còn cờ quarantine của macOS. Hãy cài lại bằng script cài đặt hoặc gỡ quarantine trước khi cấp quyền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用仍带有 macOS 隔离标记。请重新运行安装脚本，或先移除隔离标记再授予权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 仍帶有 macOS 隔離標記。請重新執行安裝腳本，或先移除隔離標記再授予權限。"
          }
        }
      }
    },
