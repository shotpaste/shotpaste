{
  "sourceLanguage": "en",
  "strings": {
    "agent.beta-badge": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"测试版"}}}},
    "agent.allow-application-session": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"本次会话允许此应用"}}}},
    "agent.answer-placeholder": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"输入你的回答"}}}},
    "agent.approval.unverified-target-title": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Unverifizierten Koordinatenklick bestätigen"}},"es":{"stringUnit":{"state":"translated","value":"Confirmar clic en coordenadas no verificadas"}},"fr":{"stringUnit":{"state":"translated","value":"Confirmer le clic sur des coordonnées non vérifiées"}},"ja":{"stringUnit":{"state":"translated","value":"未確認の座標クリックを承認"}},"ko":{"stringUnit":{"state":"translated","value":"확인되지 않은 좌표 클릭 승인"}},"ru":{"stringUnit":{"state":"translated","value":"Подтвердить непроверенный щелчок по координатам"}},"vi":{"stringUnit":{"state":"translated","value":"Xác nhận nhấp vào tọa độ chưa xác minh"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认未验证的坐标点击"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"確認未經驗證的座標點擊"}}}},
    "agent.approval.unverified-target-detail": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Agent-Modus möchte auf Koordinaten klicken, die keinem beobachteten Bedienungshilfen-Element zugeordnet werden konnten. Das Ziel kann lokal nicht überprüft werden."}},"es":{"stringUnit":{"state":"translated","value":"El modo Agente quiere hacer clic en coordenadas que no se pudieron asociar con un elemento de Accesibilidad observado. El destino no se puede verificar localmente."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode Agent souhaite cliquer sur des coordonnées qui n’ont pu être associées à aucun élément d’accessibilité observé. La cible ne peut pas être vérifiée localement."}},"ja":{"stringUnit":{"state":"translated","value":"Agent モードが、観察済みのアクセシビリティ要素と一致しない座標をクリックしようとしています。この対象はローカルで検証できません。"}},"ko":{"stringUnit":{"state":"translated","value":"Agent 모드가 관찰된 손쉬운 사용 요소와 일치하지 않는 좌표를 클릭하려고 합니다. 대상을 로컬에서 확인할 수 없습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Режим агента хочет выполнить щелчок по координатам, которые не удалось сопоставить с наблюдаемым элементом универсального доступа. Цель нельзя проверить локально."}},"vi":{"stringUnit":{"state":"translated","value":"Chế độ Agent muốn nhấp vào tọa độ không khớp với phần tử Trợ năng đã quan sát. Không thể xác minh mục tiêu cục bộ."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Agent 模式想点击无法与已观察辅助功能元素匹配的坐标。无法在本地验证该目标。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Agent 模式想點擊無法與已觀察輔助使用元素相符的座標。無法在本機驗證該目標。"}}}},
    "agent.activity.audit-note": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"展示可审计动作，不展示模型私有思维过程"}}}},
    "agent.activity.event.action-failed": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"动作失败"}}}},
    "agent.activity.event.action-succeeded": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"动作已完成"}}}},
    "agent.activity.event.approved": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"动作已批准"}}}},
    "agent.activity.event.completed": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"任务已完成"}}}},
    "agent.activity.event.denied": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"动作已拦截"}}}},
