    "agent.missing-api-key": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add an LLM API key in AI Features first"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先在“AI 功能”中添加 LLM API Key"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請先在「AI 功能」中加入 LLM API Key"}},"de":{"stringUnit":{"state":"translated","value":"Zuerst einen LLM-API-Schlüssel unter KI-Funktionen hinzufügen"}},"es":{"stringUnit":{"state":"translated","value":"Añade primero una clave API de LLM en Funciones de IA"}},"fr":{"stringUnit":{"state":"translated","value":"Ajoutez d’abord une clé API LLM dans Fonctions IA"}},"ja":{"stringUnit":{"state":"translated","value":"先に「AI機能」でLLM APIキーを追加してください"}},"ko":{"stringUnit":{"state":"translated","value":"먼저 AI 기능에서 LLM API 키를 추가하세요"}},"ru":{"stringUnit":{"state":"translated","value":"Сначала добавьте API-ключ LLM в разделе Функции ИИ"}},"vi":{"stringUnit":{"state":"translated","value":"Trước tiên hãy thêm khóa API LLM trong Tính năng AI"}}}},
    "agent.mode-description": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"理解意图，并在本地安全检查下操作 Mac"}}}},
    "agent.mode-disabled-status": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Agent Mode 已关闭"}}}},
    "agent.mode-enabled-status": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Agent Mode 已开启"}}}},
    "agent.mode-title": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Agent Mode"}}}},
    "agent.model-title": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"模型"}}}},
    "agent.open-permissions": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"打开权限设置"}}}},
    "agent.paused-by-user": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"检测到你使用鼠标或键盘，Agent 已暂停"}}}},
    "agent.permission-description": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"屏幕录制用于观察桌面，辅助功能用于执行语义动作"}}}},
