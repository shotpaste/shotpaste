<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WindowColor">#FFF6F7FB</Color>
  <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
  <Color x:Key="SurfaceSecondaryColor">#FFF1F4F9</Color>
  <Color x:Key="TextColor">#FF202534</Color>
  <Color x:Key="SecondaryTextColor">#FF606978</Color>
  <Color x:Key="ShadowColor">#FF000000</Color>

  <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
  <SolidColorBrush x:Key="HistoryHudBrush" Color="{StaticResource WindowColor}" Opacity="1" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondaryColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="#FFDCE1EA" />
  <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#FFEDF1F8" />
