    "recording.cloud.credentials-note": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved locally, like the LLM API key. Leave unchanged fields blank."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"与 LLM API Key 一样保存在本机；无需修改的凭证可留空。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"與 LLM API Key 一樣儲存在本機；無需修改的憑證可留空。"}},"de":{"stringUnit":{"state":"translated","value":"Wie der LLM-API-Schlüssel lokal gespeichert. Unveränderte Felder leer lassen."}},"es":{"stringUnit":{"state":"translated","value":"Se guardan localmente, como la clave API del LLM. Deja en blanco los campos sin cambios."}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrés localement comme la clé API du LLM. Laissez vides les champs inchangés."}},"ja":{"stringUnit":{"state":"translated","value":"LLM APIキーと同様にローカル保存します。変更しない項目は空欄のままにしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"LLM API 키처럼 로컬에 저장됩니다. 변경하지 않을 필드는 비워 두세요."}},"ru":{"stringUnit":{"state":"translated","value":"Хранятся локально, как API-ключ LLM. Неизменяемые поля оставьте пустыми."}},"vi":{"stringUnit":{"state":"translated","value":"Lưu cục bộ như khóa API LLM. Để trống các trường không cần đổi."}}}},
    "recording.cloud.account-title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Volcengine"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"火山引擎"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"火山引擎"}},"de":{"stringUnit":{"state":"translated","value":"Volcengine"}},"es":{"stringUnit":{"state":"translated","value":"Volcengine"}},"fr":{"stringUnit":{"state":"translated","value":"Volcengine"}},"ja":{"stringUnit":{"state":"translated","value":"Volcengine"}},"ko":{"stringUnit":{"state":"translated","value":"Volcengine"}},"ru":{"stringUnit":{"state":"translated","value":"Volcengine"}},"vi":{"stringUnit":{"state":"translated","value":"Volcengine"}}}},
