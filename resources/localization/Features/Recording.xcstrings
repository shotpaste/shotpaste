    "recording.cloud.test-connection": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Test connection"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"测试连接"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"測試連線"}},"de":{"stringUnit":{"state":"translated","value":"Verbindung testen"}},"es":{"stringUnit":{"state":"translated","value":"Probar conexión"}},"fr":{"stringUnit":{"state":"translated","value":"Tester la connexion"}},"ja":{"stringUnit":{"state":"translated","value":"接続をテスト"}},"ko":{"stringUnit":{"state":"translated","value":"연결 테스트"}},"ru":{"stringUnit":{"state":"translated","value":"Проверить подключение"}},"vi":{"stringUnit":{"state":"translated","value":"Kiểm tra kết nối"}}}},
    "recording.cloud.save-and-test": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save and test"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存并测试"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"儲存並測試"}},"de":{"stringUnit":{"state":"translated","value":"Speichern und testen"}},"es":{"stringUnit":{"state":"translated","value":"Guardar y probar"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrer et tester"}},"ja":{"stringUnit":{"state":"translated","value":"保存してテスト"}},"ko":{"stringUnit":{"state":"translated","value":"저장 및 테스트"}},"ru":{"stringUnit":{"state":"translated","value":"Сохранить и проверить"}},"vi":{"stringUnit":{"state":"translated","value":"Lưu và kiểm tra"}}}},
    "recording.cloud.key-placeholder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paste credential"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"粘贴凭证"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"貼上憑證"}},"de":{"stringUnit":{"state":"translated","value":"Zugangsdaten einfügen"}},"es":{"stringUnit":{"state":"translated","value":"Pegar credencial"}},"fr":{"stringUnit":{"state":"translated","value":"Coller un identifiant"}},"ja":{"stringUnit":{"state":"translated","value":"認証情報を貼り付け"}},"ko":{"stringUnit":{"state":"translated","value":"자격 증명 붙여넣기"}},"ru":{"stringUnit":{"state":"translated","value":"Вставьте ключ"}},"vi":{"stringUnit":{"state":"translated","value":"Dán thông tin xác thực"}}}},
    "recording.cloud.secret-key": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"TOS Secret Access Key"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"TOS Secret Access Key"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"TOS Secret Access Key"}},"de":{"stringUnit":{"state":"translated","value":"TOS Secret Access Key"}},"es":{"stringUnit":{"state":"translated","value":"TOS Secret Access Key"}},"fr":{"stringUnit":{"state":"translated","value":"TOS Secret Access Key"}},"ja":{"stringUnit":{"state":"translated","value":"TOS Secret Access Key"}},"ko":{"stringUnit":{"state":"translated","value":"TOS Secret Access Key"}},"ru":{"stringUnit":{"state":"translated","value":"TOS Secret Access Key"}},"vi":{"stringUnit":{"state":"translated","value":"TOS Secret Access Key"}}}},
