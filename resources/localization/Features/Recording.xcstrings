    "recording.restart-confirmation-message": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die aktuelle Aufnahme wird in den Papierkorb verschoben und mit denselben Einstellungen neu gestartet." } },
        "en": { "stringUnit": { "state": "translated", "value": "The current recording will be moved to Trash and a new recording will start with the same settings." } },
        "es": { "stringUnit": { "state": "translated", "value": "La grabación actual se moverá a la Papelera y comenzará una nueva con los mismos ajustes." } },
        "fr": { "stringUnit": { "state": "translated", "value": "L’enregistrement en cours sera placé dans la corbeille et un nouvel enregistrement démarrera avec les mêmes réglages." } },
        "ja": { "stringUnit": { "state": "translated", "value": "現在の収録をゴミ箱に移動し、同じ設定で新しい収録を開始します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "현재 녹화를 휴지통으로 이동하고 같은 설정으로 새 녹화를 시작합니다." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Текущая запись будет перемещена в Корзину, после чего начнётся новая запись с теми же настройками." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Bản ghi hiện tại sẽ được chuyển vào Thùng rác và bản ghi mới sẽ bắt đầu với cùng cài đặt." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前录制将移到废纸篓，并使用相同设置开始新的录制。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "目前錄製將移到垃圾桶，並使用相同設定開始新的錄製。" } }
      }
    },
