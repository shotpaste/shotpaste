    "file-access.desktop-pictures-access-message" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie den Ordner „Desktop-Bilder“ aus, um Zugriff zu gewähren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select the Desktop Pictures folder to grant access"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccione la carpeta Imágenes del escritorio para otorgar acceso"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez le dossier Desktop Pictures pour accorder l'accès"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスを許可するには、デスクトップ ピクチャ フォルダを選択します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "액세스 권한을 부여하려면 Desktop Pictures 폴더를 선택하세요"
          }
        },
        "ru" : {
