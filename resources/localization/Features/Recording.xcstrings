    "recording.transcription.error-connection": {
        "localizations": {
            "en": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Could not connect to Volcengine simultaneous interpretation. Check the network, credentials, model access, and invite-only service entitlement."
                }
            },
            "de": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Keine Verbindung zum Volcengine-Simultandolmetschen möglich. Prüfen Sie Netzwerk, Anmeldedaten, Modellzugriff und die Freischaltung des Einladungsdienstes."
                }
            },
            "es": {
                "stringUnit": {
                    "state": "translated",
