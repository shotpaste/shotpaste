<Window x:Class="LiteScreen.Windows.Views.RecordingInkToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight">
  <Border CornerRadius="10" Background="#F2202024" BorderBrush="#45FFFFFF" BorderThickness="1"
          Padding="8" MouseLeftButtonDown="OnWindowMouseDown">
    <StackPanel>
      <DockPanel Margin="2,0,0,6">
        <TextBlock Text="录屏标注" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right" Content="×" Click="OnClose" Width="24" Height="22" Padding="0"
                Margin="8,-2,-2,-2" ToolTip="关闭标注"/>
      </DockPanel>
      <WrapPanel x:Name="ToolPanel" MaxWidth="420">
        <Button Tag="Selection" Content="选择" Click="OnTool" Margin="0,0,4,4" Padding="7,3" MinHeight="24"/>
        <Button Tag="Rectangle" Content="矩形" Click="OnTool" Margin="0,0,4,4" Padding="7,3" MinHeight="24"/>
        <Button Tag="Oval" Content="椭圆" Click="OnTool" Margin="0,0,4,4" Padding="7,3" MinHeight="24"/>
        <Button Tag="Arrow" Content="箭头" Click="OnTool" Margin="0,0,4,4" Padding="7,3" MinHeight="24"/>
        <Button Tag="Line" Content="直线" Click="OnTool" Margin="0,0,4,4" Padding="7,3" MinHeight="24"/>
        <Button Tag="Pencil" Content="铅笔" Click="OnTool" Margin="0,0,4,4" Padding="7,3" MinHeight="24"/>
        <Button Tag="Highlighter" Content="荧光笔" Click="OnTool" Margin="0,0,4,4" Padding="7,3" MinHeight="24"/>
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
        <Button Tag="#FFFF453A" Background="#FFFF453A" Width="22" Height="22" Padding="0" Click="OnColor" Margin="0,0,4,0"/>
        <Button Tag="#FFFFC400" Background="#FFFFC400" Width="22" Height="22" Padding="0" Click="OnColor" Margin="0,0,4,0"/>
        <Button Tag="#FF30D158" Background="#FF30D158" Width="22" Height="22" Padding="0" Click="OnColor" Margin="0,0,4,0"/>
        <Button Tag="#FF0A84FF" Background="#FF0A84FF" Width="22" Height="22" Padding="0" Click="OnColor" Margin="0,0,8,0"/>
        <TextBlock Text="粗细" Foreground="#DFFFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <Slider x:Name="WidthSlider" Minimum="1" Maximum="20" Value="4" Width="72" VerticalAlignment="Center" ValueChanged="OnWidthChanged"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
        <ComboBox x:Name="ClearModePicker" Width="104" Height="26" SelectionChanged="OnClearModeChanged">
          <ComboBoxItem Content="手动清除" Tag="Manual"/>
          <ComboBoxItem Content="定时清除" Tag="AfterSeconds"/>
          <ComboBoxItem Content="按笔数清除" Tag="MaximumCount"/>
        </ComboBox>
        <TextBox x:Name="ClearValueBox" Width="42" Height="26" Margin="5,0,0,0"
                 VerticalContentAlignment="Center" TextChanged="OnClearValueChanged"/>
        <TextBlock x:Name="ClearValueUnit" Foreground="#BFFFFFFF" VerticalAlignment="Center" Margin="4,0,0,0"/>
        <Button Content="撤销" Click="OnUndo" Margin="7,0,0,0" Padding="8,3" MinHeight="26"/>
        <Button Content="清空" Click="OnClear" Margin="5,0,0,0" Padding="8,3" MinHeight="26"/>
      </StackPanel>
      <CheckBox x:Name="FadeCheckBox" Content="到期前淡出" Foreground="White" VerticalAlignment="Center"
                Checked="OnFadeChanged" Unchecked="OnFadeChanged" Margin="2,5,0,0"/>
      <TextBlock Text="清除策略按当前工具保存 · 工具面板不会进入成片 · Esc 清空 · Ctrl+Z 撤销"
                 Foreground="#BFFFFFFF" FontSize="10" Margin="2,6,0,0"/>
    </StackPanel>
  </Border>
</Window>
