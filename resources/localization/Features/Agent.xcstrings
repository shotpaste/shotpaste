    "agent.send-images-description": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Steuert nur die von Agent Mode gesendeten Screenshots; die Textübersetzung bleibt davon unberührt."}},"en":{"stringUnit":{"state":"translated","value":"Controls screenshots sent by Agent Mode only; it does not control text translation."}},"es":{"stringUnit":{"state":"translated","value":"Solo controla las capturas que envía Agent Mode; no controla la traducción de texto."}},"fr":{"stringUnit":{"state":"translated","value":"Contrôle uniquement les captures envoyées par Agent Mode ; ne contrôle pas la traduction de texte."}},"ja":{"stringUnit":{"state":"translated","value":"Agent Mode が送信するスクリーンショットだけを制御します。テキスト翻訳には影響しません。"}},"ko":{"stringUnit":{"state":"translated","value":"Agent Mode가 보내는 스크린샷만 제어하며 텍스트 번역에는 영향을 주지 않습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Управляет только снимками, отправляемыми Agent Mode; не влияет на перевод текста."}},"vi":{"stringUnit":{"state":"translated","value":"Chỉ kiểm soát ảnh Agent Mode gửi; không ảnh hưởng đến dịch văn bản."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅控制 Agent Mode 发送的截图；不控制文本翻译。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"僅控制 Agent Mode 傳送的截圖；不控制文字翻譯。"}}}},
