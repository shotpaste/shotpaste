<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Config\AppVariant.$(Configuration).props"
          Condition="Exists('Config\AppVariant.$(Configuration).props')" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>$(ShotPasteApplicationManifest)</ApplicationManifest>
    <ApplicationIcon>$(ShotPasteApplicationIcon)</ApplicationIcon>
    <AssemblyName>$(ShotPasteAssemblyName)</AssemblyName>
    <AssemblyTitle>$(ShotPasteDisplayName)</AssemblyTitle>
    <RootNamespace>ShotPaste.Windows</RootNamespace>
    <Version>1.12.1</Version>
    <AssemblyVersion>1.12.1.0</AssemblyVersion>
    <FileVersion>1.12.1.0</FileVersion>
    <Product>$(ShotPasteDisplayName)</Product>
    <Description>Lightweight screenshot, annotation, OCR, scrolling capture, and screen recording tool.</Description>
    <Authors>ShotPaste</Authors>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <Reference Include="ScreenRecorderLib" Condition="'$(Platform)' == 'x64'">
      <HintPath>$(NuGetPackageRoot)screenrecorderlib\6.6.0\build\x64\ScreenRecorderLib.dll</HintPath>
      <Private>true</Private>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Reference>
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ShotPasteVariant" Value="$(ShotPasteVariant)" />
    <AssemblyMetadata Include="ShotPasteDisplayName" Value="$(ShotPasteDisplayName)" />
    <AssemblyMetadata Include="ShotPasteExecutableName" Value="$(ShotPasteExecutableName)" />
    <AssemblyMetadata Include="ShotPasteUrlScheme" Value="$(ShotPasteUrlScheme)" />
    <AssemblyMetadata Include="ShotPasteNativeManifestIdentity" Value="$(ShotPasteNativeManifestIdentity)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\..\..\assets\shotpaste-icon.png"
              Link="Assets\shotpaste-icon.png"
              Condition="'$(ShotPasteVariant)' == 'release'" />
    <Resource Include="Assets\shotpaste-debug-icon.png"
              Link="Assets\shotpaste-icon.png"
              Condition="'$(ShotPasteVariant)' == 'debug'" />
    <EmbeddedResource Include="..\..\..\..\resources\localization\**\*.xcstrings"
                      Link="Localization\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\WindowsLocalization.*.json">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="ValidateShotPasteBuildIdentity" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ShotPasteVariant)' == ''"
           Text="Configuration '$(Configuration)' has no canonical ShotPaste app variant." />
    <Error Condition="'$(ShotPasteAssemblyName)' == '' Or '$(ShotPasteDisplayName)' == '' Or '$(ShotPasteExecutableName)' == '' Or '$(ShotPasteUrlScheme)' == '' Or '$(ShotPasteNativeManifestIdentity)' == '' Or '$(ShotPasteApplicationManifest)' == '' Or '$(ShotPasteApplicationIcon)' == ''"
           Text="The canonical ShotPaste app variant is incomplete for configuration '$(Configuration)'." />
    <Error Condition="'$(ShotPasteExecutableName)' != '$(ShotPasteAssemblyName).exe'"
           Text="ShotPaste executable identity '$(ShotPasteExecutableName)' does not match assembly '$(ShotPasteAssemblyName)'." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\$(ShotPasteApplicationManifest)')"
           Text="ShotPaste manifest '$(ShotPasteApplicationManifest)' does not exist." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\$(ShotPasteApplicationIcon)')"
           Text="ShotPaste application icon '$(ShotPasteApplicationIcon)' does not exist." />
  </Target>

  <Target Name="ExcludeReleaseSymbolsFromPublish"
          AfterTargets="ComputeFilesToPublish"
          BeforeTargets="CopyFilesToPublishDirectory"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_ExistingReleasePublishSymbols Include="$(PublishDir)**\*.pdb" />
      <_ReleasePublishSymbols Include="@(ResolvedFileToPublish)"
                              Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(_ReleasePublishSymbols)" />
    </ItemGroup>
    <Delete Files="@(_ExistingReleasePublishSymbols)" />
    <Message Importance="High"
             Condition="'@(_ReleasePublishSymbols)' != '' Or '@(_ExistingReleasePublishSymbols)' != ''"
             Text="Excluding Release debug symbols from publish: @(_ReleasePublishSymbols->'%(Filename)%(Extension)', ', ')" />
  </Target>
</Project>
