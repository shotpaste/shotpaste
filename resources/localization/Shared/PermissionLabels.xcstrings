    "permission.screen-recording-finish-in-settings": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie ShotPaste in den Systemeinstellungen und kehren Sie dann hierher zurück. macOS fordert Sie möglicherweise auf, die App erneut zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on ShotPaste in System Settings, then return here. macOS may ask you to reopen the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ShotPaste en Ajustes del Sistema y vuelva aquí. macOS puede pedirle que abra de nuevo la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez ShotPaste dans Réglages Système, puis revenez ici. macOS peut vous demander de rouvrir l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で ShotPaste をオンにしてから、ここに戻ってください。macOS からアプリを開き直すよう求められる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 ShotPaste를 켠 다음 여기로 돌아오세요. macOS에서 앱을 다시 열도록 요청할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите ShotPaste в Системных настройках и вернитесь сюда. macOS может попросить заново открыть приложение."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật ShotPaste trong Cài đặt hệ thống rồi quay lại đây. macOS có thể yêu cầu bạn mở lại ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中开启 ShotPaste，然后返回此处。macOS 可能会要求你重新打开应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定中開啟 ShotPaste，然後返回此處。macOS 可能會要求你重新開啟 App。"
          }
        }
      }
    },
    "permission.unavailable": {
