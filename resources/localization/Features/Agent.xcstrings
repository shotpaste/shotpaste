    "agent.translation-prompt-mode-description": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sicherheits- und Antwortformatregeln werden immer erzwungen."}},"en":{"stringUnit":{"state":"translated","value":"The safety and response-format rules are always enforced."}},"es":{"stringUnit":{"state":"translated","value":"Las reglas de seguridad y formato de respuesta siempre se aplican."}},"fr":{"stringUnit":{"state":"translated","value":"Les règles de sécurité et de format de réponse sont toujours appliquées."}},"ja":{"stringUnit":{"state":"translated","value":"安全および応答形式のルールは常に適用されます。"}},"ko":{"stringUnit":{"state":"translated","value":"안전 및 응답 형식 규칙은 항상 적용됩니다."}},"ru":{"stringUnit":{"state":"translated","value":"Правила безопасности и формата ответа применяются всегда."}},"vi":{"stringUnit":{"state":"translated","value":"Các quy tắc an toàn và định dạng phản hồi luôn được áp dụng."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安全和响应格式规则始终强制执行。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安全與回應格式規則一律強制執行。"}}}},
