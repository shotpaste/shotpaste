    "recording.save-location-access-required-message": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ShotPaste benötigt eine Zugriffsberechtigung für den Speicherordner, um fortzufahren. Bitte wählen Sie einen Speicherordner unter „Einstellungen → Allgemein“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ShotPaste needs a save folder permission to continue. Please choose a save folder in Preferences → General."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ShotPaste necesita permiso para acceder a la carpeta de guardado para continuar. Elija una carpeta de guardado en Preferencias → General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ShotPaste a besoin d'une autorisation d'accès au dossier de sauvegarde pour continuer. Veuillez choisir un dossier dans Préférences → Général."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行するには ShotPaste に保存フォルダへのアクセス権限が必要です。「環境設定 → 一般」で保存フォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 ShotPaste에 저장 폴더 접근 권한이 필요합니다. 환경 설정 → 일반에서 저장 폴더를 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы продолжить, ShotPaste требуется доступ к папке сохранения. Выберите папку сохранения в «Настройки → Основные»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ShotPaste cần quyền truy cập thư mục lưu để tiếp tục. Hãy chọn thư mục lưu trong Tùy chọn → Chung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ShotPaste 需要访问保存文件夹才能继续。请在“偏好设置 → 通用”中选择保存文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ShotPaste 需要存取儲存資料夾才能繼續。請在「偏好設定 → 一般」中選擇儲存資料夾。"
          }
        }
      }
    },
