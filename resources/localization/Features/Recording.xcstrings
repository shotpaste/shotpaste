    "recording.transcription.privacy-description": {
        "localizations": {
            "en": {
                "stringUnit": {
                    "state": "translated",
                    "value": "After a recording with audio ends, its audio is sent to Volcengine automatically. Video frames are never uploaded. The transcript stays in memory until you explicitly copy or save it."
                }
            },
            "de": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Nach dem Ende einer Aufnahme mit Ton wird nur die Audiospur automatisch an Volcengine gesendet. Videobilder werden nie hochgeladen. Das Transkript bleibt im Speicher, bis Sie es ausdrücklich kopieren oder speichern."
                }
            },
            "es": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Al terminar una grabación con audio, la pista de audio se envía automáticamente a Volcengine. Los fotogramas de vídeo nunca se suben. La transcripción permanece en memoria hasta que la copies o guardes explícitamente."
                }
            },
            "fr": {
                "stringUnit": {
                    "state": "translated",
                    "value": "À la fin d’un enregistrement avec du son, sa piste audio est envoyée automatiquement à Volcengine. Les images vidéo ne sont jamais téléversées. La transcription reste en mémoire jusqu’à ce que vous la copiiez ou l’enregistriez explicitement."
                }
            },
            "ja": {
                "stringUnit": {
                    "state": "translated",
                    "value": "音声付きの録画が終了すると、音声トラックだけが Volcengine に自動送信されます。映像フレームはアップロードされません。文字起こしは明示的にコピーまたは保存するまでメモリ内にだけ保持されます。"
                }
            },
            "ko": {
                "stringUnit": {
                    "state": "translated",
                    "value": "오디오가 포함된 녹화가 끝나면 오디오 트랙만 Volcengine으로 자동 전송됩니다. 비디오 프레임은 업로드되지 않습니다. 녹취록은 명시적으로 복사하거나 저장할 때까지 메모리에만 유지됩니다."
                }
            },
            "ru": {
                "stringUnit": {
                    "state": "translated",
                    "value": "После завершения записи со звуком аудиодорожка автоматически отправляется в Volcengine. Кадры видео никогда не загружаются. Расшифровка остается в памяти, пока вы явно не скопируете или не сохраните ее."
                }
            },
            "vi": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Sau khi bản ghi có âm thanh kết thúc, chỉ bản âm thanh được tự động gửi đến Volcengine. Khung hình video không bao giờ được tải lên. Bản chép lời chỉ nằm trong bộ nhớ cho đến khi bạn chủ động sao chép hoặc lưu."
                }
            },
            "zh-Hans": {
                "stringUnit": {
                    "state": "translated",
                    "value": "带音频的录屏结束后，音轨会自动发送到火山引擎。绝不会上传视频画面；文字稿只在你明确复制或保存后持久化。"
                }
            },
            "zh-Hant": {
                "stringUnit": {
                    "state": "translated",
                    "value": "含音訊的螢幕錄影結束後，音軌會自動傳送到火山引擎。絕不會上傳影片畫面；逐字稿只會在你明確複製或儲存後持久化。"
                }
            }
        }
    },
    "recording.transcription.credential-save-failed": {
        "localizations": {
            "en": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Could not save the API Key securely. Check the credential and try again."
                }
            },
            "de": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Der API-Schlüssel konnte nicht sicher gespeichert werden. Prüfen Sie die Anmeldedaten und versuchen Sie es erneut."
                }
            },
            "es": {
                "stringUnit": {
                    "state": "translated",
                    "value": "No se pudo guardar la clave de API de forma segura. Revisa la credencial e inténtalo de nuevo."
                }
            },
            "fr": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Impossible d’enregistrer la clé API de manière sécurisée. Vérifiez l’identifiant et réessayez."
                }
            },
            "ja": {
                "stringUnit": {
                    "state": "translated",
                    "value": "API Key を安全に保存できませんでした。認証情報を確認してもう一度お試しください。"
                }
            },
            "ko": {
                "stringUnit": {
                    "state": "translated",
                    "value": "API 키를 안전하게 저장할 수 없습니다. 자격 증명을 확인하고 다시 시도하세요."
                }
            },
            "ru": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Не удалось безопасно сохранить ключ API. Проверьте учетные данные и повторите попытку."
                }
            },
            "vi": {
                "stringUnit": {
                    "state": "translated",
                    "value": "Không thể lưu khóa API an toàn. Hãy kiểm tra thông tin xác thực rồi thử lại."
                }
            },
            "zh-Hans": {
                "stringUnit": {
                    "state": "translated",
                    "value": "无法安全保存 API Key，请检查凭证后重试。"
                }
            },
            "zh-Hant": {
                "stringUnit": {
                    "state": "translated",
                    "value": "無法安全儲存 API Key，請檢查憑證後再試一次。"
                }
            }
        }
    },
