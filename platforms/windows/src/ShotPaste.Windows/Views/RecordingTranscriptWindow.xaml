<Window x:Class="ShotPaste.Windows.Views.RecordingTranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ShotPaste.Windows.Controls"
        Title="ShotPaste · 录屏文字稿" Width="720" Height="520" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AutomationProperties.AutomationId="RecordingTranscriptWindow">
  <Grid Background="{DynamicResource WindowBackdropBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <controls:WindowTitleBar/>
    <Grid Grid.Row="1" Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
          <ContentControl Content="{StaticResource Icon.Ocr}" ContentTemplate="{StaticResource Icon.Template}"
                          Foreground="{DynamicResource AccentBrush}" Width="22" Height="22"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="HeadingText" Text="正在生成文字稿" FontSize="17" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}"/>
          <TextBlock x:Name="DescriptionText" Text="ShotPaste 正在使用火山引擎转写录屏音轨。"
                     Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1" Margin="0,16,0,12">
        <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True"/>
        <TextBlock x:Name="PrivacyText" Text="只发送音轨，不上传视频画面；处理时长大致等于录屏播放时长。"
                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>

      <Grid Grid.Row="2">
        <TextBox x:Name="TranscriptText" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="13"
                 Visibility="Collapsed" AutomationProperties.AutomationId="RecordingTranscriptText"/>
        <Border x:Name="ErrorPanel" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16" Visibility="Collapsed">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
            <ContentControl Content="{StaticResource Icon.Warning}" ContentTemplate="{StaticResource Icon.Template}"
                            Foreground="{DynamicResource WarningBrush}" Width="28" Height="28"/>
            <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextBrush}" AutomationProperties.AutomationId="RecordingTranscriptError"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="3" Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="10" TextWrapping="Wrap"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="关闭" Click="OnClose" AutomationProperties.AutomationId="RecordingTranscriptClose"/>
          <Button x:Name="CopyButton" Content="复制文字稿" Click="OnCopy" IsEnabled="False" Margin="8,0,0,0"
                  AutomationProperties.AutomationId="RecordingTranscriptCopy"/>
          <Button x:Name="SaveButton" Content="保存文字稿" Click="OnSave" IsEnabled="False" Margin="8,0,0,0"
                  AutomationProperties.AutomationId="RecordingTranscriptSave"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
