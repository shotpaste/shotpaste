{
  "sourceLanguage": "en",
  "strings": {
    "audio-recording.discard-confirm": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Discard the current audio recording?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"丢弃当前录音？"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"捨棄目前錄音？"}},"de":{"stringUnit":{"state":"translated","value":"Aktuelle Audioaufnahme verwerfen?"}},"es":{"stringUnit":{"state":"translated","value":"¿Descartar la grabación de audio actual?"}},"fr":{"stringUnit":{"state":"translated","value":"Abandonner l’enregistrement audio actuel ?"}},"ja":{"stringUnit":{"state":"translated","value":"現在の音声録音を破棄しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"현재 오디오 녹음을 삭제할까요?"}},"ru":{"stringUnit":{"state":"translated","value":"Удалить текущую аудиозапись?"}},"vi":{"stringUnit":{"state":"translated","value":"Hủy bản ghi âm hiện tại?"}}}},
    "audio-recording.windows-privacy-disclosure": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Transcription sends selected audio to your Volcengine account. AI processing sends transcript text to your configured provider."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转写会将所选音频发送至你的火山引擎账户；AI 处理会将文字稿发送至你配置的服务。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"轉錄會將所選音訊傳送至你的火山引擎帳戶；AI 處理會將文字稿傳送至你設定的服務。"}},"de":{"stringUnit":{"state":"translated","value":"Die Transkription sendet ausgewähltes Audio an dein Volcengine-Konto. Die KI-Verarbeitung sendet den Transkripttext an deinen konfigurierten Anbieter."}},"es":{"stringUnit":{"state":"translated","value":"La transcripción envía el audio seleccionado a tu cuenta de Volcengine. El procesamiento con IA envía el texto al proveedor configurado."}},"fr":{"stringUnit":{"state":"translated","value":"La transcription envoie l’audio sélectionné à votre compte Volcengine. Le traitement IA envoie le texte au fournisseur configuré."}},"ja":{"stringUnit":{"state":"translated","value":"文字起こしでは選択した音声をVolcengineアカウントに送信します。AI処理では文字起こしテキストを設定したプロバイダーに送信します。"}},"ko":{"stringUnit":{"state":"translated","value":"받아쓰기는 선택한 오디오를 Volcengine 계정으로 전송합니다. AI 처리는 받아쓰기 텍스트를 설정한 제공업체로 전송합니다."}},"ru":{"stringUnit":{"state":"translated","value":"Для расшифровки выбранное аудио отправляется в ваш аккаунт Volcengine. Для обработки ИИ текст отправляется настроенному провайдеру."}},"vi":{"stringUnit":{"state":"translated","value":"Chép lời gửi âm thanh đã chọn đến tài khoản Volcengine của bạn. Xử lý AI gửi văn bản chép lời đến nhà cung cấp đã cấu hình."}}}},
    "recording.transcription.requires-audio": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Transcription needs MP4 with system audio or microphone enabled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转写需要选择 MP4，并开启系统音频或麦克风。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"轉寫需要選擇 MP4，並開啟系統音訊或麥克風。"}},"de":{"stringUnit":{"state":"translated","value":"Für die Transkription MP4 wählen und Systemaudio oder Mikrofon aktivieren."}},"es":{"stringUnit":{"state":"translated","value":"Para transcribir, elige MP4 y activa el audio del sistema o el micrófono."}},"fr":{"stringUnit":{"state":"translated","value":"Pour transcrire, choisissez MP4 et activez l’audio système ou le microphone."}},"ja":{"stringUnit":{"state":"translated","value":"文字起こしにはMP4を選択し、システム音声またはマイクを有効にしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"전사하려면 MP4를 선택하고 시스템 오디오 또는 마이크를 켜세요."}},"ru":{"stringUnit":{"state":"translated","value":"Для транскрипции выберите MP4 и включите системный звук или микрофон."}},"vi":{"stringUnit":{"state":"translated","value":"Để chép lời, chọn MP4 và bật âm thanh hệ thống hoặc micrô."}}}},
    "recording.cloud.invalid-configuration": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter your credentials in AI Features → AI Transcription, then save and test the connection."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请在“AI 功能 → AI 转写”填写凭证，保存并测试连接。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請在「AI 功能 → AI 轉寫」填寫憑證，儲存並測試連線。"}},"de":{"stringUnit":{"state":"translated","value":"Zugangsdaten unter KI-Funktionen → KI-Transkription eingeben, speichern und testen."}},"es":{"stringUnit":{"state":"translated","value":"Introduce las credenciales en Funciones de IA → Transcripción con IA, guarda y prueba la conexión."}},"fr":{"stringUnit":{"state":"translated","value":"Saisissez les identifiants dans Fonctions IA → Transcription IA, puis enregistrez et testez la connexion."}},"ja":{"stringUnit":{"state":"translated","value":"「AI機能 → AI文字起こし」で認証情報を入力し、保存して接続をテストしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"AI 기능 → AI 전사에서 자격 증명을 입력하고 저장 및 연결 테스트를 하세요."}},"ru":{"stringUnit":{"state":"translated","value":"Введите ключи в Функции ИИ → ИИ-транскрипция, сохраните и проверьте подключение."}},"vi":{"stringUnit":{"state":"translated","value":"Nhập thông tin xác thực trong Tính năng AI → Chép lời AI, rồi lưu và kiểm tra kết nối."}}}},
    "recording.cloud.testing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Testing transcription with a public sample…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在用公开音频测试转写…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在以公開音訊測試轉寫…"}},"de":{"stringUnit":{"state":"translated","value":"Transkription mit öffentlichem Beispiel wird getestet…"}},"es":{"stringUnit":{"state":"translated","value":"Probando transcripción con una muestra pública…"}},"fr":{"stringUnit":{"state":"translated","value":"Test de transcription avec un échantillon public…"}},"ja":{"stringUnit":{"state":"translated","value":"公開音声で文字起こしをテスト中…"}},"ko":{"stringUnit":{"state":"translated","value":"공개 오디오로 전사 테스트 중…"}},"ru":{"stringUnit":{"state":"translated","value":"Проверка транскрипции на открытом образце…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang kiểm tra chép lời bằng mẫu công khai…"}}}},
    "recording.cloud.connecting": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Configuring private storage…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在配置私有存储…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在設定私有儲存…"}},"de":{"stringUnit":{"state":"translated","value":"Privater Speicher wird eingerichtet…"}},"es":{"stringUnit":{"state":"translated","value":"Configurando almacenamiento privado…"}},"fr":{"stringUnit":{"state":"translated","value":"Configuration du stockage privé…"}},"ja":{"stringUnit":{"state":"translated","value":"非公開ストレージを設定中…"}},"ko":{"stringUnit":{"state":"translated","value":"비공개 저장소 설정 중…"}},"ru":{"stringUnit":{"state":"translated","value":"Настройка закрытого хранилища…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang cấu hình bộ nhớ riêng…"}}}},
    "recording.cloud.automatic-note": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Audio recording options are chosen when starting a recording."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"单独录音的转写选项在开始录音时选择。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"獨立錄音的轉寫選項在開始錄音時選擇。"}},"de":{"stringUnit":{"state":"translated","value":"Optionen für reine Audioaufnahmen werden beim Aufnahmestart gewählt."}},"es":{"stringUnit":{"state":"translated","value":"Las opciones de grabación de audio se eligen al iniciar la grabación."}},"fr":{"stringUnit":{"state":"translated","value":"Les options de transcription audio se choisissent au début de l’enregistrement."}},"ja":{"stringUnit":{"state":"translated","value":"音声のみの録音設定は録音開始時に選択します。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 녹음 전사 옵션은 녹음 시작 시 선택합니다."}},"ru":{"stringUnit":{"state":"translated","value":"Параметры аудиозаписи выбираются при её запуске."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn tùy chọn chép lời khi bắt đầu ghi âm riêng."}}}},
    "recording.cloud.ai-note": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uses the LLM settings above to organize screen-recording transcripts."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用上方的 LLM 配置整理录屏文字稿。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用上方的 LLM 設定整理螢幕錄影文字稿。"}},"de":{"stringUnit":{"state":"translated","value":"Nutzt die obigen LLM-Einstellungen für Transkripte von Bildschirmaufnahmen."}},"es":{"stringUnit":{"state":"translated","value":"Usa la configuración LLM anterior para organizar las transcripciones de grabaciones de pantalla."}},"fr":{"stringUnit":{"state":"translated","value":"Utilise les réglages LLM ci-dessus pour organiser les transcriptions de captures vidéo."}},"ja":{"stringUnit":{"state":"translated","value":"上のLLM設定で画面録画の文字起こしを整理します。"}},"ko":{"stringUnit":{"state":"translated","value":"위 LLM 설정으로 화면 녹화 전사문을 정리합니다."}},"ru":{"stringUnit":{"state":"translated","value":"Использует настройки LLM выше для обработки текста записей экрана."}},"vi":{"stringUnit":{"state":"translated","value":"Dùng cấu hình LLM ở trên để xử lý bản chép lời ghi màn hình."}}}},
    "recording.cloud.process-after-transcription": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Process transcript with AI"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转写后使用 AI 整理"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"轉寫後使用 AI 整理"}},"de":{"stringUnit":{"state":"translated","value":"Transkript mit KI bearbeiten"}},"es":{"stringUnit":{"state":"translated","value":"Procesar transcripción con IA"}},"fr":{"stringUnit":{"state":"translated","value":"Traiter la transcription avec l’IA"}},"ja":{"stringUnit":{"state":"translated","value":"文字起こし後にAIで整理"}},"ko":{"stringUnit":{"state":"translated","value":"전사 후 AI로 정리"}},"ru":{"stringUnit":{"state":"translated","value":"Обработать текст с ИИ"}},"vi":{"stringUnit":{"state":"translated","value":"Xử lý bản chép lời bằng AI"}}}},
    "recording.cloud.storage-console": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Storage console"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"存储控制台"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"儲存控制台"}},"de":{"stringUnit":{"state":"translated","value":"Speicherkonsole"}},"es":{"stringUnit":{"state":"translated","value":"Consola de almacenamiento"}},"fr":{"stringUnit":{"state":"translated","value":"Console de stockage"}},"ja":{"stringUnit":{"state":"translated","value":"ストレージコンソール"}},"ko":{"stringUnit":{"state":"translated","value":"스토리지 콘솔"}},"ru":{"stringUnit":{"state":"translated","value":"Консоль хранилища"}},"vi":{"stringUnit":{"state":"translated","value":"Bảng điều khiển lưu trữ"}}}},
    "recording.cloud.storage-note": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Private storage in Beijing is set up automatically. Audio is deleted after transcription; remaining files expire after 2 days."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认自动配置北京私有存储。转写后删除云端音频，残留文件在 2 天后过期清理。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"預設自動設定北京私有儲存。轉寫後刪除雲端音訊，殘留檔案於 2 天後到期清理。"}},"de":{"stringUnit":{"state":"translated","value":"Privater Speicher in Peking wird automatisch eingerichtet. Audio wird nach der Transkription gelöscht; Restdateien verfallen nach 2 Tagen."}},"es":{"stringUnit":{"state":"translated","value":"Se configura automáticamente almacenamiento privado en Pekín. El audio se elimina tras transcribir; los archivos restantes caducan a los 2 días."}},"fr":{"stringUnit":{"state":"translated","value":"Un stockage privé à Pékin est configuré automatiquement. L’audio est supprimé après transcription ; les fichiers restants expirent après 2 jours."}},"ja":{"stringUnit":{"state":"translated","value":"北京の非公開ストレージを自動設定します。文字起こし後に音声を削除し、残ったファイルは2日後に期限切れとなります。"}},"ko":{"stringUnit":{"state":"translated","value":"베이징 비공개 저장소를 자동 설정합니다. 전사 후 오디오를 삭제하며 남은 파일은 2일 후 만료됩니다."}},"ru":{"stringUnit":{"state":"translated","value":"Закрытое хранилище в Пекине настраивается автоматически. Аудио удаляется после транскрипции, оставшиеся файлы — через 2 дня."}},"vi":{"stringUnit":{"state":"translated","value":"Tự động thiết lập bộ nhớ riêng tại Bắc Kinh. Xóa âm thanh sau khi chép lời; tệp còn lại hết hạn sau 2 ngày."}}}},
    "recording.cloud.prefix": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Storage path"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"存储路径"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"儲存路徑"}},"de":{"stringUnit":{"state":"translated","value":"Speicherpfad"}},"es":{"stringUnit":{"state":"translated","value":"Ruta de almacenamiento"}},"fr":{"stringUnit":{"state":"translated","value":"Chemin de stockage"}},"ja":{"stringUnit":{"state":"translated","value":"保存先パス"}},"ko":{"stringUnit":{"state":"translated","value":"저장 경로"}},"ru":{"stringUnit":{"state":"translated","value":"Путь хранения"}},"vi":{"stringUnit":{"state":"translated","value":"Đường dẫn lưu trữ"}}}},
    "recording.cloud.bucket": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Storage bucket"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"存储桶"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"儲存桶"}},"de":{"stringUnit":{"state":"translated","value":"Speicher-Bucket"}},"es":{"stringUnit":{"state":"translated","value":"Bucket de almacenamiento"}},"fr":{"stringUnit":{"state":"translated","value":"Bucket de stockage"}},"ja":{"stringUnit":{"state":"translated","value":"ストレージバケット"}},"ko":{"stringUnit":{"state":"translated","value":"스토리지 버킷"}},"ru":{"stringUnit":{"state":"translated","value":"Бакет хранилища"}},"vi":{"stringUnit":{"state":"translated","value":"Bucket lưu trữ"}}}},
