            "state": "translated",
            "value": "Conserva el contenido aunque el archivo original se mueva o elimine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve le contenu même si le fichier d’origine est déplacé ou supprimé."
          }
