<Window x:Class="ShotPaste.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ShotPaste.Windows.Controls"
        AutomationProperties.AutomationId="HistoryWindow" Title="ShotPaste · 剪贴板历史" Width="980" Height="680" MinWidth="860" MinHeight="520"
        WindowStartupLocation="Manual" WindowStyle="None" Closing="OnClosing" KeyDown="OnKeyDown" Deactivated="OnDeactivated">
  <Window.Resources>
    <Style x:Key="HistoryToolbarButton" TargetType="Button">
      <Setter Property="MinHeight" Value="{DynamicResource Control.MinHeight}"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="{DynamicResource Control.BorderThickness}"/>
      <Setter Property="FontFamily" Value="{DynamicResource Font.Family}"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Label.Medium}"/>
      <Setter Property="FontWeight" Value="{DynamicResource FontWeight.Medium}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Md}"
                    RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
              <Border.RenderTransform><ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
              <Grid>
                <Border x:Name="InteractionOverlay" Background="Transparent" CornerRadius="{DynamicResource Radius.Md}" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="InteractionOverlay" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="{StaticResource Animation.Fast}"/>
                  <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="{StaticResource Animation.Fast}"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Animation.Fast}"/>
                  <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Animation.Fast}"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="InteractionOverlay" Property="Background" Value="{DynamicResource PressedBackgroundBrush}"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="{StaticResource Animation.Press}"/>
                  <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="{StaticResource Animation.Press}"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HistorySegmentButton" TargetType="Button" BasedOn="{StaticResource HistoryToolbarButton}">
      <Setter Property="MinWidth" Value="58"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="FontWeight" Value="{DynamicResource FontWeight.Medium}"/>
    </Style>
    <Style x:Key="HistoryDangerButton" TargetType="Button" BasedOn="{StaticResource HistoryToolbarButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HistoryIconButton" TargetType="Button" BasedOn="{StaticResource HistoryToolbarButton}">
      <Setter Property="Width" Value="{DynamicResource Control.IconButtonSize}"/>
      <Setter Property="Height" Value="{DynamicResource Control.IconButtonSize}"/>
      <Setter Property="MinHeight" Value="{DynamicResource Control.IconButtonSize}"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="HistoryHeaderActionButton" TargetType="Button" BasedOn="{StaticResource HistoryDangerButton}">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="8,3"/>
    </Style>
    <Style x:Key="HistoryHeaderIconButton" TargetType="Button" BasedOn="{StaticResource HistoryIconButton}">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style x:Key="HistoryHeaderToggleButton" TargetType="ToggleButton">
      <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Toolbar}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HistoryCardAction" TargetType="Button" BasedOn="{StaticResource HistoryToolbarButton}">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="3,3"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Label.Small}"/>
    </Style>
    <Style x:Key="HistoryCardDangerAction" TargetType="Button" BasedOn="{StaticResource HistoryCardAction}">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding PreviewText}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="SelectionChrome" CornerRadius="{DynamicResource Radius.Card}" BorderBrush="Transparent" BorderThickness="2" Padding="2"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="SelectionChrome" Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15"/>
                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ReducedMotionHistoryListBoxItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding PreviewText}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="SelectionChrome" CornerRadius="{DynamicResource Radius.Card}" BorderBrush="Transparent" BorderThickness="2" Padding="2">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionChrome" Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <ContextMenu x:Key="HistoryItemContextMenu" x:Shared="False"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                 Opened="OnHistoryMenuOpened" Closed="OnHistoryMenuClosed">
      <MenuItem Header="恢复" AutomationProperties.Name="恢复历史项目" Tag="{Binding}" Click="OnRestoreItem"/>
      <MenuItem Header="复制" AutomationProperties.Name="复制历史项目" Tag="{Binding}" Click="OnCopyItem"/>
      <MenuItem Header="打开" AutomationProperties.AutomationId="HistoryOpenItem" AutomationProperties.Name="打开历史项目" Tag="{Binding}" Click="OnOpenItem"/>
      <MenuItem Header="在资源管理器中显示" AutomationProperties.AutomationId="HistoryRevealItem" AutomationProperties.Name="在资源管理器中显示历史项目" Tag="{Binding}" Click="OnRevealItem"/>
      <Separator/>
      <MenuItem Header="移入回收站…" AutomationProperties.AutomationId="HistoryDeleteItem" AutomationProperties.Name="删除历史项目" Tag="{Binding}" Click="OnDeleteItem"
                Foreground="{DynamicResource DangerBrush}"/>
    </ContextMenu>
    <DataTemplate x:Key="ExpandedHistoryCardTemplate">
      <Border x:Name="Card" Width="214" Height="190" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True"
              ContextMenu="{StaticResource HistoryItemContextMenu}"
              AutomationProperties.HelpText="右键或使用更多按钮可恢复、复制、打开、在资源管理器中显示或移入回收站">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="126"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Background="{DynamicResource SurfaceSecondaryBrush}">
            <Image Source="{Binding PreviewSource}" Stretch="UniformToFill"/>
            <TextBlock x:Name="FallbackPreview" Text="{Binding PreviewText}" TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" Margin="15" Foreground="{DynamicResource SecondaryTextBrush}"
                       MaxHeight="72" VerticalAlignment="Top" Visibility="Collapsed"/>
          </Grid>
          <Grid Grid.Row="1" Margin="13,9,13,7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1" Content="⋯" FontSize="18"
                    Style="{StaticResource HistoryHeaderIconButton}" Tag="{Binding}" Click="OnShowItemMenu"
                    ContextMenu="{StaticResource HistoryItemContextMenu}" AutomationProperties.AutomationId="HistoryMoreActions"
                    AutomationProperties.Name="更多历史操作"/>
          </Grid>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding PreviewSource}" Value="{x:Null}"><Setter TargetName="FallbackPreview" Property="Visibility" Value="Visible"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>
  <Grid Background="{DynamicResource WindowBackdropBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <controls:WindowTitleBar x:Name="TitleBar"/>
  <Grid x:Name="RootBackground" Grid.Row="1" Background="{DynamicResource WindowBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TopBar" Margin="20,18,20,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border x:Name="KindFilterGroup" HorizontalAlignment="Left" Padding="3" CornerRadius="{DynamicResource Radius.Lg}"
              Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ScreenshotFilter" Tag="Screenshot" Style="{StaticResource HistorySegmentButton}" Click="OnKindPill" AutomationProperties.AutomationId="ScreenshotHistoryFilter" AutomationProperties.Name="屏幕截图"><TextBlock Text="屏幕截图"/></Button>
          <Button Tag="ScrollingScreenshot" Style="{StaticResource HistorySegmentButton}" Click="OnKindPill" AutomationProperties.Name="滚动截屏"><TextBlock Text="滚动截屏"/></Button>
          <Button Tag="Recording" Style="{StaticResource HistorySegmentButton}" Click="OnKindPill" AutomationProperties.Name="屏幕录制"><TextBlock Text="屏幕录制"/></Button>
          <Button x:Name="ClipboardFilter" Tag="Clipboard" Style="{StaticResource HistorySegmentButton}" Click="OnKindPill" AutomationProperties.AutomationId="ClipboardHistoryFilter" AutomationProperties.Name="剪贴板历史"><TextBlock Text="剪贴板历史"/></Button>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Width="238" Height="34" HorizontalAlignment="Center" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="11,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ContentControl Content="{StaticResource Icon.Search}" ContentTemplate="{StaticResource Icon.Template}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Grid Grid.Column="1">
            <TextBlock x:Name="SearchPlaceholder" Text="搜索捕获内容" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBox x:Name="SearchBox" AutomationProperties.AutomationId="HistorySearch" AutomationProperties.Name="搜索捕获内容" ToolTip="按文件名或文本搜索" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0" Height="24" TextChanged="OnSearchTextChanged" VerticalContentAlignment="Center"/>
          </Grid>
          <Button x:Name="ClearSearchButton" Grid.Column="2" Content="{StaticResource Icon.Close}" ContentTemplate="{StaticResource Icon.Template}" Style="{StaticResource HistoryIconButton}" Width="24" Height="24" MinHeight="24" AutomationProperties.Name="清除搜索" Visibility="Collapsed" Click="OnClearSearch"/>
        </Grid>
      </Border>
      <Border x:Name="SelectionActions" Grid.Column="1" HorizontalAlignment="Right" Visibility="Collapsed" CornerRadius="{DynamicResource Radius.Card}"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,5" Margin="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="SelectionSummary" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,10,0"/>
          <Button Style="{StaticResource HistoryToolbarButton}" AutomationProperties.Name="复制所选" Margin="0,0,3,0" Click="OnCopySelection">
            <StackPanel Orientation="Horizontal">
              <ContentControl Content="{StaticResource Icon.Copy}" ContentTemplate="{StaticResource Icon.Template}"/>
              <TextBlock Text="复制" Margin="5,0,0,0"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource HistoryToolbarButton}" AutomationProperties.Name="清除选择" Margin="0,0,3,0" Click="OnClearSelection">
            <StackPanel Orientation="Horizontal">
              <ContentControl Content="{StaticResource Icon.Close}" ContentTemplate="{StaticResource Icon.Template}"/>
              <TextBlock Text="清除选择" Margin="5,0,0,0"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource HistoryDangerButton}" AutomationProperties.Name="删除所选" Click="OnDeleteSelection">
            <StackPanel Orientation="Horizontal">
              <ContentControl Content="{StaticResource Icon.Delete}" ContentTemplate="{StaticResource Icon.Template}"/>
              <TextBlock Text="删除" Margin="5,0,0,0"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
      <Border x:Name="HeaderUtilities" Grid.Column="2" Height="34" Padding="2"
              CornerRadius="{DynamicResource Radius.Lg}" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <ComboBox x:Name="TimeFilter" Width="104" SelectedIndex="0" SelectionChanged="OnFilterChanged" Padding="8,4" Margin="0,0,3,0">
            <ComboBoxItem Content="不限时间" Tag="All"/><ComboBoxItem Content="24 小时" Tag="1"/><ComboBoxItem Content="7 天" Tag="7"/><ComboBoxItem Content="30 天" Tag="30"/>
          </ComboBox>
          <ToggleButton x:Name="KeepOpenCheckBox" Content="{StaticResource Icon.Pin}" ContentTemplate="{StaticResource Icon.Template}"
                        IsChecked="{Binding HistoryKeepOpen}" Style="{StaticResource HistoryHeaderToggleButton}" Margin="3,0"
                        ToolTip="保持打开" Checked="OnKeepOpenChanged" Unchecked="OnKeepOpenChanged"
                        AutomationProperties.Name="保持历史窗口打开"/>
          <Button Style="{StaticResource HistoryHeaderIconButton}" AutomationProperties.Name="清空全部历史"
                  AutomationProperties.AutomationId="HistoryClearAll" Foreground="{DynamicResource DangerBrush}"
                  Content="{StaticResource Icon.Delete}" ContentTemplate="{StaticResource Icon.Template}"
                  ToolTip="清空全部历史（关联文件移入回收站）" Click="OnClearHistory"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="HistoryContent" Grid.Row="1" Margin="20,0,8,14">
      <ListBox x:Name="HistoryItems" AutomationProperties.AutomationId="ExpandedHistoryGrid" SelectionMode="Extended"
               Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource ExpandedHistoryCardTemplate}"
               ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnItemDoubleClick">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="228" ItemHeight="208"/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </ListBox>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
        <Border Width="64" Height="64" CornerRadius="{DynamicResource Radius.Pill}" Background="{DynamicResource SurfaceSecondaryBrush}">
          <ContentControl Content="{StaticResource Icon.Empty}" ContentTemplate="{StaticResource Icon.Template}" Width="28" Height="28"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </Border>
        <TextBlock Text="还没有符合条件的记录" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        <TextBlock Text="完成截图、录屏或复制内容后会显示在这里" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,5,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
  </Grid>
</Window>
