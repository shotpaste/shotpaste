    "preferences-capture.video-codec-description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 bietet mehr Kompatibilität; HEVC erzeugt kleinere Dateien, wenn unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 favors compatibility; HEVC makes smaller files when supported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 ofrece más compatibilidad; HEVC crea archivos menores si está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 favorise la compatibilité ; HEVC crée des fichiers plus petits si disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 は互換性を優先し、HEVC は対応環境でファイルを小さくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264는 호환성을 우선하고 HEVC는 지원 시 파일 크기를 줄입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 обеспечивает совместимость; HEVC создаёт меньшие файлы при поддержке."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 ưu tiên tương thích; HEVC tạo tệp nhỏ hơn khi được hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 优先兼容性；支持时 HEVC 文件更小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 優先相容性；支援時 HEVC 檔案更小。"
          }
        }
      }
    },
