<Window x:Class="ShotPaste.Windows.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotPaste" SizeToContent="WidthAndHeight" MinWidth="220" MaxWidth="560"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" Topmost="True" Background="{DynamicResource WindowBackdropBrush}"
        AutomationProperties.AutomationId="ShotPasteToast">
  <Border x:Name="ToastChrome" Margin="1" Padding="{DynamicResource Toast.Padding}"
          Background="{DynamicResource ToastBackgroundBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
          BorderThickness="1" CornerRadius="{DynamicResource Radius.Toolbar}" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><ScaleTransform x:Name="ToastScale" ScaleX="0.95" ScaleY="0.95"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="18" ShadowDepth="8" Opacity="0.35"/></Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="IconBackground" Width="32" Height="32" CornerRadius="{DynamicResource Radius.Pill}" Margin="0,0,10,0">
        <Path x:Name="IconPath" Width="18" Height="18" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource AccentForegroundBrush}"
              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource FontSize.Body}"
                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="MessageText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource FontSize.Label.Medium}"
                   Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="470"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
