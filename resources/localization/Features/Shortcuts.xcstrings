    "preferences-shortcuts.history-section-description": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturkurzbefehle für den Zwischenablageverlauf und den Wechsel des schwebenden Modus verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage keyboard shortcuts for the Clipboard History browser and floating mode toggle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Administra los atajos del historial del portapapeles y el cambio de modo flotante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
