<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <Style x:Key="SliderThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Width" Value="{DynamicResource Slider.ThumbSize}" />
    <Setter Property="Height" Value="{DynamicResource Slider.ThumbSize}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid>
            <Ellipse x:Name="FocusRing" Margin="-2" Fill="Transparent" Stroke="{DynamicResource FocusRingBrush}" StrokeThickness="2" Opacity="0" />
            <Ellipse x:Name="Knob" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="2" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.08" ScaleY="1.08" CenterX="7" CenterY="7" /></Setter.Value></Setter></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Opacity" Value="0.78" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderDecreaseButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type RepeatButton}"><Border Height="{DynamicResource Slider.TrackHeight}" Background="{DynamicResource AccentBrush}" CornerRadius="2" /></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SliderIncreaseButton" TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource SliderDecreaseButton}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type RepeatButton}"><Border Height="{DynamicResource Slider.TrackHeight}" Background="{DynamicResource ControlBorderBrush}" CornerRadius="2" /></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ShotPasteSlider" TargetType="{x:Type Slider}">
    <Setter Property="MinHeight" Value="24" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsMoveToPointEnabled" Value="True" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid Background="Transparent" VerticalAlignment="Center">
            <primitives:Track x:Name="PART_Track" Height="14" VerticalAlignment="Center"
                              IsDirectionReversed="False" Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}"
                              Value="{TemplateBinding Value}">
              <primitives:Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SliderDecreaseButton}" /></primitives:Track.DecreaseRepeatButton>
              <primitives:Track.Thumb><Thumb Style="{StaticResource SliderThumb}" /></primitives:Track.Thumb>
              <primitives:Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SliderIncreaseButton}" /></primitives:Track.IncreaseRepeatButton>
            </primitives:Track>
          </Grid>
          <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource ShotPasteSlider}" />
  <Style x:Key="HudSlider" TargetType="{x:Type Slider}" BasedOn="{StaticResource ShotPasteSlider}">
    <Setter Property="Foreground" Value="{DynamicResource HudTextBrush}" />
  </Style>
</ResourceDictionary>
