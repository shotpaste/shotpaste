<Window x:Class="LiteScreen.Windows.Views.ClipboardTextViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板文本" Width="760" Height="560" MinWidth="520" MinHeight="360"
        AutomationProperties.AutomationId="ClipboardTextViewer">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10">
      <TextBlock x:Name="LengthText" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="{DynamicResource SecondaryTextBrush}"
                 TextWrapping="Wrap" TextAlignment="Right" MaxWidth="460"/>
    </DockPanel>
    <TextBox x:Name="FullText" Grid.Row="1" AutomationProperties.AutomationId="ClipboardFullText"
             IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="12"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="CopyButton" Content="复制全文" Click="OnCopy" IsEnabled="False"
              AutomationProperties.AutomationId="ClipboardTextCopy" Margin="0,0,8,0"/>
      <Button x:Name="CloseButton" Content="关闭" Click="OnClose" AutomationProperties.AutomationId="ClipboardTextClose"/>
    </StackPanel>
  </Grid>
</Window>
