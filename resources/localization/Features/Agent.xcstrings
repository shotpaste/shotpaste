    "agent.translation-prompt-variables": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Unterstützte Platzhalter: {{source_language}}, {{target_language}}"}},"en":{"stringUnit":{"state":"translated","value":"Supported placeholders: {{source_language}}, {{target_language}}"}},"es":{"stringUnit":{"state":"translated","value":"Marcadores compatibles: {{source_language}}, {{target_language}}"}},"fr":{"stringUnit":{"state":"translated","value":"Variables prises en charge : {{source_language}}, {{target_language}}"}},"ja":{"stringUnit":{"state":"translated","value":"使用できるプレースホルダー: {{source_language}}, {{target_language}}"}},"ko":{"stringUnit":{"state":"translated","value":"지원되는 자리표시자: {{source_language}}, {{target_language}}"}},"ru":{"stringUnit":{"state":"translated","value":"Поддерживаемые подстановки: {{source_language}}, {{target_language}}"}},"vi":{"stringUnit":{"state":"translated","value":"Biến giữ chỗ được hỗ trợ: {{source_language}}, {{target_language}}"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"支持占位符：{{source_language}}、{{target_language}}"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"支援的預留位置：{{source_language}}、{{target_language}}"}}}},
    "agent.translation-restore-builtin": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Integrierten Prompt wiederherstellen"}},"en":{"stringUnit":{"state":"translated","value":"Restore built-in prompt"}},"es":{"stringUnit":{"state":"translated","value":"Restaurar prompt integrado"}},"fr":{"stringUnit":{"state":"translated","value":"Restaurer le prompt intégré"}},"ja":{"stringUnit":{"state":"translated","value":"内蔵プロンプトを復元"}},"ko":{"stringUnit":{"state":"translated","value":"내장 프롬프트 복원"}},"ru":{"stringUnit":{"state":"translated","value":"Восстановить встроенный промпт"}},"vi":{"stringUnit":{"state":"translated","value":"Khôi phục lời nhắc tích hợp"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复内置提示词"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"還原內建提示詞"}}}},
    "agent.translation-timeout-title": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Übersetzungszeitlimit"}},"en":{"stringUnit":{"state":"translated","value":"Translation timeout"}},"es":{"stringUnit":{"state":"translated","value":"Tiempo de espera de traducción"}},"fr":{"stringUnit":{"state":"translated","value":"Délai de traduction"}},"ja":{"stringUnit":{"state":"translated","value":"翻訳タイムアウト"}},"ko":{"stringUnit":{"state":"translated","value":"번역 시간 제한"}},"ru":{"stringUnit":{"state":"translated","value":"Тайм-аут перевода"}},"vi":{"stringUnit":{"state":"translated","value":"Thời gian chờ dịch"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译超时"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"翻譯逾時"}}}},
    "agent.translation-timeout-description": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld Sekunden für eingefrorenen Zuschnitt, lokale OCR, Absatz- und Sprachanalyse, Netzwerk, Wiederholung, Antwortanalyse und Layout"}},"en":{"stringUnit":{"state":"translated","value":"%lld seconds covering frozen crop, local OCR, paragraph and language analysis, network, retry, response parsing, and layout"}},"es":{"stringUnit":{"state":"translated","value":"%lld segundos para recorte congelado, OCR local, análisis de párrafos e idioma, red, reintento, análisis de respuesta y diseño"}},"fr":{"stringUnit":{"state":"translated","value":"%lld secondes pour le recadrage figé, l’OCR local, l’analyse des paragraphes et de la langue, le réseau, la nouvelle tentative, l’analyse de la réponse et la mise en page"}},"ja":{"stringUnit":{"state":"translated","value":"固定画像の切り出し、ローカル OCR、段落と言語の解析、ネットワーク、再試行、応答解析、レイアウトを含む %lld 秒"}},"ko":{"stringUnit":{"state":"translated","value":"고정 영역 자르기, 로컬 OCR, 문단 및 언어 분석, 네트워크, 재시도, 응답 분석과 레이아웃에 %lld초"}},"ru":{"stringUnit":{"state":"translated","value":"%lld с на обрезку замороженного кадра, локальное OCR, анализ абзацев и языка, сеть, повтор, разбор ответа и компоновку"}},"vi":{"stringUnit":{"state":"translated","value":"%lld giây cho việc cắt ảnh đóng băng, OCR cục bộ, phân tích đoạn văn và ngôn ngữ, mạng, thử lại, phân tích phản hồi và dàn trang"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%lld 秒，覆盖冻结画面裁剪、本地 OCR、段落与语言分析、网络、重试、响应解析和排版"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%lld 秒，涵蓋凍結畫面裁切、本機 OCR、段落與語言分析、網路、重試、回應解析與排版"}}}},
    "agent.translation-provider-mode-title": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Konfigurierter Provider (Textmodus)"}},"en":{"stringUnit":{"state":"translated","value":"Configured Provider (text mode)"}},"es":{"stringUnit":{"state":"translated","value":"Proveedor configurado (modo texto)"}},"fr":{"stringUnit":{"state":"translated","value":"Provider configuré (mode texte)"}},"ja":{"stringUnit":{"state":"translated","value":"設定済み Provider（テキストモード）"}},"ko":{"stringUnit":{"state":"translated","value":"구성된 Provider(텍스트 모드)"}},"ru":{"stringUnit":{"state":"translated","value":"Настроенный Provider (текстовый режим)"}},"vi":{"stringUnit":{"state":"translated","value":"Provider đã cấu hình (chế độ văn bản)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已配置 Provider（文本模式）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已設定 Provider（文字模式）"}}}},
    "agent.translation-provider-mode-description": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verwendet Protokoll, Endpunkt, Modell und Anmeldedaten des Agent. Bildschirmbilder werden niemals hochgeladen."}},"en":{"stringUnit":{"state":"translated","value":"Reuses the Agent protocol, endpoint, model, and credentials. Screen images are never uploaded."}},"es":{"stringUnit":{"state":"translated","value":"Reutiliza el protocolo, el endpoint, el modelo y las credenciales del Agent. Las imágenes de pantalla nunca se suben."}},"fr":{"stringUnit":{"state":"translated","value":"Réutilise le protocole, le point de terminaison, le modèle et les identifiants de l’Agent. Les images d’écran ne sont jamais téléversées."}},"ja":{"stringUnit":{"state":"translated","value":"Agent のプロトコル、エンドポイント、モデル、資格情報を再利用します。画面画像はアップロードされません。"}},"ko":{"stringUnit":{"state":"translated","value":"Agent의 프로토콜, 엔드포인트, 모델 및 자격 증명을 재사용합니다. 화면 이미지는 업로드되지 않습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Повторно используются протокол, конечная точка, модель и учётные данные Agent. Изображения экрана не загружаются."}},"vi":{"stringUnit":{"state":"translated","value":"Tái sử dụng giao thức, điểm cuối, mô hình và thông tin xác thực của Agent. Ảnh màn hình không bao giờ được tải lên."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续复用 Agent 的协议、端点、模型和凭据。屏幕图片不会上传。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"繼續重用 Agent 的通訊協定、端點、模型與認證。螢幕影像不會上傳。"}}}},
    "agent.translation-send-recognized-text-title": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erkannten Text an Provider senden erlauben"}},"en":{"stringUnit":{"state":"translated","value":"Allow sending recognized text to Provider"}},"es":{"stringUnit":{"state":"translated","value":"Permitir enviar texto reconocido al proveedor"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’envoi du texte reconnu au Provider"}},"ja":{"stringUnit":{"state":"translated","value":"認識したテキストの Provider への送信を許可"}},"ko":{"stringUnit":{"state":"translated","value":"인식된 텍스트를 Provider로 보내기 허용"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить отправку распознанного текста Provider"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép gửi văn bản đã nhận dạng đến Provider"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"允许发送识别出的文字到 Provider"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"允許將辨識出的文字傳送至 Provider"}}}},
    "agent.translation-send-recognized-text-description": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bildschirmbilder werden niemals hochgeladen. ShotPaste erkennt Text lokal und sendet nur den erkannten Text an die konfigurierte API."}},"en":{"stringUnit":{"state":"translated","value":"Screen images are never uploaded. ShotPaste recognizes text locally and sends only recognized text to the configured API."}},"es":{"stringUnit":{"state":"translated","value":"Las imágenes de pantalla nunca se suben. ShotPaste reconoce el texto localmente y solo envía el texto reconocido a la API configurada."}},"fr":{"stringUnit":{"state":"translated","value":"Les images d’écran ne sont jamais téléversées. ShotPaste reconnaît le texte localement et n’envoie que le texte reconnu à l’API configurée."}},"ja":{"stringUnit":{"state":"translated","value":"画面画像はアップロードされません。ShotPaste はローカルでテキストを認識し、認識したテキストだけを設定済み API に送信します。"}},"ko":{"stringUnit":{"state":"translated","value":"화면 이미지는 업로드되지 않습니다. ShotPaste는 로컬에서 텍스트를 인식하고 인식된 텍스트만 구성된 API로 보냅니다."}},"ru":{"stringUnit":{"state":"translated","value":"Изображения экрана не загружаются. ShotPaste распознаёт текст локально и отправляет в настроенный API только распознанный текст."}},"vi":{"stringUnit":{"state":"translated","value":"Ảnh màn hình không bao giờ được tải lên. ShotPaste nhận dạng văn bản cục bộ và chỉ gửi văn bản đã nhận dạng đến API đã cấu hình."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"屏幕图片不会上传。ShotPaste 会在本地识别文字，并仅将识别出的文字发送到已配置的 API。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"螢幕影像不會上傳。ShotPaste 會在本機辨識文字，並僅將辨識出的文字傳送至已設定的 API。"}}}},
    "agent.translation-send-recognized-text-disabled": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Weitergabe erkannten Textes ist deaktiviert; aktiviere sie vor dem Übersetzen."}},"en":{"stringUnit":{"state":"translated","value":"Recognized-text sharing is disabled; enable it before translating."}},"es":{"stringUnit":{"state":"translated","value":"El envío de texto reconocido está desactivado; actívalo antes de traducir."}},"fr":{"stringUnit":{"state":"translated","value":"Le partage du texte reconnu est désactivé ; activez-le avant de traduire."}},"ja":{"stringUnit":{"state":"translated","value":"認識したテキストの共有が無効です。翻訳する前に有効にしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"인식된 텍스트 공유가 비활성화되어 있습니다. 번역하기 전에 활성화하세요."}},"ru":{"stringUnit":{"state":"translated","value":"Отправка распознанного текста отключена; включите её перед переводом."}},"vi":{"stringUnit":{"state":"translated","value":"Chia sẻ văn bản đã nhận dạng đang tắt; hãy bật trước khi dịch."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"识别文字发送已关闭；请在翻译前开启。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"辨識文字傳送已關閉；請在翻譯前開啟。"}}}},
    "agent.translation-provider-ready": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Provider ist bereit"}},"en":{"stringUnit":{"state":"translated","value":"Provider is ready"}},"es":{"stringUnit":{"state":"translated","value":"El proveedor está listo"}},"fr":{"stringUnit":{"state":"translated","value":"Le Provider est prêt"}},"ja":{"stringUnit":{"state":"translated","value":"Provider の準備完了"}},"ko":{"stringUnit":{"state":"translated","value":"Provider 준비 완료"}},"ru":{"stringUnit":{"state":"translated","value":"Provider готов"}},"vi":{"stringUnit":{"state":"translated","value":"Provider sẵn sàng"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Provider 配置已就绪"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Provider 已準備就緒"}}}},
    "agent.translation-provider-unavailable": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Provider-Konfiguration erfordert Aufmerksamkeit"}},"en":{"stringUnit":{"state":"translated","value":"Provider configuration needs attention"}},"es":{"stringUnit":{"state":"translated","value":"La configuración del proveedor requiere atención"}},"fr":{"stringUnit":{"state":"translated","value":"La configuration du Provider nécessite votre attention"}},"ja":{"stringUnit":{"state":"translated","value":"Provider 設定を確認してください"}},"ko":{"stringUnit":{"state":"translated","value":"Provider 구성을 확인하세요"}},"ru":{"stringUnit":{"state":"translated","value":"Требуется проверить конфигурацию Provider"}},"vi":{"stringUnit":{"state":"translated","value":"Cần kiểm tra cấu hình Provider"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Provider 配置需要处理"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Provider 設定需要處理"}}}},
    "agent.translation-ocr-coverage-description": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Quellsprachenabdeckung ist durch die von macOS Vision OCR auf diesem Mac unterstützten Sprachen begrenzt."}},"en":{"stringUnit":{"state":"translated","value":"Source-language coverage is limited by the languages supported by macOS Vision OCR on this Mac."}},"es":{"stringUnit":{"state":"translated","value":"La cobertura de idiomas de origen está limitada por los idiomas compatibles con Vision OCR de macOS en este Mac."}},"fr":{"stringUnit":{"state":"translated","value":"La couverture des langues source est limitée par les langues prises en charge par Vision OCR de macOS sur ce Mac."}},"ja":{"stringUnit":{"state":"translated","value":"原言語の対応範囲は、この Mac の macOS Vision OCR がサポートする言語に限られます。"}},"ko":{"stringUnit":{"state":"translated","value":"원본 언어 지원 범위는 이 Mac의 macOS Vision OCR이 지원하는 언어로 제한됩니다."}},"ru":{"stringUnit":{"state":"translated","value":"Набор исходных языков ограничен языками, которые поддерживает macOS Vision OCR на этом Mac."}},"vi":{"stringUnit":{"state":"translated","value":"Phạm vi ngôn ngữ nguồn bị giới hạn bởi các ngôn ngữ mà Vision OCR của macOS hỗ trợ trên máy Mac này."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"源语言覆盖范围受本机 macOS Vision OCR 支持的语言限制。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"來源語言涵蓋範圍受本機 macOS Vision OCR 支援的語言限制。"}}}}
  },
  "version": "1.0"
}
